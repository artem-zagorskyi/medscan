generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "mysql"
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum Role {
  DOCTOR
  PATIENT
  ADMIN
}

enum Rights {
  USER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum BloodGroup {
  A
  B
  AB
  O
}

enum RhFactor {
  POSITIVE
  NEGATIVE
}

enum RecordType {
  EXAM
  CONSILIUM
  EPICRISIS
}

enum RecordStatus {
  DRAFT
  SIGNED
}

enum GeneralCondition {
  SATISFACTORY
  MODERATE
  SEVERE
}

enum CaseStatus {
  OPEN
  CLOSED
}

enum ResearchStatus {
  PENDING
  PROCESSING
  PROCESSED
  ERROR
}

enum FileStatus {
  PENDING
  PROCESSED
  ERROR
}

enum DiseaseStatus {
  ACTIVE
  RECOVERED
  CHRONIC
}

enum AllergyReactionSeverity {
  MILD
  MODERATE
  SEVERE
}

enum AllergenCategory {
  FOOD
  DRUG
  ENVIRONMENTAL
  INSECT
  OTHER
}

// ─────────────────────────────────────────
// PERSON
// ─────────────────────────────────────────

model Person {
  id           Int      @id @default(autoincrement())
  last_name    String   @db.VarChar(100)
  first_name   String   @db.VarChar(100)
  middle_name  String?  @db.VarChar(100)
  birth_date   DateTime @db.Date
  gender       Gender
  contact_info String?  @db.VarChar(255)
  role         Role

  account Account?
  doctor  Doctor?
  patient Patient?
}

// ─────────────────────────────────────────
// ACCOUNT
// ─────────────────────────────────────────

model Account {
  id         Int      @id @default(autoincrement())
  person_id  Int      @unique
  email      String   @unique @db.VarChar(255)
  password   String   @db.VarChar(255)
  is_active  Boolean  @default(true)
  rights     Rights   @default(USER)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  person Person @relation(fields: [person_id], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────
// DOCTOR
// ─────────────────────────────────────────

model Doctor {
  id             Int    @id @default(autoincrement())
  person_id      Int    @unique
  specialization String @db.VarChar(255)

  person          Person          @relation(fields: [person_id], references: [id], onDelete: Cascade)
  doctor_patients DoctorPatient[]
  records         Record[]        @relation("RecordAuthor")
  record_doctors  RecordDoctor[]
  researches      Research[]
}

// ─────────────────────────────────────────
// PATIENT
// ─────────────────────────────────────────

model Patient {
  id                Int     @id @default(autoincrement())
  person_id         Int     @unique
  medical_record_id Int     @unique
  address           String? @db.VarChar(500)

  person         Person        @relation(fields: [person_id], references: [id], onDelete: Cascade)
  medical_record MedicalRecord @relation(fields: [medical_record_id], references: [id])

  doctor_patients DoctorPatient[]
}

// ─────────────────────────────────────────
// DOCTOR_PATIENT
// ─────────────────────────────────────────

model DoctorPatient {
  patient_id Int
  doctor_id  Int

  patient Patient @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  doctor  Doctor  @relation(fields: [doctor_id], references: [id], onDelete: Cascade)

  @@id([patient_id, doctor_id])
}

// ─────────────────────────────────────────
// MEDICAL RECORD
// ─────────────────────────────────────────

model MedicalRecord {
  id          Int         @id @default(autoincrement())
  blood_group BloodGroup?
  rh_factor   RhFactor?
  height      Decimal?    @db.Decimal(5, 2)
  weight      Decimal?    @db.Decimal(5, 2)
  created_at  DateTime    @default(now())

  patient           Patient?
  cases             Case[]
  records           Record[]
  patient_diseases  PatientDisease[]
  patient_allergies PatientAllergy[]
  researches        Research[]
  research_files    ResearchFile[]
}

// ─────────────────────────────────────────
// CASE
// ─────────────────────────────────────────

model Case {
  id                Int       @id @default(autoincrement())
  medical_record_id Int
  status            CaseStatus @default(OPEN)
  opening_date      DateTime   @db.Date
  closing_date      DateTime?  @db.Date
  main_condition    String?    @db.Text
  description       String?    @db.Text

  medical_record MedicalRecord @relation(fields: [medical_record_id], references: [id], onDelete: Cascade)
  records        Record[]
  researches     Research[]
}

// ─────────────────────────────────────────
// RECORD
// ─────────────────────────────────────────

model Record {
  id                Int          @id @default(autoincrement())
  medical_record_id Int
  case_id           Int
  author_id         Int
  parent_record_id  Int?
  visit_date        DateTime     @db.Date
  type              RecordType
  status            RecordStatus @default(DRAFT)

  // Анамнез
  complaints          String? @db.Text
  history_of_illness  String? @db.Text
  history_of_life     String? @db.Text
  social_habits       String? @db.Text

  // Витальные показатели
  height           Decimal? @db.Decimal(5, 2)
  weight           Decimal? @db.Decimal(5, 2)
  temperature      Decimal? @db.Decimal(3, 1)
  blood_pressure   String?  @db.VarChar(10)
  heart_rate       Int?
  spo2             Int?

  // Объективный статус
  general_condition  String? @db.Text
  skin_status        String? @db.Text
  respiratory_system String? @db.Text
  cardiovascular     String? @db.Text

  // Заключение
  doctor_conclusion String? @db.Text
  treatment_plan    String? @db.Text

  created_at DateTime @default(now())

  medical_record  MedicalRecord    @relation(fields: [medical_record_id], references: [id], onDelete: Cascade)
  case            Case             @relation(fields: [case_id], references: [id])
  author          Doctor           @relation("RecordAuthor", fields: [author_id], references: [id])
  parent_record   Record?          @relation("RecordHistory", fields: [parent_record_id], references: [id])
  child_records   Record[]         @relation("RecordHistory")

  record_doctors     RecordDoctor[]
  record_diagnoses   RecordDiagnosis[]
  record_medications RecordMedication[]
  record_researches  RecordResearch[]
  record_allergies   RecordAllergy[]
}

// ─────────────────────────────────────────
// RECORD DOCTOR (консилиум)
// ─────────────────────────────────────────

model RecordDoctor {
  id        Int    @id @default(autoincrement())
  record_id Int
  doctor_id Int
  role      String @db.VarChar(100)

  record Record @relation(fields: [record_id], references: [id], onDelete: Cascade)
  doctor Doctor @relation(fields: [doctor_id], references: [id])
}

// ─────────────────────────────────────────
// RECORD DIAGNOSIS
// ─────────────────────────────────────────

model RecordDiagnosis {
  id          Int     @id @default(autoincrement())
  record_id   Int
  disease_id  Int
  description String? @db.Text
  is_final    Boolean @default(false)
  is_main     Boolean @default(true)

  record  Record  @relation(fields: [record_id], references: [id], onDelete: Cascade)
  disease Disease @relation(fields: [disease_id], references: [id])
}

// ─────────────────────────────────────────
// RECORD MEDICATION
// ─────────────────────────────────────────

model RecordMedication {
  id            Int     @id @default(autoincrement())
  record_id     Int
  medication_id Int
  dosage        String? @db.VarChar(100)
  frequency     String? @db.VarChar(100)
  duration      String? @db.VarChar(100)
  comment       String? @db.Text

  record     Record     @relation(fields: [record_id], references: [id], onDelete: Cascade)
  medication Medication @relation(fields: [medication_id], references: [id])
}

// ─────────────────────────────────────────
// RECORD RESEARCH
// ─────────────────────────────────────────

model RecordResearch {
  id          Int @id @default(autoincrement())
  record_id   Int
  research_id Int

  record   Record   @relation(fields: [record_id], references: [id], onDelete: Cascade)
  research Research @relation(fields: [research_id], references: [id])
}

// ─────────────────────────────────────────
// RECORD ALLERGY
// ─────────────────────────────────────────

model RecordAllergy {
  id                   Int                     @id @default(autoincrement())
  record_id            Int
  allergen_id          Int
  reaction_severity    AllergyReactionSeverity
  reaction_description String?                 @db.Text

  record   Record   @relation(fields: [record_id], references: [id], onDelete: Cascade)
  allergen Allergen @relation(fields: [allergen_id], references: [id])
}

// ─────────────────────────────────────────
// RESEARCH
// ─────────────────────────────────────────

model Research {
  id                Int            @id @default(autoincrement())
  medical_record_id Int
  case_id           Int?
  doctor_id         Int?
  research_type     String         @db.VarChar(255)
  status            ResearchStatus @default(PENDING)
  extracted_text    String?        @db.LongText
  results           String?        @db.Text
  created_at        DateTime       @default(now())
  processed_at      DateTime?

  medical_record    MedicalRecord    @relation(fields: [medical_record_id], references: [id], onDelete: Cascade)
  case              Case?            @relation(fields: [case_id], references: [id])
  doctor            Doctor?          @relation(fields: [doctor_id], references: [id])
  research_files    ResearchFile[]
  record_researches RecordResearch[]
}

// ─────────────────────────────────────────
// RESEARCH FILE
// ─────────────────────────────────────────

model ResearchFile {
  id                Int        @id @default(autoincrement())
  medical_record_id Int
  research_id       Int?
  file_path         String     @db.VarChar(500)
  status            FileStatus @default(PENDING)
  created_at        DateTime   @default(now())
  processed_at      DateTime?

  medical_record MedicalRecord @relation(fields: [medical_record_id], references: [id], onDelete: Cascade)
  research       Research?     @relation(fields: [research_id], references: [id])
}

// ─────────────────────────────────────────
// MEDICATION (справочник)
// ─────────────────────────────────────────

model Medication {
  id               Int     @id @default(autoincrement())
  name             String  @db.VarChar(255)
  form             String? @db.VarChar(100)
  active_substance String? @db.VarChar(255)
  dosage_unit      String? @db.VarChar(50)

  record_medications RecordMedication[]
}

// ─────────────────────────────────────────
// DISEASE
// ─────────────────────────────────────────

model Disease {
  id       Int    @id @default(autoincrement())
  name     String @db.VarChar(255)
  icd_code String @db.VarChar(20)

  patient_diseases  PatientDisease[]
  record_diagnoses  RecordDiagnosis[]
}

// ─────────────────────────────────────────
// PATIENT DISEASE
// ─────────────────────────────────────────

model PatientDisease {
  medical_record_id Int
  disease_id        Int
  status            DiseaseStatus
  diagnosed_at      DateTime      @db.Date

  medical_record MedicalRecord @relation(fields: [medical_record_id], references: [id], onDelete: Cascade)
  disease        Disease       @relation(fields: [disease_id], references: [id])

  @@id([medical_record_id, disease_id])
}

// ─────────────────────────────────────────
// ALLERGEN
// ─────────────────────────────────────────

model Allergen {
  id       Int              @id @default(autoincrement())
  name     String           @db.VarChar(255) @unique
  category AllergenCategory

  patient_allergies PatientAllergy[]
  record_allergies  RecordAllergy[]
}

// ─────────────────────────────────────────
// PATIENT ALLERGY
// ─────────────────────────────────────────

model PatientAllergy {
  medical_record_id    Int
  allergen_id          Int
  reaction_severity    AllergyReactionSeverity
  reaction_description String?                 @db.VarChar(500)
  diagnosed_at         DateTime                @db.Date

  medical_record MedicalRecord @relation(fields: [medical_record_id], references: [id], onDelete: Cascade)
  allergen       Allergen      @relation(fields: [allergen_id], references: [id])

  @@id([medical_record_id, allergen_id])
}