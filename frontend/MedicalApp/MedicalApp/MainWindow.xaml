<Window x:Class="MedicalApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="MedScan" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        MinHeight="500" MinWidth="800">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Топбар (тільки для лікарів) -->
        <Border x:Name="Topbar"
                Grid.Row="0"
                Background="#185FA5"
                Height="56"
                Visibility="Collapsed">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="MedScan"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="SemiBold"/>
                    <Border Width="1" Background="#378ADD" Margin="16,10"/>
                    <TextBlock Text="Система медичних записів"
                               Foreground="#B5D4F4"
                               FontSize="12"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Button x:Name="UserMenuButton"
                        Grid.Column="1"
                        Click="UserMenuButton_Click"
                        Height="40" Padding="8,0"
                        Cursor="Hand" VerticalAlignment="Center">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="BorderBrush" Value="#378ADD"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Margin="{TemplateBinding Padding}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#1A6FB8"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                        <Border Width="30" Height="30" CornerRadius="15"
                                Background="#1A6FB8" Margin="0,0,10,0">
                            <ui:SymbolIcon Symbol="Person24" FontSize="15" Foreground="White"/>
                        </Border>
                        <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
                            <TextBlock x:Name="UserName" Text="Лікар"
                                       Foreground="White" FontSize="13" FontWeight="Medium"/>
                            <TextBlock x:Name="UserSpecialization" Text="Терапевт"
                                       Foreground="#B5D4F4" FontSize="11"/>
                        </StackPanel>
                        <ui:SymbolIcon Symbol="ChevronDown24" FontSize="12"
                                       Foreground="#B5D4F4" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Popup x:Name="UserMenuPopup"
                       Grid.Column="1"
                       PlacementTarget="{Binding ElementName=UserMenuButton}"
                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                    <Border Background="White" BorderBrush="#D3D1C7" BorderThickness="1"
                            CornerRadius="8" Margin="0,6,0,0" MinWidth="220" Padding="4">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="16"
                                              ShadowDepth="2" Opacity="0.08"/>
                        </Border.Effect>
                        <StackPanel>
                            <Border Padding="12,10" BorderBrush="#E0DEDB"
                                    BorderThickness="0,0,0,1" Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="36" Height="36" CornerRadius="18"
                                            Background="#E6F1FB" Margin="0,0,10,0">
                                        <ui:SymbolIcon Symbol="Person24" FontSize="18" Foreground="#185FA5"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="DropdownUserName" Text="Лікар"
                                                   FontSize="13" FontWeight="SemiBold" Foreground="#2C2C2A"/>
                                        <TextBlock x:Name="DropdownSpecialization" Text="Терапевт"
                                                   FontSize="12" Foreground="#888780"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Button Click="Logout_Click" Style="{StaticResource DropdownItemStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="SignOut24" FontSize="15"
                                                   Margin="0,0,10,0" Foreground="#E24B4A"/>
                                    <TextBlock Text="Вийти" FontSize="13" Foreground="#E24B4A"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Border>

        <!-- Основна область -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="0"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Сайдбар (тільки для адміна) -->
            <!-- Сайдбар (тільки для адміна) -->
            <Border x:Name="Sidebar"
        Grid.Column="0"
        Background="#185FA5"
        BorderBrush="#1A6FB8"
        BorderThickness="0,0,1,0"
        Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Логотип -->
                    <Border Grid.Row="0" Padding="20,18,20,16"
                BorderBrush="#1A6FB8" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Text="MedScan"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="Bold"/>
                            <TextBlock Text="Адмін-панель"
                           Foreground="#B5D4F4"
                           FontSize="11"
                           Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Навігація -->
                    <StackPanel Grid.Row="1" Margin="12,16,12,0">

                        <TextBlock Text="УПРАВЛІННЯ"
                       Foreground="#B5D4F4"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Margin="8,0,0,8"/>

                        <!-- Лікарі -->
                        <Button x:Name="NavDoctors"
                    Click="NavDoctors_Click"
                    Cursor="Hand"
                    Margin="0,0,0,2">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                    <Setter Property="Padding" Value="8,9"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                            CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#1A6FB8"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Stethoscope24"
                                   FontSize="16"
                                   Foreground="#B5D4F4"
                                   Margin="0,0,10,0"
                                   VerticalAlignment="Center"/>
                                <TextBlock Text="Лікарі"
                               Foreground="White"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Пацієнти -->
                        <Button x:Name="NavPatients"
                    Click="NavPatients_Click"
                    Cursor="Hand"
                    Margin="0,0,0,2">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                    <Setter Property="Padding" Value="8,9"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                            CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#1A6FB8"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="People24"
                                   FontSize="16"
                                   Foreground="#B5D4F4"
                                   Margin="0,0,10,0"
                                   VerticalAlignment="Center"/>
                                <TextBlock Text="Пацієнти"
                               Foreground="White"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Завантаження -->
                        <Button x:Name="NavUploads"
                    Click="NavUploads_Click"
                    Cursor="Hand"
                    Margin="0,0,0,2">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                    <Setter Property="Padding" Value="8,9"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                            CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#1A6FB8"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowUpload24"
                                   FontSize="16"
                                   Foreground="#B5D4F4"
                                   Margin="0,0,10,0"
                                   VerticalAlignment="Center"/>
                                <TextBlock Text="Завантаження"
                               Foreground="White"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>

                    <!-- Низ — інфо адміна + кнопка виходу -->
                    <Border Grid.Row="2"
                BorderBrush="#1A6FB8" BorderThickness="0,1,0,0"
                Padding="14,12">
                        <StackPanel>
                            <!-- Інфо адміна -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Border Width="30" Height="30" CornerRadius="15"
                            Background="#1A6FB8" Margin="0,0,10,0">
                                    <ui:SymbolIcon Symbol="Person24"
                                       FontSize="14"
                                       Foreground="White"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="AdminName"
                                   Text="Адміністратор"
                                   Foreground="White"
                                   FontSize="12"
                                   FontWeight="Medium"/>
                                    <TextBlock Text="Адміністратор"
                                   Foreground="#B5D4F4"
                                   FontSize="11"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Кнопка виходу -->
                            <Button Click="Logout_Click"
                        Cursor="Hand"
                        HorizontalAlignment="Stretch">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#C0392B"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="10,8"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#A93226"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="SignOut24"
                                                FontSize="15"
                                                Foreground="White"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"/>
                                    <TextBlock Text="Вийти з системи"
                                            FontSize="12"
                                            FontWeight="Medium"
                                            Foreground="White"
                                            VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                </Grid>
            </Border>

            <!-- Контент -->
            <Border x:Name="ContentArea"
                    Grid.Column="1"
                    Background="#F5F5F5">
                <ContentControl x:Name="MainContent"/>
            </Border>
        </Grid>
    </Grid>
</Window>