<Window x:Class="MedicalApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MedScan" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        MinHeight="500" MinWidth="800">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Топбар -->
        <Border x:Name="Topbar"
                Grid.Row="0"
                Background="#185FA5"
                Height="56"
                Visibility="Collapsed">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Логотип -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="MedScan"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="Medium"/>
                    <Border Width="1"
                            Background="#378ADD"
                            Margin="16,8"/>
                    <TextBlock Text="Система медичних записів"
                               Foreground="#B5D4F4"
                               FontSize="12"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Кнопка пользователя -->
                <Button x:Name="UserMenuButton"
                        Grid.Column="1"
                        Click="UserMenuButton_Click"
                        Height="40"
                        Padding="18,0"
                        Cursor="Hand"
                        VerticalAlignment="Center">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="BorderBrush" Value="#378ADD"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Margin="{TemplateBinding Padding}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#1A6FB8"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock x:Name="UserName"
                                       Text="Лікар"
                                       Foreground="White"
                                       FontSize="13"
                                       FontWeight="Medium"/>
                            <TextBlock x:Name="UserSpecialization"
                                       Text="Терапевт"
                                       Foreground="#B5D4F4"
                                       FontSize="11"/>
                        </StackPanel>
                        <TextBlock Text="▼"
                                   Foreground="#B5D4F4"
                                   FontSize="10"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Dropdown меню -->
                <Popup x:Name="UserMenuPopup"
                       Grid.Column="1"
                       PlacementTarget="{Binding ElementName=UserMenuButton}"
                       Placement="Bottom"
                       StaysOpen="False"
                       AllowsTransparency="True">
                    <Border Background="White"
                            BorderBrush="#D3D1C7"
                            BorderThickness="1"
                            CornerRadius="8"
                            Margin="0,6,0,0"
                            MinWidth="200"
                            Padding="4">
                        <Border.Effect>
                            <DropShadowEffect Color="#888780"
                                              BlurRadius="12"
                                              ShadowDepth="2"
                                              Opacity="0.15"/>
                        </Border.Effect>
                        <StackPanel>
                            <!-- Инфо о враче -->
                            <Border Padding="12,10"
                                    BorderBrush="#D3D1C7"
                                    BorderThickness="0,0,0,1"
                                    Margin="0,0,0,4">
                                <StackPanel>
                                    <TextBlock x:Name="DropdownUserName"
                                               Text="Лікар"
                                               FontSize="13"
                                               FontWeight="Medium"
                                               Foreground="#2C2C2A"/>
                                    <TextBlock x:Name="DropdownSpecialization"
                                               Text="Терапевт"
                                               FontSize="12"
                                               Foreground="#888780"/>
                                </StackPanel>
                            </Border>

                            <Button Content="⚙  Налаштування"
                                    Style="{StaticResource DropdownItemStyle}"
                                    Click="Settings_Click"/>

                            <Button Content="❓  Допомога"
                                    Style="{StaticResource DropdownItemStyle}"
                                    Click="Help_Click"/>

                            <Border BorderBrush="#D3D1C7"
                                    BorderThickness="0,1,0,0"
                                    Margin="8,4"/>

                            <Button Content="🚪  Вийти"
                                    Style="{StaticResource DropdownItemStyle}"
                                    Foreground="#E24B4A"
                                    Click="Logout_Click"/>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Border>

        <!-- Контентная область -->
        <Border x:Name="ContentArea"
                Grid.Row="1"
                Background="#F5F5F5">
            <ContentControl x:Name="MainContent"/>
        </Border>
    </Grid>
</Window>