<Window x:Class="MedicalApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MedicalApp" Height="800" Width="1280"
        WindowStartupLocation="CenterScreen"
        MinHeight="600" MinWidth="900">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Сайдбар -->
        <Border x:Name="Sidebar"
                Grid.Column="0"
                Background="#185FA5"
                Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Логотип -->
                <StackPanel Grid.Row="0" Margin="20,24,20,20">
                    <TextBlock Text="MedicalApp"
                               Foreground="White"
                               FontSize="16"
                               FontWeight="Medium"/>
                    <TextBlock Text="Медична система"
                               Foreground="#B5D4F4"
                               FontSize="11"
                               Margin="0,2,0,0"/>
                    <Border BorderBrush="#378ADD"
                            BorderThickness="0,0,0,1"
                            Margin="0,16,0,0"/>
                </StackPanel>

                <!-- Навигация -->
                <StackPanel Grid.Row="1" Margin="0,12,0,0">
                    <Button x:Name="NavPatients"
                            Content="Пацієнти"
                            Style="{StaticResource NavButtonStyle}"
                            Click="NavPatients_Click"/>
                </StackPanel>

                <!-- Пользователь -->
                <Border Grid.Row="2"
                        BorderBrush="#378ADD"
                        BorderThickness="0,1,0,0"
                        Padding="20,16">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="32" Height="32"
                                CornerRadius="16"
                                Background="#378ADD">
                            <TextBlock x:Name="UserInitials"
                                       Text="ЛІ"
                                       Foreground="White"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="UserName"
                                       Text="Лікар"
                                       Foreground="White"
                                       FontSize="13"/>
                            <TextBlock x:Name="UserRole"
                                       Text="Лікар"
                                       Foreground="#B5D4F4"
                                       FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Контентная область -->
        <Border x:Name="ContentArea"
                Grid.Column="1"
                Background="#F5F5F5">
            <ContentControl x:Name="MainContent"/>
        </Border>
    </Grid>
</Window>