<UserControl x:Class="MedicalApp.Views.PatientListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MedicalApp.ViewModels">

    <UserControl.DataContext>
        <vm:PatientListViewModel/>
    </UserControl.DataContext>

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Поиск и фильтры -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#D3D1C7"
                BorderThickness="0,0,0,1"
                Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Поиск -->
                <Border BorderBrush="#D3D1C7"
                        BorderThickness="1"
                        CornerRadius="6"
                        Height="38"
                        Margin="0,0,12,0"
                        Padding="10,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔍"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   Foreground="#888780"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0"
                                 FontSize="13"
                                 VerticalAlignment="Center"
                                 Background="Transparent">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <ScrollViewer x:Name="PART_ContentHost"/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>
                </Border>

                <!-- Кнопка фильтра -->
                <Grid Grid.Column="1">
                    <Button x:Name="FilterButton"
                            Click="FilterButton_Click"
                            Height="38"
                            Padding="14,0"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="BorderBrush" Value="#D3D1C7"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  Margin="{TemplateBinding Padding}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#F1EFE8"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Фільтр пошуку"
                                       FontSize="13"
                                       Foreground="#5F5E5A"
                                       Margin="0,0,6,0"/>
                            <TextBlock Text="▼"
                                       FontSize="10"
                                       Foreground="#888780"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Dropdown фильтра -->
                    <Popup x:Name="FilterPopup"
                           PlacementTarget="{Binding ElementName=FilterButton}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True">
                        <Border Background="White"
                                BorderBrush="#D3D1C7"
                                BorderThickness="1"
                                CornerRadius="8"
                                MinWidth="260"
                                Margin="0,6,0,0"
                                Padding="16">
                            <Border.Effect>
                                <DropShadowEffect Color="#888780"
                                                  BlurRadius="12"
                                                  ShadowDepth="2"
                                                  Opacity="0.15"/>
                            </Border.Effect>
                            <StackPanel>

                                <!-- Пол -->
                                <TextBlock Text="Стать"
                                           FontSize="12"
                                           Foreground="#888780"
                                           Margin="0,0,0,8"/>
                                <WrapPanel Margin="0,0,0,16">
                                    <Button Content="Всі"
                                            Tag="Всі"
                                            Click="GenderFilter_Click"
                                            Margin="0,0,6,6"
                                            Height="30"
                                            Padding="12,0"
                                            Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#E6F1FB"/>
                                                <Setter Property="Foreground" Value="#185FA5"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="BorderBrush" Value="#B5D4F4"/>
                                                <Setter Property="FontSize" Value="12"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                    CornerRadius="6">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"
                                                                                  Margin="{TemplateBinding Padding}"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#B5D4F4"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="Чоловік"
                                            Tag="Чоловік"
                                            Click="GenderFilter_Click"
                                            Margin="0,0,6,6"
                                            Height="30"
                                            Padding="12,0"
                                            Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="White"/>
                                                <Setter Property="Foreground" Value="#5F5E5A"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="BorderBrush" Value="#D3D1C7"/>
                                                <Setter Property="FontSize" Value="12"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                    CornerRadius="6">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"
                                                                                  Margin="{TemplateBinding Padding}"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#F1EFE8"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="Жінка"
                                            Tag="Жінка"
                                            Click="GenderFilter_Click"
                                            Margin="0,0,6,6"
                                            Height="30"
                                            Padding="12,0"
                                            Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="White"/>
                                                <Setter Property="Foreground" Value="#5F5E5A"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="BorderBrush" Value="#D3D1C7"/>
                                                <Setter Property="FontSize" Value="12"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                    CornerRadius="6">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"
                                                                                  Margin="{TemplateBinding Padding}"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#F1EFE8"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="Інше"
                                            Tag="Інше"
                                            Click="GenderFilter_Click"
                                            Margin="0,0,0,6"
                                            Height="30"
                                            Padding="12,0"
                                            Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="White"/>
                                                <Setter Property="Foreground" Value="#5F5E5A"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="BorderBrush" Value="#D3D1C7"/>
                                                <Setter Property="FontSize" Value="12"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                    CornerRadius="6">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"
                                                                                  Margin="{TemplateBinding Padding}"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#F1EFE8"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </WrapPanel>

                                <!-- Возраст -->
                                <TextBlock Text="Вік"
                                           FontSize="12"
                                           Foreground="#888780"
                                           Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            BorderBrush="#D3D1C7"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="8,0"
                                            Height="34">
                                        <TextBox BorderThickness="0"
                                             FontSize="13"
                                             VerticalAlignment="Center"
                                             Background="Transparent">
                                             <TextBox.Text>
                                                      <Binding Path="AgeFrom"
                                                     UpdateSourceTrigger="PropertyChanged"
                                                     TargetNullValue="від"/>
                                             </TextBox.Text>
                                        </TextBox>
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               Text="—"
                                               Margin="8,0"
                                               VerticalAlignment="Center"
                                               Foreground="#888780"/>
                                    <Border Grid.Column="2"
                                            BorderBrush="#D3D1C7"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="8,0"
                                            Height="34">
                                        <TextBox BorderThickness="0"
                                                 FontSize="13"
                                                 VerticalAlignment="Center"
                                                 Background="Transparent">
                                            <TextBox.Text>
                                                <Binding Path="AgeTo"
                                                    UpdateSourceTrigger="PropertyChanged"
                                                    TargetNullValue="до"/>
                                            </TextBox.Text>
                                        </TextBox>
                                    </Border>
                                </Grid>

                                <!-- Сброс -->
                                <Border BorderBrush="#D3D1C7"
                                        BorderThickness="0,1,0,0"
                                        Margin="0,0,0,8"/>
                                <Button Content="Скинути фільтри"
                                        Height="34"
                                        FontSize="13"
                                        Cursor="Hand"
                                        Click="ResetFilters_Click">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="White"/>
                                            <Setter Property="Foreground" Value="#5F5E5A"/>
                                            <Setter Property="BorderBrush" Value="#D3D1C7"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="6">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#F1EFE8"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Grid>
        </Border>

        <!-- Список пациентов -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,16">
                <TextBlock Margin="0,0,0,10"
                           FontSize="12"
                           Foreground="#888780">
                    <Run Text="Знайдено: "/>
                    <Run Text="{Binding TotalPatients}"/>
                    <Run Text=" пацієнтів"/>
                </TextBlock>

                <ItemsControl ItemsSource="{Binding CurrentPagePatients}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White"
                                    BorderBrush="#D3D1C7"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Margin="0,0,0,8"
                                    Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding FullName}"
                                               FontSize="14"
                                               FontWeight="Medium"
                                               Foreground="#2C2C2A"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="1"
                                               FontSize="13"
                                               Foreground="#5F5E5A"
                                               VerticalAlignment="Center">
                                        <Run Text="{Binding Age, Mode=OneWay}"/>
                                        <Run Text=" років"/>
                                    </TextBlock>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding GenderDisplay}"
                                               FontSize="13"
                                               Foreground="#5F5E5A"
                                               VerticalAlignment="Center"/>

                                    <Button Grid.Column="3"
                                            Content="Медична картка →"
                                            Height="32"
                                            Padding="12,0"
                                            Cursor="Hand"
                                            FontSize="12"
                                            Tag="{Binding}"
                                            Click="OpenMedicalCard_Click">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#185FA5"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    CornerRadius="6">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"
                                                                                  Margin="{TemplateBinding Padding}"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#0C447C"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Пагинация -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#D3D1C7"
                BorderThickness="0,1,0,0"
                Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Кнопки страниц -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="←"
                            Command="{Binding PrevPageCommand}"
                            IsEnabled="{Binding CanGoPrev}"
                            Width="32" Height="32"
                            Margin="0,0,4,0"
                            FontSize="14"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="#2C2C2A"/>
                                <Setter Property="BorderBrush" Value="#D3D1C7"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Foreground" Value="#B4B2A9"/>
                                                    <Setter Property="BorderBrush" Value="#F1EFE8"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#F1EFE8"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <ItemsControl ItemsSource="{Binding PageNumbers}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}"
                                        Width="32" Height="32"
                                        Margin="2,0"
                                        Cursor="Hand"
                                        FontSize="13"
                                        Tag="{Binding}"
                                        Click="PageButton_Click">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="White"/>
                                            <Setter Property="Foreground" Value="#2C2C2A"/>
                                            <Setter Property="BorderBrush" Value="#D3D1C7"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="6">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#F1EFE8"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="→"
                            Command="{Binding NextPageCommand}"
                            IsEnabled="{Binding CanGoNext}"
                            Width="32" Height="32"
                            Margin="4,0,0,0"
                            FontSize="14"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="#2C2C2A"/>
                                <Setter Property="BorderBrush" Value="#D3D1C7"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Foreground" Value="#B4B2A9"/>
                                                    <Setter Property="BorderBrush" Value="#F1EFE8"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#F1EFE8"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!-- Размер страницы текстовым полем -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="Показувати:"
                               FontSize="12"
                               Foreground="#888780"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <Border BorderBrush="#D3D1C7"
                            BorderThickness="1"
                            CornerRadius="6"
                            Width="50"
                            Height="32"
                            Padding="8,0">
                        <TextBox Text="{Binding PageSizeInput, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0"
                                 FontSize="13"
                                 VerticalAlignment="Center"
                                 Background="Transparent"
                                 TextAlignment="Center"/>
                    </Border>
                    <TextBlock Text="на сторінці"
                               FontSize="12"
                               Foreground="#888780"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>