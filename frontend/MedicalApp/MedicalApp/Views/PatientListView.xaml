<UserControl x:Class="MedicalApp.Views.PatientListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:MedicalApp.ViewModels">

    <UserControl.DataContext>
        <vm:PatientListViewModel/>
    </UserControl.DataContext>

    <Grid Background="{ui:ThemeResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Поиск и фильтры -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#E0DEDB"
                BorderThickness="0,0,0,1"
                Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ui:TextBox PlaceholderText="Пошук пацієнта за ім'ям..."
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                            Icon="{ui:SymbolIcon Search24}"
                            FontSize="13"
                            Margin="0,0,12,0"/>

                <Grid Grid.Column="1">
                    <ui:Button x:Name="FilterButton"
                                Click="FilterButton_Click"
                                Height="38"
                                Padding="14,0"
                                Cursor="Hand"
                                Appearance="Secondary">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Options24"
                                    FontSize="14"
                                    Margin="0,0,6,0"/>
                                         <TextBlock Text="Фільтри"
                                FontSize="13"
                                Margin="0,0,6,0"/>
                                         <ui:SymbolIcon Symbol="ChevronDown24"
                                    FontSize="12"
                                    VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>

                    <Popup x:Name="FilterPopup"
                           PlacementTarget="{Binding ElementName=FilterButton}"
                           Placement="Bottom"
                           VerticalOffset="10"
                           HorizontalOffset="-160"
                           StaysOpen="False"
                           AllowsTransparency="True">
                        <Border Background="White"
                                BorderBrush="#D3D1C7"
                                BorderThickness="1"
                                CornerRadius="8"
                                MinWidth="280"
                                Margin="0,6,0,0"
                                Padding="16">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000"
                                                  BlurRadius="16"
                                                  ShadowDepth="2"
                                                  Opacity="0.08"/>
                            </Border.Effect>
                            <StackPanel>
                                <!-- Мои пациенты -->
                                <Border Background="#F8F9FA"
            CornerRadius="6"
            Padding="12,10"
            Margin="0,0,0,8">
                                    <CheckBox Content="Тільки мої пацієнти"
                  IsChecked="{Binding OnlyMyPatients}"
                  FontSize="13"
                  Foreground="#2C2C2A">
                                        <CheckBox.Style>
                                            <Style TargetType="CheckBox">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="CheckBox">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Border x:Name="Box"
                                            Width="18" Height="18"
                                            CornerRadius="4"
                                            BorderThickness="1.5"
                                            BorderBrush="#D3D1C7"
                                            Background="White"
                                            Margin="0,0,8,0">
                                                                    <TextBlock x:Name="Check"
                                                   Text="✓"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Visibility="Collapsed"/>
                                                                </Border>
                                                                <ContentPresenter VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="Box" Property="Background" Value="#185FA5"/>
                                                                    <Setter TargetName="Box" Property="BorderBrush" Value="#185FA5"/>
                                                                    <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </CheckBox.Style>
                                    </CheckBox>
                                </Border>

                                <!-- Пол -->
                                <Border Background="#F8F9FA"
            CornerRadius="6"
            Padding="12,10"
            Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="СТАТЬ"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="#888780"
                       Margin="0,0,0,8"/>
                                        <WrapPanel>
                                            <Button x:Name="GenderAll" Content="Всі" Tag="Всі"
                        Click="GenderFilter_Click"
                        Margin="0,0,6,0" Height="30" Padding="12,0" Cursor="Hand"
                        Background="#E6F1FB" Foreground="#185FA5" BorderBrush="#185FA5">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="FontSize" Value="12"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6">
                                                                        <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Margin="{TemplateBinding Padding}"/>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button x:Name="GenderMale" Content="Чоловік" Tag="Чоловік"
                        Click="GenderFilter_Click"
                        Margin="0,0,6,0" Height="30" Padding="12,0" Cursor="Hand"
                        Background="White" Foreground="#5F5E5A" BorderBrush="#D3D1C7">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="FontSize" Value="12"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6">
                                                                        <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Margin="{TemplateBinding Padding}"/>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button x:Name="GenderFemale" Content="Жінка" Tag="Жінка"
                        Click="GenderFilter_Click"
                        Margin="0" Height="30" Padding="12,0" Cursor="Hand"
                        Background="White" Foreground="#5F5E5A" BorderBrush="#D3D1C7">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="FontSize" Value="12"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6">
                                                                        <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Margin="{TemplateBinding Padding}"/>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Возраст -->
                                <Border Background="#F8F9FA"
            CornerRadius="6"
            Padding="12,10"
            Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="ВІК"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="#888780"
                       Margin="0,0,0,8"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <ui:TextBox Grid.Column="0" PlaceholderText="від">
                                                <ui:TextBox.Text>
                                                    <Binding Path="AgeFrom" UpdateSourceTrigger="PropertyChanged" TargetNullValue=""/>
                                                </ui:TextBox.Text>
                                            </ui:TextBox>
                                            <TextBlock Grid.Column="1" Text="—"
                           Margin="8,0" VerticalAlignment="Center"
                           Foreground="#888780"/>
                                            <ui:TextBox Grid.Column="2" PlaceholderText="до">
                                                <ui:TextBox.Text>
                                                    <Binding Path="AgeTo" UpdateSourceTrigger="PropertyChanged" TargetNullValue=""/>
                                                </ui:TextBox.Text>
                                            </ui:TextBox>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Сброс -->
                                <Button Content="Скинути фільтри"
            Height="34" FontSize="13"
            Cursor="Hand"
            Click="ResetFilters_Click">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="White"/>
                                            <Setter Property="Foreground" Value="#5F5E5A"/>
                                            <Setter Property="BorderBrush" Value="#D3D1C7"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#FEF2F2"/>
                                                                <Setter Property="Foreground" Value="#E24B4A"/>
                                                                <Setter Property="BorderBrush" Value="#FECACA"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Grid>
        </Border>

        <!-- Список -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,16">

                <TextBlock Margin="0,0,0,12" FontSize="12" Foreground="#888780">
                    <Run Text="Знайдено: "/>
                    <Run Text="{Binding TotalPatients}" FontWeight="SemiBold" Foreground="#5F5E5A"/>
                    <Run Text=" пацієнтів"/>
                </TextBlock>

                <ui:ProgressRing IsIndeterminate="True"
                                 Width="32" Height="32"
                                 HorizontalAlignment="Center"
                                 Margin="0,40,0,0">
                    <ui:ProgressRing.Style>
                        <Style TargetType="ui:ProgressRing">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:ProgressRing.Style>
                </ui:ProgressRing>

                <ItemsControl ItemsSource="{Binding CurrentPagePatients}">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White"
                                    BorderBrush="#E0DEDB"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Margin="0,0,0,8"
                                    Padding="20,14">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="#185FA5"/>
                                                <Setter Property="Background" Value="#FAFCFF"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Width="36" Height="36"
                                            CornerRadius="18"
                                            Background="#E6F1FB">
                                        <TextBlock FontSize="14"
                                                   Foreground="#185FA5"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding FullName[0]}"/>
                                    </Border>

                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Margin="12,0,0,0">
                                        <TextBlock Text="{Binding FullName}"
                                                   FontSize="14"
                                                   FontWeight="Medium"
                                                   Foreground="#2C2C2A"/>
                                        <TextBlock FontSize="12"
                                                   Foreground="#888780"
                                                   Margin="0,2,0,0">
                                            <Run Text="{Binding GenderDisplay}"/>
                                            <Run Text="·"/>
                                            <Run Text="{Binding AgeLabel, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <Button Grid.Column="2"
                                            Height="34"
                                            Padding="14,0"
                                            Cursor="Hand"
                                            FontSize="12"
                                            Tag="{Binding}"
                                            Click="OpenMedicalCard_Click">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#185FA5"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    CornerRadius="6">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"
                                                                                  Margin="{TemplateBinding Padding}"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#1A6FB8"/>
                                                                </Trigger>
                                                                <Trigger Property="IsPressed" Value="True">
                                                                    <Setter Property="Background" Value="#0C447C"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Медична картка"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"/>
                                            <ui:SymbolIcon Symbol="ChevronRight24"
                                                           FontSize="12"
                                                           Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Пагинация -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E0DEDB"
                BorderThickness="0,1,0,0"
                Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="←"
                            Click="PrevPage_Click"
                            IsEnabled="{Binding CanGoPrev}"
                            Width="32" Height="32"
                            Margin="0,0,4,0" FontSize="14" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="#2C2C2A"/>
                                <Setter Property="BorderBrush" Value="#D3D1C7"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Foreground" Value="#C0BEBC"/>
                                                    <Setter Property="BorderBrush" Value="#EEECE8"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#F1EFE8"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <ItemsControl x:Name="PageButtonsList" ItemsSource="{Binding PageNumbers}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}"
                                        Width="32" Height="32"
                                        Margin="2,0" Cursor="Hand"
                                        FontSize="13" Tag="{Binding}"
                                        Click="PageButton_Click">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="White"/>
                                            <Setter Property="Foreground" Value="#2C2C2A"/>
                                            <Setter Property="BorderBrush" Value="#D3D1C7"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="FontWeight" Value="Normal"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="6">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#E6F1FB"/>
                                                                <Setter Property="BorderBrush" Value="#185FA5"/>
                                                                <Setter Property="Foreground" Value="#185FA5"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="→"
                            Click="NextPage_Click"
                            IsEnabled="{Binding CanGoNext}"
                            Width="32" Height="32"
                            Margin="4,0,0,0" FontSize="14" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="#2C2C2A"/>
                                <Setter Property="BorderBrush" Value="#D3D1C7"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Foreground" Value="#C0BEBC"/>
                                                    <Setter Property="BorderBrush" Value="#EEECE8"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#F1EFE8"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="Показувати:"
                               FontSize="12" Foreground="#888780"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <ui:TextBox Text="{Binding PageSizeInput, UpdateSourceTrigger=PropertyChanged}"
                                Width="56" FontSize="13"
                                PlaceholderText="10"
                                ClearButtonEnabled="False"/>
                    <TextBlock Text="на сторінці"
                               FontSize="12" Foreground="#888780"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>