<UserControl x:Class="MedicalApp.Views.EditMedicalCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:MedicalApp.ViewModels">

    <Grid Background="{ui:ThemeResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="White"
                BorderBrush="#E0DEDB" BorderThickness="0,0,0,1"
                Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Patient.FullName}"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="#2C2C2A"/>
                    <TextBlock Text="Редагування медичної картки"
                               FontSize="12" Foreground="#888780"/>
                </StackPanel>

                <ui:Button Grid.Column="1"
                           Click="BackButton_Click"
                           Height="36" Padding="14,0"
                           Cursor="Hand" Margin="0,0,8,0"
                           Appearance="Secondary">
                    <TextBlock Text="Відмінити" FontSize="13"/>
                </ui:Button>

                <Button Grid.Column="2"
                        Command="{Binding SaveCommand}"
                        Height="36" Padding="14,0"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#185FA5"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Margin="{TemplateBinding Padding}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#1A6FB8"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background" Value="#0C447C"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Save24" FontSize="14" Margin="0,0,6,0"/>
                        <TextBlock Text="Зберегти" FontSize="13"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20">

                <!-- Помилка -->
                <ui:InfoBar Title=""
                            Message="{Binding ErrorMessage}"
                            Severity="Error"
                            IsOpen="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}"
                            IsClosable="False"
                            Margin="0,0,0,16"/>

                <!-- Група крові та резус -->
                <Border Background="White" BorderBrush="#E0DEDB"
                        BorderThickness="1" CornerRadius="8"
                        Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="ГРУПА КРОВІ ТА РЕЗУС ФАКТОР"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="#888780" Margin="0,0,0,16"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Група крові -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Група крові"
                                           FontSize="12" Foreground="#5F5E5A"
                                           Margin="0,0,0,10"/>
                                <ItemsControl x:Name="BloodGroupPanel" ItemsSource="{Binding BloodGroupOptions}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding}" 
                                                Tag="{Binding}"
                                                    Click="BloodGroupButton_Click"
                                                    Width="64" Height="44"
                                                    Margin="0,0,8,0"
                                                    Cursor="Hand">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="White"/>
                                                        <Setter Property="Foreground" Value="#5F5E5A"/>
                                                        <Setter Property="BorderBrush" Value="#D3D1C7"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6">
                                                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="#E6F1FB"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                                <Button.ContentTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}"
                                   FontSize="16" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                                                    </DataTemplate>
                                                </Button.ContentTemplate>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Выбранная группа -->
                                <Border Margin="0,12,0,0"
                                        Background="#E6F1FB"
                                        CornerRadius="6"
                                        Padding="12,8"
                                        HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Drop24"
                                                       FontSize="14"
                                                       Foreground="#185FA5"
                                                       Margin="0,0,6,0"/>
                                        <TextBlock FontSize="13" Foreground="#185FA5" FontWeight="SemiBold"
                                                   Text="{Binding SelectedBloodGroupLabel}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Резус -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Резус фактор"
                                           FontSize="12" Foreground="#5F5E5A"
                                           Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="72" Height="44"
                                            CornerRadius="6"
                                            Margin="0,0,8,0" Cursor="Hand">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="White"/>
                                                <Setter Property="BorderBrush" Value="#D3D1C7"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRhPositive}" Value="True">
                                                        <Setter Property="Background" Value="#E6F1FB"/>
                                                        <Setter Property="BorderBrush" Value="#185FA5"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.SetRhPositiveCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                        </Border.InputBindings>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="Rh+"
                                                       FontSize="16" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#5F5E5A"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRhPositive}" Value="True">
                                                                <Setter Property="Foreground" Value="#185FA5"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="Позитивний" FontSize="10"
                                                       HorizontalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#888780"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRhPositive}" Value="True">
                                                                <Setter Property="Foreground" Value="#185FA5"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <Border Width="72" Height="44"
                                            CornerRadius="6" Cursor="Hand">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="White"/>
                                                <Setter Property="BorderBrush" Value="#D3D1C7"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRhNegative}" Value="True">
                                                        <Setter Property="Background" Value="#FCEBEB"/>
                                                        <Setter Property="BorderBrush" Value="#E24B4A"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.SetRhNegativeCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                        </Border.InputBindings>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="Rh−"
                                                       FontSize="16" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#5F5E5A"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRhNegative}" Value="True">
                                                                <Setter Property="Foreground" Value="#E24B4A"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="Негативний" FontSize="10"
                                                       HorizontalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#888780"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRhNegative}" Value="True">
                                                                <Setter Property="Foreground" Value="#E24B4A"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Алергії -->
                <Border Background="White" BorderBrush="#E0DEDB"
                        BorderThickness="1" CornerRadius="8"
                        Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="АЛЕРГІЇ" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#888780" Margin="0,0,0,14"/>

                        <ItemsControl ItemsSource="{Binding Allergies}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#F1EFE8"
                                            BorderThickness="0,0,0,1" Padding="0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Name}"
                                                       FontSize="13" FontWeight="Medium"
                                                       Foreground="#2C2C2A"
                                                       VerticalAlignment="Center"/>

                                            <!-- Редактирование важкості -->
                                            <ComboBox Grid.Column="1"
                                                      ItemsSource="{Binding DataContext.SeverityDisplayOptions,
                                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      SelectedValue="{Binding SeverityDisplay}"
                                                      Height="32" FontSize="12"
                                                      BorderBrush="#D3D1C7"
                                                      Margin="0,0,8,0"
                                                      Tag="{Binding}"
                                                      SelectionChanged="AllergySeverity_SelectionChanged"/>

                                            <Button Grid.Column="2"
                                                    Command="{Binding DataContext.RemoveAllergyCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Width="28" Height="28" Cursor="Hand">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="White"/>
                                                        <Setter Property="Foreground" Value="#E24B4A"/>
                                                        <Setter Property="BorderBrush" Value="#FECACA"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}"
                                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                                            CornerRadius="6">
                                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                                          VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="#FCEBEB"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                                <ui:SymbolIcon Symbol="Delete24" FontSize="13"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Додати алергію -->
                        <Border Background="#F8F9FA" CornerRadius="8"
                                Padding="16" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Додати алергію"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="#5F5E5A" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Пошук + вибір в одному ComboBox -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Алерген" FontSize="11"
                                              Foreground="#888780" Margin="0,0,0,4"/>
                                        <ComboBox ItemsSource="{Binding AvailableAllergens}"
                                                  SelectedItem="{Binding SelectedAllergen}"
                                                  DisplayMemberPath="Name"
                                                  TextSearch.TextPath="Name"
                                                  IsTextSearchEnabled="True"
                                                  IsEditable="True"
                                                  StaysOpenOnEdit="True"
                                                  Height="36" FontSize="13"
                                                  BorderBrush="#D3D1C7"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                        <TextBlock Text="Важкість реакції" FontSize="11"
                                                   Foreground="#888780" Margin="0,0,0,4"/>
                                        <ComboBox ItemsSource="{Binding SeverityDisplayOptions}"
                                                  Height="36" FontSize="13"
                                                  BorderBrush="#D3D1C7"
                                                  SelectionChanged="NewAllergySeverity_SelectionChanged"/>
                                    </StackPanel>

                                    <Button Grid.Column="4"
                                            Command="{Binding AddAllergyCommand}"
                                            Height="36" Padding="14,0"
                                            Cursor="Hand" VerticalAlignment="Bottom">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#185FA5"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"
                                                                                  Margin="{TemplateBinding Padding}"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#1A6FB8"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Add24" FontSize="13" Margin="0,0,4,0"/>
                                            <TextBlock Text="Додати" FontSize="13"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Діагнози -->
                <Border Background="White" BorderBrush="#E0DEDB"
                        BorderThickness="1" CornerRadius="8"
                        Padding="20" Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="ДІАГНОЗИ" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#888780" Margin="0,0,0,14"/>

                        <ItemsControl ItemsSource="{Binding Diagnoses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#F1EFE8"
                                            BorderThickness="0,0,0,1" Padding="0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Background="#F1EFE8"
                                                    CornerRadius="4" Padding="6,3"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding IcdCode}"
                                                           FontSize="12" Foreground="#5F5E5A"
                                                           FontWeight="Medium"/>
                                            </Border>

                                            <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                       FontSize="13" FontWeight="Medium"
                                                       Foreground="#2C2C2A"
                                                       VerticalAlignment="Center"
                                                       Margin="12,0"/>

                                            <ComboBox Grid.Column="2"
                                                      ItemsSource="{Binding DataContext.DiseaseStatusDisplayOptions,
                                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      SelectedValue="{Binding StatusDisplay}"
                                                      Height="32" FontSize="12"
                                                      BorderBrush="#D3D1C7"
                                                      Margin="0,0,8,0"
                                                      Tag="{Binding}"
                                                      SelectionChanged="DiseaseStatus_SelectionChanged"/>

                                            <Button Grid.Column="3"
                                                    Command="{Binding DataContext.RemoveDiseaseCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Width="28" Height="28" Cursor="Hand">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="White"/>
                                                        <Setter Property="Foreground" Value="#E24B4A"/>
                                                        <Setter Property="BorderBrush" Value="#FECACA"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}"
                                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                                            CornerRadius="6">
                                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                                          VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="#FCEBEB"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                                <ui:SymbolIcon Symbol="Delete24" FontSize="13"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Додати діагноз -->
                        <Border Background="#F8F9FA" CornerRadius="8"
                                Padding="16" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Додати діагноз"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="#5F5E5A" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Алерген" FontSize="11"
                                              Foreground="#888780" Margin="0,0,0,4"/>
                                        <ComboBox ItemsSource="{Binding AvailableDiseases}"
                                                  SelectedItem="{Binding SelectedDisease}"
                                                  DisplayMemberPath="Name"
                                                  TextSearch.TextPath="Name"
                                                  IsTextSearchEnabled="True"
                                                  IsEditable="True"
                                                  StaysOpenOnEdit="True"
                                                  Height="36" FontSize="13"
                                                   BorderBrush="#D3D1C7"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                        <TextBlock Text="Статус діагнозу" FontSize="11"
                                                   Foreground="#888780" Margin="0,0,0,4"/>
                                        <ComboBox ItemsSource="{Binding DiseaseStatusDisplayOptions}"
                                                  Height="36" FontSize="13"
                                                  BorderBrush="#D3D1C7"
                                                  SelectionChanged="NewDiseaseStatus_SelectionChanged"/>
                                    </StackPanel>

                                    <Button Grid.Column="4"
                                            Command="{Binding AddDiseaseCommand}"
                                            Height="36" Padding="14,0"
                                            Cursor="Hand" VerticalAlignment="Bottom">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#185FA5"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"
                                                                                  Margin="{TemplateBinding Padding}"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#1A6FB8"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Add24" FontSize="13" Margin="0,0,4,0"/>
                                            <TextBlock Text="Додати" FontSize="13"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>