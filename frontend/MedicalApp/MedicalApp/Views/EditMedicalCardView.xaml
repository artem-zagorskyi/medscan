<UserControl x:Class="MedicalApp.Views.EditMedicalCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MedicalApp.ViewModels">

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#D3D1C7"
                BorderThickness="0,0,0,1"
                Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Назад -->
                <Button Grid.Column="0"
                        Content="← Назад"
                        Click="BackButton_Click"
                        Height="36"
                        Padding="12,0"
                        Cursor="Hand"
                        Margin="0,0,16,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="Foreground" Value="#185FA5"/>
                            <Setter Property="BorderBrush" Value="#B5D4F4"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Margin="{TemplateBinding Padding}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#E6F1FB"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- ПІБ -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Patient.FullName}"
                               FontSize="16"
                               FontWeight="Medium"
                               Foreground="#2C2C2A"/>
                    <TextBlock Text="Редагування медичної картки"
                               FontSize="12"
                               Foreground="#888780"/>
                </StackPanel>

                <!-- Відмінити -->
                <Button Grid.Column="2"
                        Content="Відмінити"
                        Click="BackButton_Click"
                        Height="36"
                        Padding="14,0"
                        Cursor="Hand"
                        Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="Foreground" Value="#5F5E5A"/>
                            <Setter Property="BorderBrush" Value="#D3D1C7"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Margin="{TemplateBinding Padding}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#F1EFE8"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Зберегти -->
                <Button Grid.Column="3"
                        Content="💾 Зберегти"
                        Command="{Binding SaveCommand}"
                        Height="36"
                        Padding="14,0"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#185FA5"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Margin="{TemplateBinding Padding}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#0C447C"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- Контент -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20">

                <!-- Помилка -->
                <Border Background="#FCEBEB"
                        BorderBrush="#F09595"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,12"
                        Margin="0,0,0,16"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#A32D2D"
                               FontSize="13"/>
                </Border>

                <!-- Група крові та резус -->
                <Border Background="White"
                        BorderBrush="#D3D1C7"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="ГРУПА КРОВІ ТА РЕЗУС ФАКТОР"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   Foreground="#888780"
                                   Margin="0,0,0,16"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Група крові -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Група крові"
                                           FontSize="12"
                                           Foreground="#5F5E5A"
                                           Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <ItemsControl ItemsSource="{Binding BloodGroupOptions}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding}"
                                                        Tag="{Binding}"
                                                        Click="BloodGroupButton_Click"
                                                        Width="56" Height="40"
                                                        Margin="0,0,8,0"
                                                        Cursor="Hand"
                                                        FontSize="14"
                                                        FontWeight="Medium">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Background" Value="White"/>
                                                            <Setter Property="Foreground" Value="#5F5E5A"/>
                                                            <Setter Property="BorderBrush" Value="#D3D1C7"/>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="{TemplateBinding Background}"
                                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                                CornerRadius="6">
                                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                                              VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter Property="Background" Value="#E6F1FB"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="#888780">
                                    <Run Text="Обрано:"/>
                                    <Run Text="{Binding SelectedBloodGroup}" Foreground="#185FA5" FontWeight="Medium"/>
                                </TextBlock>
                            </StackPanel>

                            <!-- Резус -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Резус фактор"
                                           FontSize="12"
                                           Foreground="#5F5E5A"
                                           Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="56" Height="40"
                                            CornerRadius="6"
                                            Margin="0,0,8,0"
                                            Cursor="Hand">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="White"/>
                                                <Setter Property="BorderBrush" Value="#D3D1C7"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRhPositive}" Value="True">
                                                        <Setter Property="Background" Value="#E6F1FB"/>
                                                        <Setter Property="BorderBrush" Value="#185FA5"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.SetRhPositiveCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                        </Border.InputBindings>
                                        <TextBlock Text="Rh+"
                                                   FontSize="14"
                                                   FontWeight="Medium"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#5F5E5A"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRhPositive}" Value="True">
                                                            <Setter Property="Foreground" Value="#185FA5"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>

                                    <Border Width="56" Height="40"
                                            CornerRadius="6"
                                            Cursor="Hand">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="White"/>
                                                <Setter Property="BorderBrush" Value="#D3D1C7"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRhNegative}" Value="True">
                                                        <Setter Property="Background" Value="#FCEBEB"/>
                                                        <Setter Property="BorderBrush" Value="#E24B4A"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.SetRhNegativeCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                        </Border.InputBindings>
                                        <TextBlock Text="Rh-"
                                                   FontSize="14"
                                                   FontWeight="Medium"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#5F5E5A"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRhNegative}" Value="True">
                                                            <Setter Property="Foreground" Value="#E24B4A"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Алергії -->
                <Border Background="White"
                        BorderBrush="#D3D1C7"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="АЛЕРГІЇ"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   Foreground="#888780"
                                   Margin="0,0,0,14"/>

                        <!-- Список алергій -->
                        <ItemsControl ItemsSource="{Binding Allergies}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#F1EFE8"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Name}"
                                                       FontSize="13"
                                                       FontWeight="Medium"
                                                       Foreground="#2C2C2A"
                                                       VerticalAlignment="Center"/>

                                            <Border Grid.Column="1"
                                                    Background="{Binding SeverityColor}"
                                                    CornerRadius="10"
                                                    Padding="10,4"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SeverityDisplay}"
                                                           FontSize="12"
                                                           Foreground="{Binding SeverityTextColor}"/>
                                            </Border>

                                            <Button Grid.Column="2"
                                                    Content="✕"
                                                    Command="{Binding DataContext.RemoveAllergyCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Width="28" Height="28"
                                                    Cursor="Hand"
                                                    FontSize="12">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="White"/>
                                                        <Setter Property="Foreground" Value="#E24B4A"/>
                                                        <Setter Property="BorderBrush" Value="#F09595"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}"
                                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                                            CornerRadius="6">
                                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                                          VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="#FCEBEB"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Додати алергію -->
                        <Border Background="#F5F5F5"
                                CornerRadius="8"
                                Padding="16"
                                Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Додати алергію"
                                           FontSize="12"
                                           FontWeight="Medium"
                                           Foreground="#5F5E5A"
                                           Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Пошук алергену -->
                                    <StackPanel Grid.Column="0">
                                        <Border BorderBrush="#D3D1C7"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Height="36"
                                                Padding="10,0"
                                                Margin="0,0,0,6">
                                            <TextBox Text="{Binding AllergenSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                     BorderThickness="0"
                                                     FontSize="13"
                                                     VerticalAlignment="Center"
                                                     Background="Transparent">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="TextBox">
                                                                    <ScrollViewer x:Name="PART_ContentHost"/>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                        </Border>
                                        <ComboBox ItemsSource="{Binding AvailableAllergens}"
                                                  SelectedItem="{Binding SelectedAllergen}"
                                                  DisplayMemberPath="Name"
                                                  Height="36"
                                                  FontSize="13"
                                                  BorderBrush="#D3D1C7"/>
                                    </StackPanel>

                                    <!-- Важкість -->
                                    <ComboBox Grid.Column="2"
                                              ItemsSource="{Binding SeverityDisplayOptions}"
                                              Height="36"
                                              FontSize="13"
                                              BorderBrush="#D3D1C7"
                                              VerticalAlignment="Bottom"
                                              SelectionChanged="AllergySeverity_SelectionChanged"/>

                                    <!-- Кнопка -->
                                    <Button Grid.Column="4"
                                            Content="+ Додати"
                                            Command="{Binding AddAllergyCommand}"
                                            Height="36"
                                            Padding="14,0"
                                            Cursor="Hand"
                                            VerticalAlignment="Bottom">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#185FA5"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="FontSize" Value="13"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    CornerRadius="6">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"
                                                                                  Margin="{TemplateBinding Padding}"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#0C447C"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Діагнози -->
                <Border Background="White"
                        BorderBrush="#D3D1C7"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20">
                    <StackPanel>
                        <TextBlock Text="ДІАГНОЗИ"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   Foreground="#888780"
                                   Margin="0,0,0,14"/>

                        <!-- Список діагнозів -->
                        <ItemsControl ItemsSource="{Binding Diagnoses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#F1EFE8"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    Background="#F1EFE8"
                                                    CornerRadius="4"
                                                    Padding="6,3"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding IcdCode}"
                                                           FontSize="12"
                                                           Foreground="#5F5E5A"
                                                           FontWeight="Medium"/>
                                            </Border>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Name}"
                                                       FontSize="13"
                                                       FontWeight="Medium"
                                                       Foreground="#2C2C2A"
                                                       VerticalAlignment="Center"
                                                       Margin="12,0"/>

                                            <!-- Статус -->
                                            <ComboBox Grid.Column="2"
                                                      ItemsSource="{Binding DataContext.DiseaseStatusDisplayOptions,
                                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      SelectedValue="{Binding StatusDisplay}"
                                                      Height="32"
                                                      FontSize="12"
                                                      BorderBrush="#D3D1C7"
                                                      Margin="0,0,8,0"
                                                      Tag="{Binding}"
                                                      SelectionChanged="DiseaseStatus_SelectionChanged"/>

                                            <Button Grid.Column="3"
                                                    Content="✕"
                                                    Command="{Binding DataContext.RemoveDiseaseCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Width="28" Height="28"
                                                    Cursor="Hand"
                                                    FontSize="12">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="White"/>
                                                        <Setter Property="Foreground" Value="#E24B4A"/>
                                                        <Setter Property="BorderBrush" Value="#F09595"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}"
                                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                                            CornerRadius="6">
                                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                                          VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="#FCEBEB"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Додати діагноз -->
                        <Border Background="#F5F5F5"
                                CornerRadius="8"
                                Padding="16"
                                Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Додати діагноз"
                                           FontSize="12"
                                           FontWeight="Medium"
                                           Foreground="#5F5E5A"
                                           Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Пошук хвороби -->
                                    <StackPanel Grid.Column="0">
                                        <Border BorderBrush="#D3D1C7"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Height="36"
                                                Padding="10,0"
                                                Margin="0,0,0,6">
                                            <TextBox Text="{Binding DiseaseSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                     BorderThickness="0"
                                                     FontSize="13"
                                                     VerticalAlignment="Center"
                                                     Background="Transparent">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="TextBox">
                                                                    <ScrollViewer x:Name="PART_ContentHost"/>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                        </Border>
                                        <ComboBox ItemsSource="{Binding AvailableDiseases}"
                                                  SelectedItem="{Binding SelectedDisease}"
                                                  DisplayMemberPath="Name"
                                                  Height="36"
                                                  FontSize="13"
                                                  BorderBrush="#D3D1C7"/>
                                    </StackPanel>

                                    <!-- Статус -->
                                    <ComboBox Grid.Column="2"
                                              ItemsSource="{Binding DiseaseStatusDisplayOptions}"
                                              Height="36"
                                              FontSize="13"
                                              BorderBrush="#D3D1C7"
                                              VerticalAlignment="Bottom"
                                              SelectionChanged="NewDiseaseStatus_SelectionChanged"/>

                                    <!-- Кнопка -->
                                    <Button Grid.Column="4"
                                            Content="+ Додати"
                                            Command="{Binding AddDiseaseCommand}"
                                            Height="36"
                                            Padding="14,0"
                                            Cursor="Hand"
                                            VerticalAlignment="Bottom">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#185FA5"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="FontSize" Value="13"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    CornerRadius="6">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"
                                                                                  Margin="{TemplateBinding Padding}"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#0C447C"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>