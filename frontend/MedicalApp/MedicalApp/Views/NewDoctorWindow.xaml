<Window x:Class="MedicalApp.Views.NewDoctorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Новий лікар"
        Height="580" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="White"
                BorderBrush="#E0DEDB" BorderThickness="0,0,0,1"
                Padding="24,16">
            <StackPanel>
                <TextBlock Text="Новий лікар"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="#2C2C2A"/>
                <TextBlock Text="Заповніть дані для реєстрації облікового запису лікаря"
                           FontSize="12" Foreground="#888780"
                           Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Контент -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20">

                <!-- Помилка -->
                <ui:InfoBar Title=""
                            Message="{Binding ErrorMessage}"
                            Severity="Error"
                            IsOpen="{Binding HasError}"
                            IsClosable="False"
                            Margin="0,0,0,16"/>

                <!-- Особисті дані -->
                <Border Background="White" BorderBrush="#E0DEDB"
                        BorderThickness="1" CornerRadius="8"
                        Padding="20" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="ОСОБИСТІ ДАНІ"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="#888780" Margin="0,0,0,16"/>

                        <!-- Прізвище -->
                        <TextBlock Text="Прізвище" FontSize="12" FontWeight="Medium"
                                   Foreground="#5F5E5A" Margin="0,0,0,6"/>
                        <ui:TextBox PlaceholderText="Коваленко"
                                    Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"
                                    FontSize="13" Margin="0,0,0,14"/>

                        <!-- Ім'я + По батькові -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Ім'я" FontSize="12" FontWeight="Medium"
                                           Foreground="#5F5E5A" Margin="0,0,0,6"/>
                                <ui:TextBox PlaceholderText="Олексій"
                                            Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"
                                            FontSize="13"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="По батькові" FontSize="12" FontWeight="Medium"
                                           Foreground="#5F5E5A" Margin="0,0,0,6"/>
                                <ui:TextBox PlaceholderText="Іванович (необов'язково)"
                                            Text="{Binding MiddleName, UpdateSourceTrigger=PropertyChanged}"
                                            FontSize="13"/>
                            </StackPanel>
                        </Grid>

                        <!-- Дата народження + Стать -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Дата народження" FontSize="12" FontWeight="Medium"
                                           Foreground="#5F5E5A" Margin="0,0,0,6"/>
                                <DatePicker SelectedDate="{Binding BirthDate}"
                                            FontSize="13" BorderBrush="#E0DEDB"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Стать" FontSize="12" FontWeight="Medium"
                                           Foreground="#5F5E5A" Margin="0,0,0,6"/>
                                <ComboBox ItemsSource="{Binding GenderDisplayOptions}"
                                        Height="36" Padding="6,4"
                                        VerticalContentAlignment="Center"
                                        FontSize="13" BorderBrush="#E0DEDB"
                                        SelectionChanged="Gender_SelectionChanged"/>
                            </StackPanel>
                        </Grid>

                        <!-- Контакт -->
                        <TextBlock Text="Контактна інформація (необов'язково)"
                                   FontSize="12" FontWeight="Medium"
                                   Foreground="#5F5E5A" Margin="0,0,0,6"/>
                        <ui:TextBox PlaceholderText="+380671234567"
                                    Text="{Binding ContactInfo, UpdateSourceTrigger=PropertyChanged}"
                                    FontSize="13"/>
                    </StackPanel>
                </Border>

                <!-- Дані акаунту -->
                <Border Background="White" BorderBrush="#E0DEDB"
                        BorderThickness="1" CornerRadius="8"
                        Padding="20">
                    <StackPanel>
                        <TextBlock Text="ДОСТУП ДО СИСТЕМИ"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="#888780" Margin="0,0,0,16"/>

                        <!-- Спеціалізація -->
                        <TextBlock Text="Спеціалізація" FontSize="12" FontWeight="Medium"
                                   Foreground="#5F5E5A" Margin="0,0,0,6"/>
                        <ui:TextBox PlaceholderText="Кардіологія, Терапія..."
                                    Text="{Binding Specialization, UpdateSourceTrigger=PropertyChanged}"
                                    FontSize="13" Margin="0,0,0,14"/>

                        <!-- Email -->
                        <TextBlock Text="Email" FontSize="12" FontWeight="Medium"
                                   Foreground="#5F5E5A" Margin="0,0,0,6"/>
                        <ui:TextBox PlaceholderText="lікар@medscan.com"
                                    Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                    FontSize="13" Margin="0,0,0,14"
                                    Icon="{ui:SymbolIcon Mail24}"/>

                        <!-- Пароль -->
                        <TextBlock Text="Пароль" FontSize="12" FontWeight="Medium"
                                   Foreground="#5F5E5A" Margin="0,0,0,6"/>
                        <ui:PasswordBox x:Name="PasswordBox"
                                        PlaceholderText="Мінімум 6 символів"
                                        FontSize="13"
                                        PasswordChanged="PasswordBox_PasswordChanged"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Боттомбар -->
        <Border Grid.Row="2" Background="White"
                BorderBrush="#E0DEDB" BorderThickness="0,1,0,0"
                Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ui:Button Grid.Column="1"
                           Click="CancelButton_Click"
                           Height="36" Padding="14,0"
                           Cursor="Hand" Margin="0,0,8,0"
                           Appearance="Secondary"
                           Icon="{ui:SymbolIcon Dismiss24}">
                    <TextBlock Text="Відмінити" FontSize="13"/>
                </ui:Button>

                <ui:Button Grid.Column="2"
                        Command="{Binding SaveCommand}"
                        Height="36" Padding="14,0"
                        Cursor="Hand"
                        Background="#185FA5"
                        Foreground="White"
                        MouseOverBackground="#1A6FB8"
                        PressedBackground="#0C447C"
                        Icon="{ui:SymbolIcon PersonAdd24}">
                    <TextBlock Text="Створити лікаря" FontSize="13"/>
                </ui:Button>
            </Grid>
        </Border>
    </Grid>
</Window>