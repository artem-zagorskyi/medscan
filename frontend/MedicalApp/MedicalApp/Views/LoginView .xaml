<UserControl x:Class="MedicalApp.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:MedicalApp.ViewModels">

    <UserControl.DataContext>
        <vm:LoginViewModel/>
    </UserControl.DataContext>

    <Grid Background="{ui:ThemeResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Топбар -->
        <Border Grid.Row="0"
                Background="#185FA5"
                Height="56">
            <Grid Margin="24,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="MedScan"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="SemiBold"/>
                    <Border Width="1"
                            Background="#D6E6F2"
                            Margin="16,10" Height="7"/>
                    <TextBlock Text="Система медичних записів"
                               Foreground="#B5D4F4"
                               FontSize="12"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Карточка по центру -->
        <Border Grid.Row="1"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Width="380"
                Background="White"
                CornerRadius="12"
                Padding="36,32">
            <Border.Effect>
                <DropShadowEffect Color="#000000"
                                  BlurRadius="24"
                                  ShadowDepth="2"
                                  Opacity="0.08"/>
            </Border.Effect>

            <StackPanel>
                <!-- Заголовок -->
                <TextBlock Text="З поверненням!"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#2C2C2A"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,6"/>

                <TextBlock Text="Введіть email та пароль для входу до системи"
                           FontSize="13"
                           Foreground="#888780"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,0,28"/>

                <!-- Email -->
                <TextBlock Text="Email"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#2C2C2A"
                           Margin="0,0,0,6"/>
                <ui:TextBox PlaceholderText="m@example.com"
                            Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                            Icon="{ui:SymbolIcon Mail24}"
                            FontSize="14"
                            Margin="0,0,0,16"/>

                <!-- Пароль -->
                <TextBlock Text="Пароль"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#2C2C2A"
                           Margin="0,0,0,6"/>
                <ui:PasswordBox PlaceholderText="••••••••"
                                x:Name="PasswordBox"
                                
                                FontSize="14"
                                Margin="0,0,0,8"/>

                <!-- Ошибка -->
                <ui:InfoBar Title=""
                            Message="{Binding ErrorMessage}"
                            Severity="Error"
                            IsOpen="{Binding HasError}"
                            IsClosable="False"
                            Margin="0,0,0,8"/>

                <!-- Кнопка -->
                <Button Command="{Binding LoginCommand}"
                    Height="42"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Margin="0,16,0,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#185FA5"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#1A6FB8"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background" Value="#0C447C"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>

                    <Grid>
                         <TextBlock Text="Увійти"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                 <TextBlock.Style>
                                     <Style TargetType="TextBlock">
                                         <Setter Property="Visibility" Value="Visible"/>
                                         <Style.Triggers>
                                             <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                                 <Setter Property="Visibility" Value="Collapsed"/>
                                             </DataTrigger>
                                         </Style.Triggers>
                                     </Style>
                                 </TextBlock.Style>
                             </TextBlock>

                             <ui:ProgressRing IsIndeterminate="True"
                          Width="22"
                          Height="22"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Foreground="White"
                          Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
                    </Grid>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>