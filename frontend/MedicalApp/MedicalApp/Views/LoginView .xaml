<UserControl x:Class="MedicalApp.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MedicalApp.ViewModels">

    <UserControl.DataContext>
        <vm:LoginViewModel/>
    </UserControl.DataContext>

    <Grid Background="#F5F5F5">
        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Width="320">

            <!-- Логотип -->
            <TextBlock Text="MedicalApp"
                       FontSize="28"
                       FontWeight="Medium"
                       Foreground="#185FA5"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,6"/>

            <TextBlock Text="Увійдіть до системи"
                       FontSize="14"
                       Foreground="#888780"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,40"/>

            <!-- Email -->
            <TextBlock Text="Email"
                       FontSize="12"
                       Foreground="#5F5E5A"
                       Margin="0,0,0,6"/>
            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                     Height="38"
                     Padding="10,0"
                     FontSize="14"
                     BorderBrush="#D3D1C7"
                     BorderThickness="1"
                     Margin="0,0,0,16"/>

            <!-- Пароль -->
            <TextBlock Text="Пароль"
                       FontSize="12"
                       Foreground="#5F5E5A"
                       Margin="0,0,0,6"/>
            <PasswordBox x:Name="PasswordBox"
                         Height="38"
                         Padding="10,0"
                         FontSize="14"
                         BorderBrush="#D3D1C7"
                         BorderThickness="1"
                         PasswordChanged="PasswordBox_PasswordChanged"
                         Margin="0,0,0,28"/>

            <!-- Ошибка -->
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="#E24B4A"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"/>

            <!-- Кнопка -->
            <Button Command="{Binding LoginCommand}"
                    Height="42"
                    Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#185FA5"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#0C447C"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
                <TextBlock Text="Увійти" FontSize="14"/>
            </Button>

            <!-- Загрузка -->
            <TextBlock Text="Завантаження..."
                       HorizontalAlignment="Center"
                       Foreground="#888780"
                       FontSize="12"
                       Margin="0,14,0,0"
                       Visibility="{Binding IsLoading,
                                    Converter={StaticResource BoolToVisibility}}"/>
        </StackPanel>
    </Grid>
</UserControl>