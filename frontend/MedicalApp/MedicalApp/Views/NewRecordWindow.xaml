<Window x:Class="MedicalApp.Views.NewRecordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Новий запис"
        Height="700" Width="820"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="White"
                BorderBrush="#E0DEDB" BorderThickness="0,0,0,1"
                Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Новий запис"
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="#2C2C2A"/>
                    <TextBlock FontSize="12" Foreground="#888780" Margin="0,2,0,0">
                        <Run Text="{Binding Patient.FullName}"/>
                        <Run Text="·"/>
                        <Run Text="{Binding Patient.AgeLabel, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
                <Border Grid.Column="1"
                        Background="#F8F9FA"
                        CornerRadius="6" Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                       
                        <TextBlock Text="{Binding Source={x:Static sys:DateTime.Today},
                                          StringFormat=dd.MM.yyyy}"
                                   FontSize="13" Foreground="#5F5E5A"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Контент -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20" >

                <!-- Помилка -->
                <ui:InfoBar Title=""
                            Message="{Binding ErrorMessage}"
                            Severity="Error"
                            IsOpen="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}"
                            IsClosable="False"
                            Margin="0,0,0,16"/>

                <!-- Основні поля -->
                <Border Background="White" BorderBrush="#E0DEDB"
                        BorderThickness="1" CornerRadius="8"
                        Padding="20" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="ІНФОРМАЦІЯ ПРО ВІЗИТ"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="#888780" Margin="0,0,0,16"/>

                        <TextBlock Text="Скарги пацієнта"
                                   FontSize="12" FontWeight="Medium"
                                   Foreground="#5F5E5A" Margin="0,0,0,6"/>
                        <Border BorderBrush="#E0DEDB" BorderThickness="1"
                                CornerRadius="6" Margin="0,0,0,14">
                            <TextBox Text="{Binding Complaints, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0" FontSize="13"
                                     Padding="12,10" MinHeight="80"
                                     TextWrapping="Wrap" AcceptsReturn="True"
                                     Background="Transparent"
                                     VerticalScrollBarVisibility="Auto"/>
                        </Border>

                        <TextBlock Text="Висновок лікаря"
                                   FontSize="12" FontWeight="Medium"
                                   Foreground="#5F5E5A" Margin="0,0,0,6"/>
                        <Border BorderBrush="#E0DEDB" BorderThickness="1"
                                CornerRadius="6" Margin="0,0,0,14">
                            <TextBox Text="{Binding DoctorConclusion, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0" FontSize="13"
                                     Padding="12,10" MinHeight="80"
                                     TextWrapping="Wrap" AcceptsReturn="True"
                                     Background="Transparent"
                                     VerticalScrollBarVisibility="Auto"/>
                        </Border>

                        <TextBlock Text="План лікування"
                                   FontSize="12" FontWeight="Medium"
                                   Foreground="#5F5E5A" Margin="0,0,0,6"/>
                        <Border BorderBrush="#E0DEDB" BorderThickness="1"
                                CornerRadius="6">
                            <TextBox Text="{Binding TreatmentPlan, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0" FontSize="13"
                                     Padding="12,10" MinHeight="60"
                                     TextWrapping="Wrap" AcceptsReturn="True"
                                     Background="Transparent"
                                     VerticalScrollBarVisibility="Auto"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Дослідження — аккордеон -->
                <Border Background="White" BorderBrush="#E0DEDB"
                        BorderThickness="1" CornerRadius="8"
                        Margin="0,0,0,8">
                    <!-- Заголовок -->
                    <StackPanel>
                        <Button Click="ToggleResearch_Click" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="8,8,0,0"
                                                        Padding="20,14">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#F8F9FA"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Width="32" Height="32"
                                        CornerRadius="8"
                                        Background="#E6F1FB"
                                        Margin="0,0,12,0">
                                    <ui:SymbolIcon Symbol="Microscope24"
                                                   FontSize="16"
                                                   Foreground="#185FA5"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Дослідження"
                                               FontSize="14" FontWeight="Medium"
                                               Foreground="#2C2C2A"/>
                                    <TextBlock Text="Замовити або прив'язати існуюче дослідження"
                                               FontSize="11" Foreground="#888780"/>
                                </StackPanel>
                                <ui:SymbolIcon Grid.Column="2"
                                               FontSize="14"
                                               Foreground="#888780">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Setter Property="Symbol" Value="ChevronDown24"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsResearchExpanded}" Value="True">
                                                    <Setter Property="Symbol" Value="ChevronUp24"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                            </Grid>
                        </Button>

                        <!-- Контент дослідження -->
                        <Border Padding="20,0,20,16">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsResearchExpanded}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <Border BorderBrush="#E0DEDB" BorderThickness="0,1,0,0"
                                        Margin="0,0,0,16"/>

                                <!-- Замовити нове -->
                                <Border Background="#F8F9FA" CornerRadius="8"
                                        Padding="16" Margin="0,0,0,8">
                                    <StackPanel>
                                        <CheckBox IsChecked="{Binding OrderResearch}"
                                                  Cursor="Hand" Margin="0,0,0,10">
                                            <TextBlock Text="Замовити нове дослідження"
                                                       FontSize="13" FontWeight="Medium"
                                                       Foreground="#2C2C2A"/>
                                        </CheckBox>
                                        <StackPanel Visibility="{Binding OrderResearch,
                                                    Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="Тип дослідження"
                                                       FontSize="12" Foreground="#5F5E5A"
                                                       Margin="0,0,0,6"/>
                                            <ui:TextBox PlaceholderText="Наприклад: МРТ, УЗД, Аналіз крові..."
                                                        Text="{Binding ResearchType, UpdateSourceTrigger=PropertyChanged}"
                                                        FontSize="13"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Прив'язати існуюче -->
                                <Border Background="#F8F9FA" CornerRadius="8" Padding="16">
                                    <StackPanel>
                                        <CheckBox IsChecked="{Binding AttachResearch}"
                                                  Cursor="Hand" Margin="0,0,0,10">
                                            <TextBlock Text="Прив'язати існуюче дослідження"
                                                       FontSize="13" FontWeight="Medium"
                                                       Foreground="#2C2C2A"/>
                                        </CheckBox>
                                        <StackPanel Visibility="{Binding AttachResearch,
                                                    Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="Оберіть дослідження"
                                                       FontSize="12" Foreground="#5F5E5A"
                                                       Margin="0,0,0,6"/>
                                            <ComboBox ItemsSource="{Binding PendingResearches}"
                                                      SelectedItem="{Binding SelectedResearch}"
                                                      Height="36" FontSize="13"
                                                      BorderBrush="#D3D1C7">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding ResearchType}"
                                                                       FontSize="13" Foreground="#2C2C2A"
                                                                       Margin="0,0,8,0"/>
                                                            <TextBlock Text="{Binding CreatedAt, StringFormat=dd.MM.yyyy}"
                                                                       FontSize="12" Foreground="#888780"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Алергії — аккордеон -->
                <Border Background="White" BorderBrush="#E0DEDB"
                        BorderThickness="1" CornerRadius="8"
                        Margin="0,0,0,8">
                    <StackPanel>
                        <Button Click="ToggleAllergies_Click" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="8,8,0,0"
                                                        Padding="20,14">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#F8F9FA"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Width="32" Height="32"
                                        CornerRadius="8"
                                        Background="#FAEEDA"
                                        Margin="0,0,12,0">
                                    <ui:SymbolIcon Symbol="Warning24"
                                                   FontSize="16"
                                                   Foreground="#854F0B"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Нові алергії"
                                               FontSize="14" FontWeight="Medium"
                                               Foreground="#2C2C2A"/>
                                    <TextBlock Text="Додати нові алергії до медкарти"
                                               FontSize="11" Foreground="#888780"/>
                                </StackPanel>
                                <!-- Счётчик -->
                                <Border Grid.Column="2"
                                        Background="#E6F1FB"
                                        CornerRadius="10"
                                        Padding="8,2"
                                        Margin="0,0,10,0"
                                        Visibility="{Binding NewAllergies.Count,
                                                     Converter={StaticResource NullToVisibility}}">
                                    <TextBlock Text="{Binding NewAllergies.Count}"
                                               FontSize="12" Foreground="#185FA5"
                                               FontWeight="SemiBold"/>
                                </Border>
                                <ui:SymbolIcon Grid.Column="3"
                                               FontSize="14"
                                               Foreground="#888780">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Setter Property="Symbol" Value="ChevronDown24"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAllergiesExpanded}" Value="True">
                                                    <Setter Property="Symbol" Value="ChevronUp24"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                            </Grid>
                        </Button>

                        <Border Padding="20,0,20,16">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAllergiesExpanded}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <Border BorderBrush="#E0DEDB" BorderThickness="0,1,0,0"
                                        Margin="0,0,0,16"/>

                                <!-- Список -->
                                <ItemsControl ItemsSource="{Binding NewAllergies}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#F1EFE8"
                                                    BorderThickness="0,0,0,1" Padding="0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Name}"
                                                               FontSize="13" FontWeight="Medium"
                                                               Foreground="#2C2C2A"
                                                               VerticalAlignment="Center"/>
                                                    <Border Grid.Column="1"
                                                            Background="{Binding SeverityColor}"
                                                            CornerRadius="10" Padding="10,4"
                                                            Margin="0,0,8,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding SeverityDisplay}"
                                                                   FontSize="12"
                                                                   Foreground="{Binding SeverityTextColor}"/>
                                                    </Border>
                                                    <Button Grid.Column="2"
                                                            Command="{Binding DataContext.RemoveAllergyCommand,
                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Width="28" Height="28" Cursor="Hand">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Background" Value="White"/>
                                                                <Setter Property="Foreground" Value="#E24B4A"/>
                                                                <Setter Property="BorderBrush" Value="#FECACA"/>
                                                                <Setter Property="BorderThickness" Value="1"/>
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border Background="{TemplateBinding Background}"
                                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                                    CornerRadius="6">
                                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                                  VerticalAlignment="Center"/>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter Property="Background" Value="#FCEBEB"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </Button.Style>
                                                        <ui:SymbolIcon Symbol="Delete24" FontSize="13"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Форма добавления -->
                                <Border Background="#F8F9FA" CornerRadius="8"
                                        Padding="16" Margin="0,12,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Алерген" FontSize="11"
                                                       Foreground="#888780" Margin="0,0,0,4"/>
                                            <ComboBox ItemsSource="{Binding AvailableAllergens}"
                                                      SelectedItem="{Binding SelectedAllergen}"
                                                      DisplayMemberPath="Name"
                                                      TextSearch.TextPath="Name"
                                                      IsTextSearchEnabled="True"
                                                      IsEditable="True"
                                                      StaysOpenOnEdit="True"
                                                      Height="36" FontSize="13"
                                                      BorderBrush="#D3D1C7"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                            <TextBlock Text="Важкість" FontSize="11"
                                                       Foreground="#888780" Margin="0,0,0,4"/>
                                            <ComboBox ItemsSource="{Binding SeverityDisplayOptions}"
                                                      Height="36" FontSize="13"
                                                      BorderBrush="#D3D1C7"
                                                      SelectionChanged="AllergySeverity_SelectionChanged"/>
                                        </StackPanel>

                                        <Button Grid.Column="4"
                                                Command="{Binding AddAllergyCommand}"
                                                Height="36" Padding="14,0"
                                                Cursor="Hand" VerticalAlignment="Bottom">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="#185FA5"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center"
                                                                                      Margin="{TemplateBinding Padding}"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#1A6FB8"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Add24" FontSize="13" Margin="0,0,4,0"/>
                                                <TextBlock Text="Додати" FontSize="13"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Діагнози — аккордеон -->
                <Border Background="White" BorderBrush="#E0DEDB"
                        BorderThickness="1" CornerRadius="8"
                        Margin="0,0,0,8">
                    <StackPanel>
                        <Button Click="ToggleDiagnoses_Click" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="8,8,0,0"
                                                        Padding="20,14">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#F8F9FA"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Width="32" Height="32"
                                        CornerRadius="8"
                                        Background="#EAF3DE"
                                        Margin="0,0,12,0">
                                    <ui:SymbolIcon Symbol="HeartPulse24"
                                                   FontSize="16"
                                                   Foreground="#3B6D11"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Нові діагнози"
                                               FontSize="14" FontWeight="Medium"
                                               Foreground="#2C2C2A"/>
                                    <TextBlock Text="Додати нові діагнози до медкарти"
                                               FontSize="11" Foreground="#888780"/>
                                </StackPanel>
                                <Border Grid.Column="2"
                                        Background="#E6F1FB"
                                        CornerRadius="10" Padding="8,2"
                                        Margin="0,0,10,0"
                                        Visibility="{Binding NewDiagnoses.Count,
                                                     Converter={StaticResource NullToVisibility}}">
                                    <TextBlock Text="{Binding NewDiagnoses.Count}"
                                               FontSize="12" Foreground="#185FA5"
                                               FontWeight="SemiBold"/>
                                </Border>
                                <ui:SymbolIcon Grid.Column="3"
                                               FontSize="14"
                                               Foreground="#888780">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Setter Property="Symbol" Value="ChevronDown24"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDiagnosesExpanded}" Value="True">
                                                    <Setter Property="Symbol" Value="ChevronUp24"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                            </Grid>
                        </Button>

                        <Border Padding="20,0,20,16">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDiagnosesExpanded}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <Border BorderBrush="#E0DEDB" BorderThickness="0,1,0,0"
                                        Margin="0,0,0,16"/>

                                <ItemsControl ItemsSource="{Binding NewDiagnoses}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#F1EFE8"
                                                    BorderThickness="0,0,0,1" Padding="0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Background="#F1EFE8"
                                                            CornerRadius="4" Padding="6,3"
                                                            HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding IcdCode}"
                                                                   FontSize="12" Foreground="#5F5E5A"
                                                                   FontWeight="Medium"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                               FontSize="13" FontWeight="Medium"
                                                               Foreground="#2C2C2A"
                                                               VerticalAlignment="Center"
                                                               Margin="12,0"/>
                                                    <Border Grid.Column="2"
                                                            Background="{Binding StatusColor}"
                                                            CornerRadius="10" Padding="10,4"
                                                            Margin="0,0,8,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding StatusDisplay}"
                                                                   FontSize="12"
                                                                   Foreground="{Binding StatusTextColor}"/>
                                                    </Border>
                                                    <Button Grid.Column="3"
                                                            Command="{Binding DataContext.RemoveDiagnosisCommand,
                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Width="28" Height="28" Cursor="Hand">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Background" Value="White"/>
                                                                <Setter Property="Foreground" Value="#E24B4A"/>
                                                                <Setter Property="BorderBrush" Value="#FECACA"/>
                                                                <Setter Property="BorderThickness" Value="1"/>
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border Background="{TemplateBinding Background}"
                                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                                    CornerRadius="6">
                                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                                  VerticalAlignment="Center"/>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter Property="Background" Value="#FCEBEB"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </Button.Style>
                                                        <ui:SymbolIcon Symbol="Delete24" FontSize="13"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Background="#F8F9FA" CornerRadius="8"
                                        Padding="16" Margin="0,12,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Діагноз або код МКБ" FontSize="11"
                                                       Foreground="#888780" Margin="0,0,0,4"/>
                                            <ComboBox ItemsSource="{Binding AvailableDiseases}"
                                                      SelectedItem="{Binding SelectedDisease}"
                                                      DisplayMemberPath="Name"
                                                      TextSearch.TextPath="Name"
                                                      IsTextSearchEnabled="True"
                                                      IsEditable="True"
                                                      StaysOpenOnEdit="True"
                                                      Height="36" FontSize="13"
                                                      BorderBrush="#D3D1C7"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                            <TextBlock Text="Статус" FontSize="11"
                                                       Foreground="#888780" Margin="0,0,0,4"/>
                                            <ComboBox ItemsSource="{Binding DiseaseStatusDisplayOptions}"
                                                      Height="36" FontSize="13"
                                                      BorderBrush="#D3D1C7"
                                                      SelectionChanged="NewDiseaseStatus_SelectionChanged"/>
                                        </StackPanel>

                                        <Button Grid.Column="4"
                                                Command="{Binding AddDiseaseCommand}"
                                                Height="36" Padding="14,0"
                                                Cursor="Hand" VerticalAlignment="Bottom">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="#185FA5"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center"
                                                                                      Margin="{TemplateBinding Padding}"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#1A6FB8"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Add24" FontSize="13" Margin="0,0,4,0"/>
                                                <TextBlock Text="Додати" FontSize="13"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Боттомбар -->
        <Border Grid.Row="2" Background="White"
                BorderBrush="#E0DEDB" BorderThickness="0,1,0,0"
                Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                

                <ui:Button Grid.Column="1"
                           Click="CancelButton_Click"
                           Height="36" Padding="14,0"
                           Cursor="Hand" Margin="0,0,8,0"
                           Appearance="Secondary">
                    <TextBlock Text="Відмінити" FontSize="13"/>
                </ui:Button>

                <Button Grid.Column="2"
                        Command="{Binding SaveCommand}"
                        Height="36" Padding="14,0"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#185FA5"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Margin="{TemplateBinding Padding}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#1A6FB8"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background" Value="#0C447C"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Save24" FontSize="14" Margin="0,0,6,0"/>
                        <TextBlock Text="Зберегти запис" FontSize="13"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>