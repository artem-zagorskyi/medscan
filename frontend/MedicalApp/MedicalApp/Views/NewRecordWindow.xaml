<Window x:Class="MedicalApp.Views.NewRecordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Новий запис"
        Height="700" Width="820"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="White"
                BorderBrush="#E0DEDB" BorderThickness="0,0,0,1"
                Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StepTitle}"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="#2C2C2A"/>
                    <TextBlock FontSize="12" Foreground="#888780" Margin="0,2,0,0">
                        <Run Text="{Binding Patient.FullName}"/>
                        <Run Text="·"/>
                        <Run Text="{Binding Patient.AgeLabel, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>

                <!-- Індикатор кроку -->
                <!-- Індикатор кроку -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
            VerticalAlignment="Center">
                    <!-- Крок 1 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="14">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#185FA5"/>
                                </Style>
                            </Border.Style>
                            <ui:SymbolIcon Symbol="Folder24" FontSize="14" Foreground="White"/>
                        </Border>
                        <TextBlock Text="Кейс" FontSize="11" FontWeight="Medium"
                   Foreground="#185FA5" VerticalAlignment="Center"
                   Margin="6,0,0,0"/>
                    </StackPanel>

                    <!-- Лінія -->
                    <Border Height="2" Width="32" Margin="8,0" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#D3D1C7"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStep2}" Value="True">
                                        <Setter Property="Background" Value="#185FA5"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <!-- Крок 2 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="14">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#D3D1C7"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStep2}" Value="True">
                                            <Setter Property="Background" Value="#185FA5"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ui:SymbolIcon Symbol="ClipboardTextLtr24" FontSize="14">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Foreground" Value="#888780"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStep2}" Value="True">
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                        </Border>
                        <TextBlock Text="Запис" FontSize="11" FontWeight="Medium"
                   VerticalAlignment="Center" Margin="6,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#888780"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStep2}" Value="True">
                                            <Setter Property="Foreground" Value="#185FA5"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Контент -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20">

                <!-- Помилка -->
                <ui:InfoBar Title=""
                            Message="{Binding ErrorMessage}"
                            Severity="Error"
                            IsOpen="{Binding HasError}"
                            IsClosable="False"
                            Margin="0,0,0,16"/>

                <!-- ШАГ 1: Вибір кейсу -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStep1}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>


                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                    Text="Оберіть кейс для нового запису або створіть новий"
                                    FontSize="13" Foreground="#5F5E5A"
                                    VerticalAlignment="Center"/>
                                             <ui:Button Grid.Column="1"
                                    Click="NewCaseFromRecord_Click"
                                    Height="32" Padding="10,0"
                                    Cursor="Hand" Appearance="Secondary"
                                    Icon="{ui:SymbolIcon Add24}">
                            <TextBlock Text="Новий кейс" FontSize="12"/>
                        </ui:Button>
                    </Grid>

                    <!-- Список кейсів -->
                    <ItemsControl ItemsSource="{Binding Cases}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Click="SelectCase_Click"
                                        Tag="{Binding}"
                                        Margin="0,0,0,8"
                                        Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="White"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="BorderBrush" Value="#E0DEDB"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="8"
                                                                Padding="16,12">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#F0F7FF"/>
                                                                <Setter Property="BorderBrush" Value="#185FA5"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Width="36" Height="36"
                                                CornerRadius="8"
                                                Background="#EAF3DE"
                                                Margin="0,0,12,0">
                                            <ui:SymbolIcon Symbol="Folder24"
                                                           FontSize="18"
                                                           Foreground="#3B6D11"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding MainCondition}"
                                                       FontSize="14" FontWeight="Medium"
                                                       Foreground="#2C2C2A"/>
                                            <TextBlock FontSize="12" Foreground="#888780">
                                                <Run Text="Відкрито:"/>
                                                <Run Text="{Binding OpeningDateDisplay, Mode=OneWay}"/>
                                                <Run Text="·"/>
                                                <Run Text="{Binding RecordsCount}"/>
                                                <Run Text="записів"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <ui:SymbolIcon Grid.Column="2"
                                                       Symbol="ChevronRight24"
                                                       FontSize="14"
                                                       Foreground="#888780"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Немає відкритих кейсів -->
                    <Border Background="#F8F9FA" CornerRadius="8"
                            Padding="20" Margin="0,8,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Cases.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="FolderOpen24"
                                           FontSize="32"
                                           Foreground="#888780"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,8"/>
                            <TextBlock Text="Немає відкритих кейсів"
                                       FontSize="13" Foreground="#888780"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Створіть новий кейс щоб додати запис"
                                       FontSize="12" Foreground="#B4B2A9"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ШАГ 2: Форма запису -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStep2}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <!-- Тип запису -->
                    <Border Background="White" BorderBrush="#E0DEDB"
                            BorderThickness="1" CornerRadius="8"
                            Padding="16,12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Тип запису"
                                       FontSize="13" FontWeight="Medium"
                                       Foreground="#2C2C2A"
                                       VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding RecordTypeDisplayOptions}"
                                      Height="34" FontSize="13"
                                      BorderBrush="#D3D1C7"
                                      SelectionChanged="RecordType_SelectionChanged"/>
                        </Grid>
                    </Border>

                    <!-- Лікарі консиліуму — з'являється тільки при CONSILIUM -->
                    <Border Background="White" BorderBrush="#185FA5"
        BorderThickness="1" CornerRadius="8"
        Padding="20" Margin="0,0,0,12">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConsilium}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="ЛІКАРІ КОНСИЛІУМУ"
                   FontSize="11" FontWeight="SemiBold"
                   Foreground="#185FA5" Margin="0,0,0,12"/>
                            <ItemsControl ItemsSource="{Binding ConsiliumDoctors}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#F1EFE8" BorderThickness="0,0,0,1" Padding="0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FullName}"
                                           FontSize="13" FontWeight="Medium" Foreground="#2C2C2A"/>
                                                    <TextBlock Text="{Binding Specialization}"
                                           FontSize="11" Foreground="#888780"/>
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="#E6F1FB"
                                    CornerRadius="12" Padding="10,5" Margin="0,0,6,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Role}" FontSize="12" Foreground="#185FA5"/>
                                                </Border>

                                                
                                                <Button Grid.Column="2"
                                    Command="{Binding DataContext.RemoveConsiliumDoctorCommand,
                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Width="28" Height="28" Cursor="Hand">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Background" Value="White"/>
                                                            <Setter Property="BorderBrush" Value="#FECACA"/>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="6">
                                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter Property="Background" Value="#FCEBEB"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </Button.Style>
                                                    <ui:SymbolIcon Symbol="Delete24" FontSize="13"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Background="#F8F9FA" CornerRadius="8" Padding="16" Margin="0,12,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Лікар" FontSize="11" Foreground="#888780" Margin="0,0,0,4"/>
                                        <ComboBox ItemsSource="{Binding AvailableDoctors}"
                              SelectedItem="{Binding SelectedConsiliumDoctor}"
                              DisplayMemberPath="DisplayName"
                              Height="36" FontSize="13" BorderBrush="#D3D1C7"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                        <TextBlock Text="Роль" FontSize="11" Foreground="#888780" Margin="0,0,0,4"/>
                                        <ui:TextBox PlaceholderText="Консультант"
                                Text="{Binding ConsiliumDoctorRole, UpdateSourceTrigger=PropertyChanged}"
                                FontSize="13" Height="36"/>
                                    </StackPanel>
                                    <Button Grid.Column="4"
                        Command="{Binding AddConsiliumDoctorCommand}"
                        Height="36" Padding="14,0"
                        Cursor="Hand" VerticalAlignment="Bottom">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#185FA5"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Margin="{TemplateBinding Padding}"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#1A6FB8"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Add24" FontSize="13" Margin="0,0,4,0"/>
                                            <TextBlock Text="Додати" FontSize="13"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Основні поля -->
                    <Border Background="White" BorderBrush="#E0DEDB"
                            BorderThickness="1" CornerRadius="8"
                            Padding="20" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="ІНФОРМАЦІЯ ПРО ВІЗИТ"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="#888780" Margin="0,0,0,16"/>

                            <TextBlock Text="Скарги пацієнта"
                                       FontSize="12" FontWeight="Medium"
                                       Foreground="#5F5E5A" Margin="0,0,0,6"/>
                            <Border BorderBrush="#E0DEDB" BorderThickness="1"
                                    CornerRadius="6" Margin="0,0,0,14">
                                <TextBox Text="{Binding Complaints, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0" FontSize="13"
                                         Padding="12,10" MinHeight="80"
                                         TextWrapping="Wrap" AcceptsReturn="True"
                                         Background="Transparent"
                                         VerticalScrollBarVisibility="Auto"/>
                            </Border>

                            <TextBlock Text="Висновок лікаря"
                                       FontSize="12" FontWeight="Medium"
                                       Foreground="#5F5E5A" Margin="0,0,0,6"/>
                            <Border BorderBrush="#E0DEDB" BorderThickness="1"
                                    CornerRadius="6" Margin="0,0,0,14">
                                <TextBox Text="{Binding DoctorConclusion, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0" FontSize="13"
                                         Padding="12,10" MinHeight="80"
                                         TextWrapping="Wrap" AcceptsReturn="True"
                                         Background="Transparent"
                                         VerticalScrollBarVisibility="Auto"/>
                            </Border>

                            <TextBlock Text="План лікування"
                                       FontSize="12" FontWeight="Medium"
                                       Foreground="#5F5E5A" Margin="0,0,0,6"/>
                            <Border BorderBrush="#E0DEDB" BorderThickness="1" CornerRadius="6">
                                <TextBox Text="{Binding TreatmentPlan, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0" FontSize="13"
                                         Padding="12,10" MinHeight="60"
                                         TextWrapping="Wrap" AcceptsReturn="True"
                                         Background="Transparent"
                                         VerticalScrollBarVisibility="Auto"/>
                            </Border>
                            <!-- Медикаменти — акордеон -->
                            <Border Background="White" BorderBrush="#E0DEDB"
        BorderThickness="1" CornerRadius="8" Margin="0,16,0,8">
                                <StackPanel>
                                    <Button Click="ToggleMedications_Click" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                        CornerRadius="8" Padding="20,14">
                                                                <ContentPresenter/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#F8F9FA"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="32" Height="32"
                        CornerRadius="8" Background="#E6F1FB" Margin="0,0,12,0">
                                                <ui:SymbolIcon Symbol="Pill24" FontSize="16" Foreground="#185FA5"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Медикаменти" FontSize="14" FontWeight="Medium" Foreground="#2C2C2A"/>
                                                <TextBlock Text="Призначені препарати з дозуванням" FontSize="11" Foreground="#888780"/>
                                            </StackPanel>
                                            
                                            <Border Grid.Column="2" Background="#E6F1FB"
                                                CornerRadius="12" Padding="8,4" Margin="0,0,10,0" VerticalAlignment="Center"
                                                    Visibility="{Binding NewMedications.Count, Converter={StaticResource NullToVisibility}}">
                                                <TextBlock Text="{Binding NewMedications.Count}"
                               FontSize="12" Foreground="#185FA5" FontWeight="SemiBold"/>
                                            </Border>
                                            <ui:SymbolIcon Grid.Column="3" FontSize="14" Foreground="#888780">
                                                <ui:SymbolIcon.Style>
                                                    <Style TargetType="ui:SymbolIcon">
                                                        <Setter Property="Symbol" Value="ChevronDown24"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMedicationsExpanded}" Value="True">
                                                                <Setter Property="Symbol" Value="ChevronUp24"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:SymbolIcon.Style>
                                            </ui:SymbolIcon>
                                        </Grid>
                                    </Button>
                                    <Border Padding="20,0,20,16">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMedicationsExpanded}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <Border BorderBrush="#E0DEDB" BorderThickness="0,1,0,0" Margin="0,0,0,16"/>
                                            <ItemsControl ItemsSource="{Binding NewMedications}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="#F1EFE8" BorderThickness="0,0,0,1" Padding="0,8">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Name}"
                                                   FontSize="13" FontWeight="Medium" Foreground="#2C2C2A"/>
                                                                    <TextBlock Text="{Binding Summary}"
                                                   FontSize="11" Foreground="#888780"/>
                                                                </StackPanel>
                                                                <Button Grid.Column="2"
                                            Command="{Binding DataContext.RemoveMedicationCommand,
                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Width="28" Height="28" Cursor="Hand">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button">
                                                                            <Setter Property="Background" Value="White"/>
                                                                            <Setter Property="BorderBrush" Value="#FECACA"/>
                                                                            <Setter Property="BorderThickness" Value="1"/>
                                                                            <Setter Property="Template">
                                                                                <Setter.Value>
                                                                                    <ControlTemplate TargetType="Button">
                                                                                        <Border Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                    CornerRadius="6">
                                                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"/>
                                                                                        </Border>
                                                                                        <ControlTemplate.Triggers>
                                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                                <Setter Property="Background" Value="#FCEBEB"/>
                                                                                            </Trigger>
                                                                                        </ControlTemplate.Triggers>
                                                                                    </ControlTemplate>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                        </Style>
                                                                    </Button.Style>
                                                                    <ui:SymbolIcon Symbol="Delete24" FontSize="13"/>
                                                                </Button>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <!-- Форма додавання медикаменту -->
                                            <Border Background="#F8F9FA" CornerRadius="8" Padding="16" Margin="0,12,0,0">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="12"/>
                                                            <ColumnDefinition Width="120"/>
                                                            <ColumnDefinition Width="12"/>
                                                            <ColumnDefinition Width="120"/>
                                                            <ColumnDefinition Width="12"/>
                                                            <ColumnDefinition Width="100"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="Медикамент" FontSize="11"
                                           Foreground="#888780" Margin="0,0,0,4"/>
                                                            <ComboBox ItemsSource="{Binding AvailableMedications}"
                                          SelectedItem="{Binding SelectedMedication}"
                                          DisplayMemberPath="DisplayName"
                                          TextSearch.TextPath="DisplayName"
                                          IsTextSearchEnabled="True"
                                          IsEditable="True"
                                          StaysOpenOnEdit="True"
                                          Height="36" FontSize="13" BorderBrush="#D3D1C7"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
