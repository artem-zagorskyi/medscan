<Window x:Class="MedicalApp.Views.NewRecordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новий запис"
        Height="700" Width="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#D3D1C7"
                BorderThickness="0,0,0,1"
                Padding="24,14">
            <StackPanel>
                <TextBlock Text="Новий запис"
                           FontSize="16"
                           FontWeight="Medium"
                           Foreground="#2C2C2A"/>
                <TextBlock Text="{Binding Patient.FullName}"
                           FontSize="12"
                           Foreground="#888780"/>
            </StackPanel>
        </Border>

        <!-- Контент -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20">

                <!-- Помилка -->
                <Border Background="#FCEBEB"
                        BorderBrush="#F09595"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,12"
                        Margin="0,0,0,16"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#A32D2D"
                               FontSize="13"/>
                </Border>

                <!-- Основна інформація -->
                <Border Background="White"
                        BorderBrush="#D3D1C7"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="ЗАПИС ВІЗИТУ"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   Foreground="#888780"
                                   Margin="0,0,0,16"/>

                        <TextBlock Text="Скарги пацієнта"
                                   FontSize="12"
                                   Foreground="#5F5E5A"
                                   Margin="0,0,0,6"/>
                        <Border BorderBrush="#D3D1C7"
                                BorderThickness="1"
                                CornerRadius="6"
                                Margin="0,0,0,14">
                            <TextBox Text="{Binding Complaints, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0"
                                     FontSize="13"
                                     Padding="10,8"
                                     MinHeight="80"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     Background="Transparent"
                                     VerticalScrollBarVisibility="Auto"/>
                        </Border>

                        <TextBlock Text="Висновок лікаря"
                                   FontSize="12"
                                   Foreground="#5F5E5A"
                                   Margin="0,0,0,6"/>
                        <Border BorderBrush="#D3D1C7"
                                BorderThickness="1"
                                CornerRadius="6"
                                Margin="0,0,0,14">
                            <TextBox Text="{Binding DoctorConclusion, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0"
                                     FontSize="13"
                                     Padding="10,8"
                                     MinHeight="80"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     Background="Transparent"
                                     VerticalScrollBarVisibility="Auto"/>
                        </Border>

                        <TextBlock Text="План лікування"
                                   FontSize="12"
                                   Foreground="#5F5E5A"
                                   Margin="0,0,0,6"/>
                        <Border BorderBrush="#D3D1C7"
                                BorderThickness="1"
                                CornerRadius="6">
                            <TextBox Text="{Binding TreatmentPlan, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0"
                                     FontSize="13"
                                     Padding="10,8"
                                     MinHeight="60"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     Background="Transparent"
                                     VerticalScrollBarVisibility="Auto"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Дослідження -->
                <Border Background="White"
                        BorderBrush="#D3D1C7"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="ДОСЛІДЖЕННЯ"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   Foreground="#888780"
                                   Margin="0,0,0,16"/>

                        <Border Background="#F5F5F5"
                                CornerRadius="8"
                                Padding="16"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <CheckBox IsChecked="{Binding OrderResearch}"
                                          Cursor="Hand"
                                          Margin="0,0,0,10">
                                    <TextBlock Text="Замовити нове дослідження"
                                               FontSize="13"
                                               FontWeight="Medium"
                                               Foreground="#2C2C2A"/>
                                </CheckBox>

                                <StackPanel Visibility="{Binding OrderResearch,
                                            Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Тип дослідження"
                                               FontSize="12"
                                               Foreground="#5F5E5A"
                                               Margin="0,0,0,6"/>
                                    <Border BorderBrush="#D3D1C7"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Height="38"
                                            Padding="10,0">
                                        <TextBox Text="{Binding ResearchType, UpdateSourceTrigger=PropertyChanged}"
                                                 BorderThickness="0"
                                                 FontSize="13"
                                                 VerticalAlignment="Center"
                                                 Background="Transparent">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="TextBox">
                                                                <ScrollViewer x:Name="PART_ContentHost"/>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="#F5F5F5"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel>
                                <CheckBox IsChecked="{Binding AttachResearch}"
                                          Cursor="Hand"
                                          Margin="0,0,0,10">
                                    <TextBlock Text="Прив'язати існуюче дослідження"
                                               FontSize="13"
                                               FontWeight="Medium"
                                               Foreground="#2C2C2A"/>
                                </CheckBox>

                                <StackPanel Visibility="{Binding AttachResearch,
                                            Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Оберіть дослідження"
                                               FontSize="12"
                                               Foreground="#5F5E5A"
                                               Margin="0,0,0,6"/>
                                    <ComboBox ItemsSource="{Binding PendingResearches}"
                                              SelectedItem="{Binding SelectedResearch}"
                                              Height="38"
                                              FontSize="13"
                                              BorderBrush="#D3D1C7">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding ResearchType}"
                                                               FontSize="13"
                                                               Foreground="#2C2C2A"
                                                               Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding CreatedAt, StringFormat=dd.MM.yyyy}"
                                                               FontSize="12"
                                                               Foreground="#888780"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Алергії -->
                <Border Background="White"
                        BorderBrush="#D3D1C7"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="НОВІ АЛЕРГІЇ"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   Foreground="#888780"
                                   Margin="0,0,0,14"/>

                        <ItemsControl ItemsSource="{Binding NewAllergies}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#F1EFE8"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Name}"
                                                       FontSize="13"
                                                       FontWeight="Medium"
                                                       Foreground="#2C2C2A"
                                                       VerticalAlignment="Center"/>
                                            <Border Grid.Column="1"
                                                    Background="{Binding SeverityColor}"
                                                    CornerRadius="10"
                                                    Padding="10,4"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SeverityDisplay}"
                                                           FontSize="12"
                                                           Foreground="{Binding SeverityTextColor}"/>
                                            </Border>
                                            <Button Grid.Column="2"
                                                    Content="✕"
                                                    Command="{Binding DataContext.RemoveAllergyCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Width="28" Height="28"
                                                    Cursor="Hand">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="White"/>
                                                        <Setter Property="Foreground" Value="#E24B4A"/>
                                                        <Setter Property="BorderBrush" Value="#F09595"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}"
                                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                                            CornerRadius="6">
                                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                                          VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="#FCEBEB"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Background="#F5F5F5"
                                CornerRadius="8"
                                Padding="16"
                                Margin="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <Border BorderBrush="#D3D1C7"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Height="36"
                                            Padding="10,0"
                                            Margin="0,0,0,6">
                                        <TextBox Text="{Binding AllergenSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 BorderThickness="0"
                                                 FontSize="13"
                                                 VerticalAlignment="Center"
                                                 Background="Transparent">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="TextBox">
                                                                <ScrollViewer x:Name="PART_ContentHost"/>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </Border>
                                    <ComboBox ItemsSource="{Binding AvailableAllergens}"
                                              SelectedItem="{Binding SelectedAllergen}"
                                              DisplayMemberPath="Name"
                                              Height="36"
                                              FontSize="13"
                                              BorderBrush="#D3D1C7"/>
                                </StackPanel>

                                <ComboBox Grid.Column="2"
                                          ItemsSource="{Binding SeverityDisplayOptions}"
                                          Height="36"
                                          FontSize="13"
                                          BorderBrush="#D3D1C7"
                                          VerticalAlignment="Bottom"
                                          SelectionChanged="AllergySeverity_SelectionChanged"/>

                                <Button Grid.Column="4"
                                        Content="+ Додати"
                                        Command="{Binding AddAllergyCommand}"
                                        Height="36"
                                        Padding="14,0"
                                        Cursor="Hand"
                                        VerticalAlignment="Bottom">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#185FA5"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="FontSize" Value="13"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                CornerRadius="6">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"
                                                                              Margin="{TemplateBinding Padding}"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#0C447C"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Діагнози -->
                <Border Background="White"
                        BorderBrush="#D3D1C7"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20">
                    <StackPanel>
                        <TextBlock Text="НОВІ ДІАГНОЗИ"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   Foreground="#888780"
                                   Margin="0,0,0,14"/>

                        <ItemsControl ItemsSource="{Binding NewDiagnoses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#F1EFE8"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0"
                                                    Background="#F1EFE8"
                                                    CornerRadius="4"
                                                    Padding="6,3"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding IcdCode}"
                                                           FontSize="12"
                                                           Foreground="#5F5E5A"
                                                           FontWeight="Medium"/>
                                            </Border>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Name}"
                                                       FontSize="13"
                                                       FontWeight="Medium"
                                                       Foreground="#2C2C2A"
                                                       VerticalAlignment="Center"
                                                       Margin="12,0"/>
                                            <Border Grid.Column="2"
                                                    Background="{Binding StatusColor}"
                                                    CornerRadius="10"
                                                    Padding="10,4"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StatusDisplay}"
                                                           FontSize="12"
                                                           Foreground="{Binding StatusTextColor}"/>
                                            </Border>
                                            <Button Grid.Column="3"
                                                    Content="✕"
                                                    Command="{Binding DataContext.RemoveDiagnosisCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Width="28" Height="28"
                                                    Cursor="Hand">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="White"/>
                                                        <Setter Property="Foreground" Value="#E24B4A"/>
                                                        <Setter Property="BorderBrush" Value="#F09595"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}"
                                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                                            CornerRadius="6">
                                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                                          VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="#FCEBEB"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Background="#F5F5F5"
                                CornerRadius="8"
                                Padding="16"
                                Margin="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <Border BorderBrush="#D3D1C7"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Height="36"
                                            Padding="10,0"
                                            Margin="0,0,0,6">
                                        <TextBox Text="{Binding DiseaseSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 BorderThickness="0"
                                                 FontSize="13"
                                                 VerticalAlignment="Center"
                                                 Background="Transparent">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="TextBox">
                                                                <ScrollViewer x:Name="PART_ContentHost"/>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </Border>
                                    <ComboBox ItemsSource="{Binding AvailableDiseases}"
                                              SelectedItem="{Binding SelectedDisease}"
                                              DisplayMemberPath="Name"
                                              Height="36"
                                              FontSize="13"
                                              BorderBrush="#D3D1C7"/>
                                </StackPanel>

                                <ComboBox Grid.Column="2"
                                          ItemsSource="{Binding DiseaseStatusDisplayOptions}"
                                          Height="36"
                                          FontSize="13"
                                          BorderBrush="#D3D1C7"
                                          VerticalAlignment="Bottom"
                                          SelectionChanged="NewDiseaseStatus_SelectionChanged"/>

                                <Button Grid.Column="4"
                                        Content="+ Додати"
                                        Command="{Binding AddDiseaseCommand}"
                                        Height="36"
                                        Padding="14,0"
                                        Cursor="Hand"
                                        VerticalAlignment="Bottom">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#185FA5"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="FontSize" Value="13"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                CornerRadius="6">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"
                                                                              Margin="{TemplateBinding Padding}"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#0C447C"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Боттомбар -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#D3D1C7"
                BorderThickness="0,1,0,0"
                Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Тип запису визначається автоматично"
                           FontSize="12"
                           Foreground="#888780"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                        Content="Відмінити"
                        Click="CancelButton_Click"
                        Height="36"
                        Padding="14,0"
                        Cursor="Hand"
                        Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="Foreground" Value="#5F5E5A"/>
                            <Setter Property="BorderBrush" Value="#D3D1C7"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Margin="{TemplateBinding Padding}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#F1EFE8"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Grid.Column="2"
                        Content="💾 Зберегти"
                        Command="{Binding SaveCommand}"
                        Height="36"
                        Padding="14,0"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#185FA5"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Margin="{TemplateBinding Padding}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#0C447C"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>