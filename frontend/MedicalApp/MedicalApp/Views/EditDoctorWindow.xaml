<Window x:Class="MedicalApp.Views.EditDoctorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Редагувати лікаря"
        Height="420" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F5F5">
    


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="White"
                BorderBrush="#E0DEDB" BorderThickness="0,0,0,1"
                Padding="24,16">
            <StackPanel>
                <TextBlock Text="Редагувати лікаря"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="#2C2C2A"/>
                <TextBlock Text="{Binding DoctorName}"
                           FontSize="12" Foreground="#888780"
                           Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Контент -->
        <StackPanel Grid.Row="1" Margin="24,20">

            <ui:InfoBar Title=""
                        Message="{Binding ErrorMessage}"
                        Severity="Error"
                        IsOpen="{Binding HasError}"
                        IsClosable="False"
                        Margin="0,0,0,16"/>

            <Border Background="White" BorderBrush="#E0DEDB"
                    BorderThickness="1" CornerRadius="8"
                    Padding="20">
                <StackPanel>
                    <TextBlock Text="ДАНІ ЛІКАРЯ"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="#888780" Margin="0,0,0,16"/>

                    <TextBlock Text="Спеціалізація" FontSize="12" FontWeight="Medium"
                               Foreground="#5F5E5A" Margin="0,0,0,6"/>
                    <ui:TextBox PlaceholderText="Кардіологія, Терапія..."
                                Text="{Binding Specialization, UpdateSourceTrigger=PropertyChanged}"
                                FontSize="13" Margin="0,0,0,16"/>

                    <TextBlock Text="Контактна інформація" FontSize="12" FontWeight="Medium"
                               Foreground="#5F5E5A" Margin="0,0,0,6"/>
                    <ui:TextBox PlaceholderText="+380671234567"
                                Text="{Binding ContactInfo, UpdateSourceTrigger=PropertyChanged}"
                                FontSize="13"
                                Icon="{ui:SymbolIcon Phone24}"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Боттомбар -->
        <Border Grid.Row="2" Background="White"
                BorderBrush="#E0DEDB" BorderThickness="0,1,0,0"
                Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ui:Button Grid.Column="1"
                           Click="CancelButton_Click"
                           Height="36" Padding="14,0"
                           Cursor="Hand" Margin="0,0,8,0"
                           Appearance="Secondary"
                           Icon="{ui:SymbolIcon Dismiss24}">
                    <TextBlock Text="Відмінити" FontSize="13"/>
                </ui:Button>

                <ui:Button Grid.Column="2"
                    Command="{Binding SaveCommand}"
                    Height="36" Padding="14,0"
                    Cursor="Hand"
                    Background="#185FA5"
                    Foreground="White"
                    MouseOverBackground="#1A6FB8"
                    PressedBackground="#0C447C"
                    Icon="{ui:SymbolIcon Save24}">
                    <TextBlock Text="Зберегти" FontSize="13"/>
                </ui:Button>
            </Grid>
        </Border>
    </Grid>
</Window>