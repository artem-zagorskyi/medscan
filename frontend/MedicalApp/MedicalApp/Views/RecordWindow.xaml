<Window x:Class="MedicalApp.Views.RecordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{Binding WindowTitle, Mode=OneWay}"
        Height="700" Width="820"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="White"
                BorderBrush="#E0DEDB" BorderThickness="0,0,0,1"
                Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding TypeDisplay, Mode=OneWay}"
                                   FontSize="16" FontWeight="SemiBold" Foreground="#2C2C2A"/>
                        <Border Background="#FDEBD0" CornerRadius="8"
                                Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDraft}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="Чернетка" FontSize="12" Foreground="#C0552A"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding HeaderSubtitle, Mode=OneWay}"
                               FontSize="12" Foreground="#888780" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Кнопка редагування — тільки для чернеток в режимі перегляду -->
                <ui:Button Grid.Column="1"
                           Command="{Binding SwitchToEditCommand}"
                           Height="36" Padding="14,0"
                           Cursor="Hand"
                           Appearance="Primary"
                           Icon="{ui:SymbolIcon Edit24}">
                    <ui:Button.Style>
                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsDraft}" Value="True"/>
                                        <Condition Binding="{Binding IsViewMode}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                    <TextBlock Text="Редагувати" FontSize="13"/>
                </ui:Button>
            </Grid>
        </Border>

        <!-- Контент -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20">

                <ui:InfoBar Title="" Message="{Binding ErrorMessage}"
                            Severity="Error" IsOpen="{Binding HasError}"
                            IsClosable="False" Margin="0,0,0,16"/>

                <!-- ===== РЕЖИМ ПЕРЕГЛЯДУ ===== -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsViewMode}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <!-- Основна інфо -->
                    <Border Background="White" BorderBrush="#E0DEDB"
                BorderThickness="1" CornerRadius="8"
                Padding="20" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="ЗАГАЛЬНА ІНФОРМАЦІЯ"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="#888780" Margin="0,0,0,14"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="ТИП" FontSize="10" Foreground="#888780" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding TypeDisplay, Mode=OneWay}" FontSize="13"
                                   Foreground="#2C2C2A" FontWeight="Medium"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="ЛІКАР" FontSize="10" Foreground="#888780" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding DoctorName, Mode=OneWay}" FontSize="13"
                                   Foreground="#2C2C2A" FontWeight="Medium"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="СПЕЦІАЛІЗАЦІЯ" FontSize="10" Foreground="#888780" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding Specialization, Mode=OneWay}" FontSize="13"
                                   Foreground="#2C2C2A" FontWeight="Medium"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Консиліум -->
                    <Border Background="White" BorderBrush="#E0DEDB"
                BorderThickness="1" CornerRadius="8"
                Padding="20" Margin="0,0,0,12"
                Visibility="{Binding HasConsiliumDoctors, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="ЛІКАРІ КОНСИЛІУМУ" FontSize="11" FontWeight="SemiBold"
           Foreground="#888780" Margin="0,0,0,14"/>
                            <ItemsControl ItemsSource="{Binding ConsiliumDoctors}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#F1EFE8" BorderThickness="0,0,0,1" Padding="0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Doctor.Person.FullName, Mode=OneWay}"
                                   FontSize="13" FontWeight="Medium" Foreground="#2C2C2A"/>
                                                    <TextBlock Text="{Binding Doctor.Specialization, Mode=OneWay}"
                                   FontSize="11" Foreground="#888780"/>
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="#E6F1FB"
                            CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Role, Mode=OneWay}"
                                   FontSize="12" Foreground="#185FA5"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Скарги -->
                    <Border Background="White" BorderBrush="#E0DEDB"
                BorderThickness="1" CornerRadius="8"
                Padding="20" Margin="0,0,0,12"
                Visibility="{Binding Complaints, Converter={StaticResource NullToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="СКАРГИ" FontSize="11" FontWeight="SemiBold"
                           Foreground="#888780" Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding Complaints, Mode=OneWay}" FontSize="13"
                           Foreground="#2C2C2A" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Анамнез -->
                    <Border Background="White" BorderBrush="#E0DEDB"
                BorderThickness="1" CornerRadius="8"
                Padding="20" Margin="0,0,0,12"
                Visibility="{Binding HasAnamnesis, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="АНАМНЕЗ" FontSize="11" FontWeight="SemiBold"
                           Foreground="#888780" Margin="0,0,0,14"/>
                            <StackPanel Visibility="{Binding HistoryOfIllness, Converter={StaticResource NullToVisibility}}"
                            Margin="0,0,0,12">
                                <TextBlock Text="Анамнез хвороби" FontSize="12" FontWeight="Medium"
                               Foreground="#5F5E5A" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding HistoryOfIllness, Mode=OneWay}" FontSize="13"
                               Foreground="#2C2C2A" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding HistoryOfLife, Converter={StaticResource NullToVisibility}}"
                            Margin="0,0,0,12">
                                <TextBlock Text="Анамнез життя" FontSize="12" FontWeight="Medium"
                               Foreground="#5F5E5A" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding HistoryOfLife, Mode=OneWay}" FontSize="13"
                               Foreground="#2C2C2A" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding SocialHabits, Converter={StaticResource NullToVisibility}}">
                                <TextBlock Text="Соціальні звички" FontSize="12" FontWeight="Medium"
                               Foreground="#5F5E5A" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding SocialHabits, Mode=OneWay}" FontSize="13"
                               Foreground="#2C2C2A" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Вітальні показники -->
                    <Border Background="White" BorderBrush="#E0DEDB"
                BorderThickness="1" CornerRadius="8"
                Padding="20" Margin="0,0,0,12"
                Visibility="{Binding HasVitals, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="ВІТАЛЬНІ ПОКАЗНИКИ" FontSize="11" FontWeight="SemiBold"
                           Foreground="#888780" Margin="0,0,0,14"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"
                                Visibility="{Binding Temperature, Converter={StaticResource NullToVisibility}}">
                                    <TextBlock Text="ТЕМПЕРАТУРА" FontSize="10" Foreground="#888780" Margin="0,0,0,3"/>
                                    <TextBlock FontSize="13" Foreground="#2C2C2A" FontWeight="Medium">
                            <Run Text="{Binding Temperature}"/>
                            <Run Text="°C"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                Visibility="{Binding BloodPressure, Converter={StaticResource NullToVisibility}}">
                                    <TextBlock Text="ТИСК" FontSize="10" Foreground="#888780" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding BloodPressure, Mode=OneWay}" FontSize="13"
                                   Foreground="#2C2C2A" FontWeight="Medium"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2"
                                Visibility="{Binding HeartRate, Converter={StaticResource NullToVisibility}}">
                                    <TextBlock Text="ПУЛЬС" FontSize="10" Foreground="#888780" Margin="0,0,0,3"/>
                                    <TextBlock FontSize="13" Foreground="#2C2C2A" FontWeight="Medium">
                            <Run Text="{Binding HeartRate}"/>
                            <Run Text="уд/хв"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="3"
                                Visibility="{Binding Spo2, Converter={StaticResource NullToVisibility}}">
                                    <TextBlock Text="SPO2" FontSize="10" Foreground="#888780" Margin="0,0,0,3"/>
                                    <TextBlock FontSize="13" Foreground="#2C2C2A" FontWeight="Medium">
                            <Run Text="{Binding Spo2}"/>
                            <Run Text="%"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="4"
                                Visibility="{Binding Weight, Converter={StaticResource NullToVisibility}}">
                                    <TextBlock Text="ВАГА" FontSize="10" Foreground="#888780" Margin="0,0,0,3"/>
                                    <TextBlock FontSize="13" Foreground="#2C2C2A" FontWeight="Medium">
                            <Run Text="{Binding Weight}"/>
                            <Run Text="кг"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="5"
                                Visibility="{Binding Height, Converter={StaticResource NullToVisibility}}">
                                    <TextBlock Text="ЗРІСТ" FontSize="10" Foreground="#888780" Margin="0,0,0,3"/>
                                    <TextBlock FontSize="13" Foreground="#2C2C2A" FontWeight="Medium">
                            <Run Text="{Binding Height}"/>
                            <Run Text="см"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Об'єктивний статус -->
                    <Border Background="White" BorderBrush="#E0DEDB"
                BorderThickness="1" CornerRadius="8"
                Padding="20" Margin="0,0,0,12"
                Visibility="{Binding HasExamStatus, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="ОБ'ЄКТИВНИЙ СТАТУС" FontSize="11" FontWeight="SemiBold"
                           Foreground="#888780" Margin="0,0,0,14"/>
                            <StackPanel Visibility="{Binding GeneralCondition, Converter={StaticResource NullToVisibility}}"
                            Margin="0,0,0,12">
                                <TextBlock Text="Загальний стан" FontSize="12" FontWeight="Medium"
                               Foreground="#5F5E5A" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding GeneralCondition, Mode=OneWay}" FontSize="13"
                               Foreground="#2C2C2A" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding SkinStatus, Converter={StaticResource NullToVisibility}}"
                            Margin="0,0,0,12">
                                <TextBlock Text="Стан шкіри" FontSize="12" FontWeight="Medium"
                               Foreground="#5F5E5A" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding SkinStatus, Mode=OneWay}" FontSize="13"
                               Foreground="#2C2C2A" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding RespiratorySystem, Converter={StaticResource NullToVisibility}}"
                            Margin="0,0,0,12">
                                <TextBlock Text="Дихальна система" FontSize="12" FontWeight="Medium"
                               Foreground="#5F5E5A" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding RespiratorySystem, Mode=OneWay}" FontSize="13"
                               Foreground="#2C2C2A" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding Cardiovascular, Converter={StaticResource NullToVisibility}}">
                                <TextBlock Text="Серцево-судинна система" FontSize="12" FontWeight="Medium"
                               Foreground="#5F5E5A" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding Cardiovascular, Mode=OneWay}" FontSize="13"
                               Foreground="#2C2C2A" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Висновок та план -->
                    <Border Background="White" BorderBrush="#E0DEDB"
                BorderThickness="1" CornerRadius="8"
                Padding="20" Margin="0,0,0,12"
                Visibility="{Binding HasConclusion, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="ВИСНОВОК ТА ПЛАН ЛІКУВАННЯ" FontSize="11" FontWeight="SemiBold"
                           Foreground="#888780" Margin="0,0,0,14"/>
                            <StackPanel Visibility="{Binding DoctorConclusion, Converter={StaticResource NullToVisibility}}"
                            Margin="0,0,0,12">
                                <TextBlock Text="Висновок лікаря" FontSize="12" FontWeight="Medium"
                               Foreground="#5F5E5A" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding DoctorConclusion, Mode=OneWay}" FontSize="13"
                               Foreground="#2C2C2A" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding TreatmentPlan, Converter={StaticResource NullToVisibility}}">
                                <TextBlock Text="План лікування" FontSize="12" FontWeight="Medium"
                               Foreground="#5F5E5A" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding TreatmentPlan, Mode=OneWay}" FontSize="13"
                               Foreground="#2C2C2A" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Медикаменти -->
                    <Border Background="White" BorderBrush="#E0DEDB"
BorderThickness="1" CornerRadius="8"
Padding="20" Margin="0,0,0,12"
Visibility="{Binding HasMedications, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="МЕДИКАМЕНТИ" FontSize="11" FontWeight="SemiBold"
           Foreground="#888780" Margin="0,0,0,14"/>
                            <ItemsControl ItemsSource="{Binding Medications}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#F1EFE8" BorderThickness="0,0,0,1" Padding="0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Medication.Name, Mode=OneWay}"
                                   FontSize="13" FontWeight="Medium" Foreground="#2C2C2A"/>
                                                    <TextBlock Text="{Binding Medication.Form, Mode=OneWay}"
                                   FontSize="11" Foreground="#888780"
                                   Visibility="{Binding Medication.Form, Converter={StaticResource NullToVisibility}}"/>
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="#E6F1FB"
                            CornerRadius="8" Padding="8,3" Margin="8,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Dosage, Mode=OneWay}"
                                   FontSize="12" Foreground="#185FA5"
                                   Visibility="{Binding Dosage, Converter={StaticResource NullToVisibility}}"/>
                                                </Border>
                                                <TextBlock Grid.Column="2" Text="{Binding Frequency, Mode=OneWay}"
                               FontSize="12" Foreground="#888780"
                               VerticalAlignment="Center" Margin="0,0,12,0"
                               Visibility="{Binding Frequency, Converter={StaticResource NullToVisibility}}"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Duration, Mode=OneWay}"
                               FontSize="12" Foreground="#888780"
                               VerticalAlignment="Center"
                               Visibility="{Binding Duration, Converter={StaticResource NullToVisibility}}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Діагнози -->
                    <Border Background="White" BorderBrush="#E0DEDB"
                BorderThickness="1" CornerRadius="8"
                Padding="20" Margin="0,0,0,12"
                Visibility="{Binding HasDiagnoses, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="ДІАГНОЗИ" FontSize="11" FontWeight="SemiBold"
                           Foreground="#888780" Margin="0,0,0,14"/>
                            <ItemsControl ItemsSource="{Binding Diagnoses}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#F1EFE8" BorderThickness="0,0,0,1" Padding="0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="#F1EFE8"
                                            CornerRadius="4" Padding="6,3"
                                            HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Disease.IcdCode, Mode=OneWay}"
                                                   FontSize="12" Foreground="#5F5E5A" FontWeight="Medium"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Disease.Name, Mode=OneWay}"
                                                   FontSize="13" FontWeight="Medium" Foreground="#2C2C2A"/>
                                                    <TextBlock Text="{Binding Description, Mode=OneWay}"
                                                   FontSize="12" Foreground="#888780"
                                                   Visibility="{Binding Description, Converter={StaticResource NullToVisibility}}"/>
                                                </StackPanel>
                                                <Border Grid.Column="2" CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#EAF3DE"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFinal}" Value="False">
                                                                    <Setter Property="Background" Value="#FAEEDA"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="12">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="Остаточний"/>
                                                                <Setter Property="Foreground" Value="#3B6D11"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsFinal}" Value="False">
                                                                        <Setter Property="Text" Value="Попередній"/>
                                                                        <Setter Property="Foreground" Value="#854F0B"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Алергії -->
                    <Border Background="White" BorderBrush="#E0DEDB"
                BorderThickness="1" CornerRadius="8"
                Padding="20" Margin="0,0,0,12"
                Visibility="{Binding HasAllergies, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="АЛЕРГІЇ ВИЯВЛЕНІ НА ПРИЙОМІ" FontSize="11" FontWeight="SemiBold"
                           Foreground="#888780" Margin="0,0,0,14"/>
                            <ItemsControl ItemsSource="{Binding Allergies}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="12" Padding="10,5" Margin="0,0,6,6" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#EAF3DE"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ReactionSeverity}" Value="MODERATE">
                                                            <Setter Property="Background" Value="#FAEEDA"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ReactionSeverity}" Value="SEVERE">
                                                            <Setter Property="Background" Value="#FCEBEB"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="12" FontWeight="Medium"
                                        Text="{Binding AllergyDisplay, Mode=OneWay}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Дослідження -->
                    <Border Background="White" BorderBrush="#E0DEDB"
                BorderThickness="1" CornerRadius="8"
                Padding="20" Margin="0,0,0,12"
                Visibility="{Binding HasResearches, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="ДОСЛІДЖЕННЯ" FontSize="11" FontWeight="SemiBold"
                           Foreground="#888780" Margin="0,0,0,14"/>
                            <ItemsControl ItemsSource="{Binding Researches}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#F1EFE8" BorderThickness="0,0,0,1" Padding="0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Іконка -->
                                                <Border Grid.Column="0" Width="32" Height="32"
                            CornerRadius="8" Background="#E6F1FB"
                            Margin="0,0,12,0" VerticalAlignment="Center">
                                                    <ui:SymbolIcon Symbol="Microscope24" FontSize="16" Foreground="#185FA5"/>
                                                </Border>

                                                <!-- Інфо -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Research.ResearchType, Mode=OneWay}"
                                   FontSize="13" FontWeight="Medium" Foreground="#2C2C2A"/>
                                                    <TextBlock FontSize="11" Foreground="#888780">
                            <Run Text="Створено:"/>
                            <Run Text="{Binding Research.CreatedAtDisplay, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Research.Results, Mode=OneWay}"
                                   FontSize="11" Foreground="#5F5E5A"
                                   TextWrapping="Wrap" Margin="0,2,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
