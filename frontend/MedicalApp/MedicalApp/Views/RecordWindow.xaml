                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Діагноз або код МКБ" FontSize="11"
                                       Foreground="#888780" Margin="0,0,0,4"/>
                                                <ComboBox ItemsSource="{Binding AvailableDiseases}"
                                      SelectedItem="{Binding SelectedDisease}"
                                      DisplayMemberPath="Name"
                                      TextSearch.TextPath="Name"
                                      IsTextSearchEnabled="True"
                                      IsEditable="True"
                                      StaysOpenOnEdit="True"
                                      Height="36" FontSize="13"
                                      BorderBrush="#D3D1C7"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                                <TextBlock Text="Статус" FontSize="11"
                                       Foreground="#888780" Margin="0,0,0,4"/>
                                                <ComboBox ItemsSource="{Binding DiseaseStatusDisplayOptions}"
                                      Height="36" FontSize="13"
                                      BorderBrush="#D3D1C7"
                                      SelectionChanged="NewDiseaseStatus_SelectionChanged"/>
                                            </StackPanel>
                                            <Button Grid.Column="4"
                                Command="{Binding AddDiseaseCommand}"
                                Height="36" Padding="14,0"
                                Cursor="Hand" VerticalAlignment="Bottom">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="#185FA5"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      Margin="{TemplateBinding Padding}"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="#1A6FB8"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Add24" FontSize="13" Margin="0,0,4,0"/>
                                                    <TextBlock Text="Додати" FontSize="13"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>


                    <!-- Дослідження -->
                    <Border Background="White" BorderBrush="#E0DEDB"
        BorderThickness="1" CornerRadius="8" Margin="0,0,0,8">
                        <StackPanel>
                            <Button Click="ToggleResearches_Click" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                        CornerRadius="8" Padding="20,14">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#F8F9FA"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="32" Height="32"
                        CornerRadius="8" Background="#E6F1FB" Margin="0,0,12,0">
                                        <ui:SymbolIcon Symbol="Microscope24" FontSize="16" Foreground="#185FA5"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Дослідження" FontSize="14" FontWeight="Medium" Foreground="#2C2C2A"/>
                                        <TextBlock Text="Прив'язати дослідження цього кейсу до запису"
                               FontSize="11" Foreground="#888780"/>
                                    </StackPanel>
                                    <ui:SymbolIcon Grid.Column="2" FontSize="14" Foreground="#888780">
                                        <ui:SymbolIcon.Style>
                                            <Style TargetType="ui:SymbolIcon">
                                                <Setter Property="Symbol" Value="ChevronDown24"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsResearchesExpanded}" Value="True">
                                                        <Setter Property="Symbol" Value="ChevronUp24"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:SymbolIcon.Style>
                                    </ui:SymbolIcon>
                                </Grid>
                            </Button>
                            <Border Padding="20,0,20,16">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsResearchesExpanded}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <Border BorderBrush="#E0DEDB" BorderThickness="0,1,0,0" Margin="0,0,0,16"/>
                                    <TextBlock Text="У цьому кейсі немає досліджень"
                           FontSize="12" Foreground="#888780" FontStyle="Italic">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CaseResearches.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ItemsControl ItemsSource="{Binding CaseResearches}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#F1EFE8" BorderThickness="0,0,0,1" Padding="0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Чекбокс — заблокований якщо IsDisabled -->
                                                        <CheckBox Grid.Column="0"
                                                                IsChecked="{Binding IsSelected}"
                                                                VerticalAlignment="Center"
                                                                Margin="0,0,12,0">
                                                            <CheckBox.Style>
                                                                <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                                                    <Setter Property="IsEnabled" Value="True"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                                            <Setter Property="IsEnabled" Value="False"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </CheckBox.Style>
                                                        </CheckBox>

                                                        <!-- Іконка -->
                                                        <Border Grid.Column="1" Width="28" Height="28"
                        CornerRadius="6" Margin="0,0,10,0" VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#E6F1FB"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsFromFile}" Value="True">
                                                                            <Setter Property="Background" Value="#FAEEDA"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                                            <Setter Property="Background" Value="#F1EFE8"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <ui:SymbolIcon FontSize="14">
                                                                <ui:SymbolIcon.Style>
                                                                    <Style TargetType="ui:SymbolIcon">
                                                                        <Setter Property="Symbol" Value="Microscope24"/>
                                                                        <Setter Property="Foreground" Value="#185FA5"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsFromFile}" Value="True">
                                                                                <Setter Property="Symbol" Value="Document24"/>
                                                                                <Setter Property="Foreground" Value="#854F0B"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                                                <Setter Property="Symbol" Value="Microscope24"/>
                                                                                <Setter Property="Foreground" Value="#B4B2A9"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ui:SymbolIcon.Style>
                                                            </ui:SymbolIcon>
                                                        </Border>

                                                        <!-- Інфо -->
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding ResearchType}"
                               FontSize="13" FontWeight="Medium">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#2C2C2A"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                                                <Setter Property="Foreground" Value="#B4B2A9"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding StatusDisplay}" FontSize="11">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#888780"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                                                <Setter Property="Foreground" Value="#C0BEBC"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>

                                                        <!-- Кнопка перегляду -->
                                                        <Button Grid.Column="3" Height="26" Padding="8,0"
                                                                Cursor="Hand" VerticalAlignment="Center"
                                                                Margin="0,0,6,0" Tag="{Binding}"
                                                                Click="ViewResearchFromRecord_Click">
                                                            <Button.Style>
                                                                <Style TargetType="Button">
                                                                    <Setter Property="Background" Value="White"/>
                                                                    <Setter Property="Foreground" Value="#5F5E5A"/>
                                                                    <Setter Property="BorderBrush" Value="#D3D1C7"/>
                                                                    <Setter Property="BorderThickness" Value="1"/>
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border Background="{TemplateBinding Background}"
                                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                                                        CornerRadius="6">
                                                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                                                    VerticalAlignment="Center"
                                                                                                    Margin="{TemplateBinding Padding}"/>
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                        <Setter Property="Background" Value="#F1EFE8"/>
                                                                                    </Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </Style>
                                                            </Button.Style>
                                                            <ui:SymbolIcon Symbol="Eye24" FontSize="12"/>
                                                        </Button>

                                                        <!-- Кнопка Обробити — тільки для PDF -->
                                                        <Button Grid.Column="4" Height="26" Padding="8,0"
                                                                Cursor="Hand" VerticalAlignment="Center"
                                                                Tag="{Binding}" Click="ProcessResearchFromRecord_Click">
                                                            <Button.Style>
                                                                <Style TargetType="Button">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Setter Property="Background" Value="#FAEEDA"/>
                                                                    <Setter Property="Foreground" Value="#854F0B"/>
                                                                    <Setter Property="BorderThickness" Value="0"/>
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                                                    <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Margin="{TemplateBinding Padding}"/>
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                        <Setter Property="Background" Value="#F5D9A8"/>
                                                                                    </Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsFromFile}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <StackPanel Orientation="Horizontal">
                                                                <ui:SymbolIcon Symbol="Play24" FontSize="11" Margin="0,0,4,0"/>
                                                                <TextBlock Text="Обробити" FontSize="11"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Пагінація -->
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
            Visibility="{Binding ShowResearchPagination, Converter={StaticResource BoolToVisibility}}">
                                        <Button Content="←" Click="ResearchPrevPage_Click"
            IsEnabled="{Binding CanGoResearchPrev}"
            Width="28" Height="28" Margin="0,0,4,0" Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="White"/>
                                                    <Setter Property="BorderBrush" Value="#D3D1C7"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsEnabled" Value="False">
                                                                        <Setter Property="Foreground" Value="#C0BEBC"/>
                                                                        <Setter Property="BorderBrush" Value="#EEECE8"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#F1EFE8"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="#888780" Margin="4,0">
                                            <Run Text="{Binding ResearchPage, Mode=OneWay}"/>
                                            <Run Text="/"/>
                                            <Run Text="{Binding ResearchTotalPages, Mode=OneWay}"/>
                                        </TextBlock>
                                        <Button Content="→" Click="ResearchNextPage_Click"
            IsEnabled="{Binding CanGoResearchNext}"
            Width="28" Height="28" Margin="4,0,0,0" Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="White"/>
                                                    <Setter Property="BorderBrush" Value="#D3D1C7"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsEnabled" Value="False">
                                                                        <Setter Property="Foreground" Value="#C0BEBC"/>
                                                                        <Setter Property="BorderBrush" Value="#EEECE8"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#F1EFE8"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Боттомбар -->
        <Border Grid.Row="2" Background="White"
                BorderBrush="#E0DEDB" BorderThickness="0,1,0,0"
                Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Ліво: інфо про кейс або чекбокс -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- В режимі перегляду — інфо про кейс -->
                    <TextBlock FontSize="12" Foreground="#888780" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="{Binding CaseSubtitle, Mode=OneWay}"/>
                    </TextBlock>

                    <!-- В режимі редагування — чекбокс -->
                    <CheckBox IsChecked="{Binding IsDraftSave}" VerticalAlignment="Center" Cursor="Hand">
                        <CheckBox.Style>
                            <Style TargetType="CheckBox">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </CheckBox.Style>
                        <CheckBox.Content>
                            <TextBlock Text="Залишити як чернетку" FontSize="12" Foreground="#5F5E5A"/>
                        </CheckBox.Content>
                    </CheckBox>
                </StackPanel>

                <!-- Кнопка закрити/назад -->
                <ui:Button Grid.Column="1"
                           Click="CloseOrBackButton_Click"
                           Height="36" Padding="14,0"
                           Cursor="Hand" Margin="0,0,8,0"
                           Appearance="Secondary">
                    <ui:Button.Style>
                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                            <Setter Property="Icon" Value="{ui:SymbolIcon Dismiss24}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                    <Setter Property="Icon" Value="{ui:SymbolIcon ArrowLeft24}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Закрити"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                        <Setter Property="Text" Value="Назад"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </ui:Button>

                <!-- Кнопка зберегти — тільки в режимі редагування -->
                <ui:Button Grid.Column="2"
                           Command="{Binding SaveCommand}"
                           Height="36" Padding="14,0"
                           Cursor="Hand" Appearance="Primary"
                           Icon="{ui:SymbolIcon Save24}">
                    <ui:Button.Style>
                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                    <TextBlock Text="Зберегти" FontSize="13"/>
                </ui:Button>
            </Grid>
        </Border>
    </Grid>
</Window>