<UserControl x:Class="MedicalApp.Views.DoctorHomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#F5F5F5">
        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Width="400">

            <!-- Иконка -->
            <Border Width="80" Height="80"
                    CornerRadius="40"
                    Background="#E6F1FB"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,24">
                <TextBlock Text="👨‍⚕️"
                           FontSize="36"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <!-- Приветствие -->
            <TextBlock Text="Ласкаво просимо!"
                       FontSize="26"
                       FontWeight="Medium"
                       Foreground="#185FA5"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8"/>

            <TextBlock FontSize="14"
                       Foreground="#888780"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,0,0,8">
                <Run Text="Ви увійшли як "/>
                <Run Text="Лікар"
                     Foreground="#185FA5"
                     FontWeight="Medium"/>
            </TextBlock>

            <TextBlock Text="Оберіть потрібний розділ у меню зліва"
                       FontSize="13"
                       Foreground="#B4B2A9"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,48"/>

            <!-- Кнопка выхода -->
            <Button Click="Logout_Click"
                    Height="42"
                    Width="200"
                    Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="Foreground" Value="#E24B4A"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="BorderBrush" Value="#E24B4A"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FCEBEB"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
                <TextBlock Text="Вийти з системи" FontSize="14"/>
            </Button>

        </StackPanel>
    </Grid>
</UserControl>