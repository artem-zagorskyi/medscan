<UserControl x:Class="MedicalApp.Views.AdminDoctorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:MedicalApp.ViewModels">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="White"
                BorderBrush="#E0DEDB" BorderThickness="0,0,0,1"
                Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Лікарі"
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="#2C2C2A"/>
                    <TextBlock FontSize="12" Foreground="#888780" Margin="0,2,0,0">
                        <Run Text="Знайдено: "/>
                        <Run Text="{Binding TotalDoctors}"/>
                        <Run Text=" лікарів"/>
                    </TextBlock>
                </StackPanel>

                <ui:Button Grid.Column="1"
                           Click="AddDoctor_Click"
                           Height="36" Padding="14,0"
                           Cursor="Hand"
                           Background="#185FA5"
                           Foreground="White"
                           MouseOverBackground="#1A6FB8"
                           PressedBackground="#0C447C"
                           Icon="{ui:SymbolIcon PersonAdd24}">
                    <TextBlock Text="Додати лікаря" FontSize="13"/>
                </ui:Button>
            </Grid>
        </Border>

        <!-- Пошук і фільтр -->
        <Border Grid.Row="1" Background="White"
                BorderBrush="#E0DEDB" BorderThickness="0,0,0,1"
                Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>

                <ui:TextBox Grid.Column="0"
                            PlaceholderText="Пошук за ім'ям, спеціалізацією або email..."
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                            Icon="{ui:SymbolIcon Search24}"
                            Margin="0,0,12,0"/>

                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding StatusOptions}"
                          SelectedItem="{Binding SelectedStatus}"
                          MinHeight="28" Padding="6,4"
                          VerticalContentAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Список -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,16">

                <!-- Загрузка -->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0,60,0,0"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                    <ui:ProgressRing IsIndeterminate="True" Width="40" Height="40"/>
                    <TextBlock Text="Завантаження..." Margin="0,12,0,0"
                               Foreground="#888780" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Ошибка -->
                <ui:InfoBar Title=""
                            Message="{Binding ErrorMessage}"
                            Severity="Error"
                            IsOpen="{Binding HasError}"
                            IsClosable="False"
                            Margin="0,0,0,16"/>

                <!-- Карточки врачей -->
                <ItemsControl ItemsSource="{Binding Doctors}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White"
                                    BorderBrush="#E0DEDB"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Margin="0,0,0,8"
                                    Padding="20,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Аватар -->
                                    <Border Grid.Column="0"
                                            Width="40" Height="40"
                                            CornerRadius="20"
                                            Background="#E6F1FB"
                                            Margin="0,0,14,0">
                                        <TextBlock Text="{Binding FullName[0]}"
                                                   FontSize="16" FontWeight="SemiBold"
                                                   Foreground="#185FA5"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Інфо -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FullName}"
                                                   FontSize="14" FontWeight="Medium"
                                                   Foreground="#2C2C2A"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding Specialization}"
                                                       FontSize="12" Foreground="#888780"/>
                                            <TextBlock Text=" · " FontSize="12" Foreground="#C5C3BC"/>
                                            <TextBlock Text="{Binding Email}"
                                                       FontSize="12" Foreground="#888780"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Статус бейдж -->
                                    <Border Grid.Column="2"
                                            Background="{Binding StatusColor}"
                                            CornerRadius="4"
                                            Padding="8,4"
                                            Margin="12,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusDisplay}"
                                                   FontSize="12"
                                                   Foreground="{Binding StatusTextColor}"/>
                                    </Border>

                                    <!-- Кнопки -->
                                    <StackPanel Grid.Column="3"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">

                                        <Button Tag="{Binding}"
                                                Click="EditDoctor_Click"
                                                Height="32" Padding="10,0"
                                                Cursor="Hand"
                                                Margin="0,0,8,0">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="#E6F1FB"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}"
                                                                        CornerRadius="6"
                                                                        Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#D0E4F7"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Edit24" FontSize="13"
                                                               Foreground="#185FA5"
                                                               Margin="0,0,4,0"/>
                                                <TextBlock Text="Редагувати" FontSize="12"
                                                           Foreground="#185FA5"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Tag="{Binding}"
                                                Click="ToggleActive_Click"
                                                Height="32" Padding="10,0"
                                                Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="{Binding ToggleButtonColor}"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}"
                                                                        CornerRadius="6"
                                                                        Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Opacity" Value="0.85"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock Text="{Binding ToggleButtonText}"
                                                       FontSize="12"
                                                       Foreground="{Binding ToggleButtonTextColor}"/>
                                        </Button>

                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>