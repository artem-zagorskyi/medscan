<Window x:Class="MedicalApp.Views.ViewResearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Перегляд дослідження"
        Width="900" Height="680"
        MinWidth="700" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Шапка -->
            <RowDefinition Height="*"/>
            <!-- Контент -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════
             ШАПКА
        ════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="White"
                BorderBrush="#E0DEDB" BorderThickness="0,0,0,1"
                Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Іконка + назва -->
                <Border Grid.Column="0"
                        Width="36" Height="36"
                        CornerRadius="8"
                        Margin="0,0,14,0"
                        VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#E6F1FB"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFromFile}" Value="True">
                                    <Setter Property="Background" Value="#FAEEDA"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <ui:SymbolIcon FontSize="18">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Setter Property="Symbol" Value="Microscope24"/>
                                <Setter Property="Foreground" Value="#185FA5"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFromFile}" Value="True">
                                        <Setter Property="Symbol" Value="Document24"/>
                                        <Setter Property="Foreground" Value="#854F0B"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                </Border>

                <!-- Назва та дата -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="#2C2C2A"/>
                    <TextBlock FontSize="12" Foreground="#888780" Margin="0,2,0,0">
                        <Run Text="{Binding PatientName}"/>
                        <Run Text=" · "/>
                        <Run Text="{Binding CreatedAtDisplay}"/>
                    </TextBlock>
                </StackPanel>

                <!-- Кнопки -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Кнопка "Обробити" — тільки для PDF файлів -->
                    <Button Click="ProcessButton_Click"
                            Height="34" Padding="14,0"
                            Cursor="Hand" Margin="0,0,8,0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Setter Property="Background" Value="#FAEEDA"/>
                                <Setter Property="Foreground" Value="#854F0B"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  Margin="{TemplateBinding Padding}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#F5D9A8"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFromFile}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Play24" FontSize="13" Margin="0,0,6,0"/>
                            <TextBlock Text="Обробити" FontSize="13"/>
                        </StackPanel>
                    </Button>

                    <!-- Закрити -->
                    <Button Content="Закрити"
                            Click="CloseButton_Click"
                            Height="34" Padding="14,0"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="#5F5E5A"/>
                                <Setter Property="BorderBrush" Value="#D3D1C7"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  Margin="{TemplateBinding Padding}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#F1EFE8"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════
             РЕЖИМ 1 — ДАНІ ДОСЛІДЖЕННЯ
        ════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="24,20">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFromFile}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <StackPanel>

                <!-- Основна інформація -->
                <Border Background="White" BorderBrush="#E0DEDB"
                        BorderThickness="1" CornerRadius="8"
                        Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="ОСНОВНА ІНФОРМАЦІЯ"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="#888780" Margin="0,0,0,14"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Тип дослідження:"
                                       FontSize="12" Foreground="#888780" Margin="0,0,0,10"/>
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       Text="{Binding ResearchType}"
                                       FontSize="12" Foreground="#2C2C2A" FontWeight="Medium"
                                       Margin="0,0,0,10"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Статус:"
                                       FontSize="12" Foreground="#888780" Margin="0,0,0,10"/>
                            <Border Grid.Row="1" Grid.Column="1"
                                    Background="{Binding StatusColor}"
                                    CornerRadius="10" Padding="10,3"
                                    HorizontalAlignment="Left" Margin="0,0,0,10">
                                <TextBlock Text="{Binding StatusDisplay}"
                                           FontSize="12"
                                           Foreground="{Binding StatusTextColor}"/>
                            </Border>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Дата створення:"
                                       FontSize="12" Foreground="#888780" Margin="0,0,0,10"/>
                            <TextBlock Grid.Row="2" Grid.Column="1"
                                       Text="{Binding CreatedAtDisplay}"
                                       FontSize="12" Foreground="#2C2C2A"
                                       Margin="0,0,0,10"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Дата обробки:"
                                       FontSize="12" Foreground="#888780"/>
                            <TextBlock Grid.Row="3" Grid.Column="1"
                                       Text="{Binding ProcessedAtDisplay}"
                                       FontSize="12" Foreground="#2C2C2A"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Результати -->
                <Border Background="White" BorderBrush="#E0DEDB"
                        BorderThickness="1" CornerRadius="8"
                        Padding="20">
                    <StackPanel>
                        <TextBlock Text="РЕЗУЛЬТАТИ"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="#888780" Margin="0,0,0,14"/>
                        <TextBlock Text="{Binding Results}"
                                   FontSize="13" Foreground="#2C2C2A"
                                   TextWrapping="Wrap" LineHeight="20">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Results}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="Результати відсутні"
                                   FontSize="12" Foreground="#888780" FontStyle="Italic">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Results}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <!-- Витягнутий текст -->
                <Border Background="White" BorderBrush="#E0DEDB"
                        BorderThickness="1" CornerRadius="8"
                        Padding="20" Margin="0,0,0,16">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ExtractedText}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="ВИТЯГНУТИЙ ТЕКСТ (OCR)"
                                    FontSize="11" FontWeight="SemiBold"
                                    Foreground="#888780" Margin="0,0,0,14"/>
                        <TextBlock Text="{Binding ExtractedText}"
                                    FontSize="12" Foreground="#5F5E5A"
                                    TextWrapping="Wrap" LineHeight="20"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ═══════════════════════════════════════
             РЕЖИМ 2 — PDF VIEWER
        ════════════════════════════════════════ -->
        <Border Grid.Row="1" Background="#525659">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFromFile}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <wv2:WebView2 x:Name="PdfViewer"/>
        </Border>

    </Grid>
</Window>
