                                    <Run Text="Сторінка"/>
                                    <Run Text="{Binding CasesCurrentPage, Mode=OneWay}"/>
                                    <Run Text="з"/>
                                    <Run Text="{Binding CasesTotalPages, Mode=OneWay}"/>
                                </TextBlock>
                            </Grid>
                        </StackPanel>

                        <!-- Вкладка Дослідження -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsResearchTab}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border MinHeight="300">
                                <ItemsControl ItemsSource="{Binding CurrentResearches}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#F1EFE8"
                                                    BorderThickness="0,0,0,1" Padding="0,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="36"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0"
                                                            Width="32" Height="32"
                                                            CornerRadius="8"
                                                            Background="#E6F1FB"
                                                            VerticalAlignment="Top">
                                                        <ui:SymbolIcon FontSize="16" Foreground="#185FA5">
                                                            <ui:SymbolIcon.Style>
                                                                <Style TargetType="ui:SymbolIcon">
                                                                    <Setter Property="Symbol" Value="Microscope24"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsFromFile}" Value="True">
                                                                            <Setter Property="Symbol" Value="Document24"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ui:SymbolIcon.Style>
                                                        </ui:SymbolIcon>
                                                    </Border>
