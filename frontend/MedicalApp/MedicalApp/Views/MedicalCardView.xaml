<UserControl x:Class="MedicalApp.Views.MedicalCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MedicalApp.ViewModels">

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0"
        Background="White"
        BorderBrush="#D3D1C7"
        BorderThickness="0,0,0,1"
        Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Назад -->
                <Button Grid.Column="0"
                Content="← Назад"
                Click="BackButton_Click"
                Height="36"
                Padding="12,0"
                Cursor="Hand"
                Margin="0,0,16,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="Foreground" Value="#185FA5"/>
                            <Setter Property="BorderBrush" Value="#B5D4F4"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Margin="{TemplateBinding Padding}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#E6F1FB"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- ПІБ -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Patient.FullName}"
                       FontSize="16"
                       FontWeight="Medium"
                       Foreground="#2C2C2A"/>
                    <TextBlock FontSize="12"
                       Foreground="#888780">
                <Run Text="Медична картка ·"/>
                <Run Text="{Binding Patient.Age, Mode=OneWay}"/>
                <Run Text="років ·"/>
                <Run Text="{Binding Patient.GenderDisplay, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>

                <!-- Новий запис -->
                <Button Grid.Column="2"
                Content="+ Новий запис"
                Height="36"
                Padding="14,0"
                Cursor="Hand"
                Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="Foreground" Value="#185FA5"/>
                            <Setter Property="BorderBrush" Value="#B5D4F4"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Margin="{TemplateBinding Padding}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#E6F1FB"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Редагувати -->
                <Button Grid.Column="3"
                Content="✏ Редагувати"
                Click="EditButton_Click"
                Height="36"
                Padding="14,0"
                Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#185FA5"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                        CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Margin="{TemplateBinding Padding}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#0C447C"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- Контент -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20" >

                <!-- Основна інформація -->
                <Border Background="White"
                        BorderBrush="#D3D1C7"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="ОСНОВНА ІНФОРМАЦІЯ"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   Foreground="#888780"
                                   Margin="0,0,0,14"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,0,12">
                                <TextBlock Text="ДАТА НАРОДЖЕННЯ" FontSize="10" Foreground="#888780" Margin="0,0,0,3"/>
                                <TextBlock Text="{Binding Patient.BirthDate, StringFormat=dd.MM.yyyy}" FontSize="13" Foreground="#2C2C2A" FontWeight="Medium"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,0,0,12">
                                <TextBlock Text="ВІК" FontSize="10" Foreground="#888780" Margin="0,0,0,3"/>
                                <TextBlock FontSize="13" Foreground="#2C2C2A" FontWeight="Medium">
                                    <Run Text="{Binding Patient.Age, Mode=OneWay}"/>
                                    <Run Text=" років"/>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Grid.Row="0" Margin="0,0,0,12">
                                <TextBlock Text="СТАТЬ" FontSize="10" Foreground="#888780" Margin="0,0,0,3"/>
                                <TextBlock Text="{Binding Patient.GenderDisplay}" FontSize="13" Foreground="#2C2C2A" FontWeight="Medium"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Група крові + Алергії -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Група крові -->
                    <Border Grid.Column="0"
                            Background="White"
                            BorderBrush="#D3D1C7"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20">
                        <StackPanel>
                            <TextBlock Text="ГРУПА КРОВІ ТА РЕЗУС"
                                       FontSize="11"
                                       FontWeight="Medium"
                                       Foreground="#888780"
                                       Margin="0,0,0,14"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Background="#F1EFE8"
                                        CornerRadius="6"
                                        Padding="12"
                                        Margin="0,0,6,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding BloodGroup}"
                                                   FontSize="22"
                                                   FontWeight="Medium"
                                                   Foreground="#185FA5"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="Група крові"
                                                   FontSize="11"
                                                   Foreground="#888780"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1"
                                        Background="#F1EFE8"
                                        CornerRadius="6"
                                        Padding="12"
                                        Margin="6,0,0,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding RhFactor}"
                                                   FontSize="22"
                                                   FontWeight="Medium"
                                                   Foreground="#185FA5"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="Резус фактор"
                                                   FontSize="11"
                                                   Foreground="#888780"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Алергії -->
                    <Border Grid.Column="2"
                            Background="White"
                            BorderBrush="#D3D1C7"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20">
                        <StackPanel>
                            <TextBlock Text="АЛЕРГІЇ"
                                       FontSize="11"
                                       FontWeight="Medium"
                                       Foreground="#888780"
                                       Margin="0,0,0,14"/>
                            <ItemsControl ItemsSource="{Binding Allergies}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding SeverityColor}"
                                                CornerRadius="12"
                                                Padding="10,5"
                                                Margin="0,0,6,6">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="12"
                                                           Foreground="{Binding SeverityTextColor}"
                                                           FontWeight="Medium"/>
                                                <TextBlock Text=" · "
                                                           FontSize="12"
                                                           Foreground="{Binding SeverityTextColor}"/>
                                                <TextBlock Text="{Binding Severity}"
                                                           FontSize="12"
                                                           Foreground="{Binding SeverityTextColor}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Діагнози -->
                <Border Background="White"
                        BorderBrush="#D3D1C7"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock FontSize="11"
                                   FontWeight="Medium"
                                   Foreground="#888780"
                                   Margin="0,0,0,14">
                            <Run Text="ДІАГНОЗИ ·"/>
                            <Run Text="{Binding Diagnoses.Count, Mode=OneWay}"/>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding Diagnoses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#F1EFE8"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    Background="#F1EFE8"
                                                    CornerRadius="4"
                                                    Padding="6,3"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding IcdCode}"
                                                           FontSize="12"
                                                           Foreground="#5F5E5A"
                                                           FontWeight="Medium"/>
                                            </Border>

                                            <StackPanel Grid.Column="1"
                                                        Margin="12,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="13"
                                                           FontWeight="Medium"
                                                           Foreground="#2C2C2A"/>
                                                <TextBlock Text="{Binding Description}"
                                                           FontSize="12"
                                                           Foreground="#888780"/>
                                            </StackPanel>

                                            <Border Grid.Column="2"
                                                    Background="{Binding StatusColor}"
                                                    CornerRadius="10"
                                                    Padding="10,4"
                                                    Margin="0,0,12,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Status}"
                                                           FontSize="12"
                                                           Foreground="{Binding StatusTextColor}"/>
                                            </Border>

                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding DiagnosedAtDisplay}"
                                                       FontSize="12"
                                                       Foreground="#888780"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Історія записів -->
                <Border Background="White"
                        BorderBrush="#D3D1C7"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20">
                    <StackPanel>

                        <!-- Заголовок + фільтр -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                          

                            <TextBlock FontSize="11"
                                       FontWeight="Medium"
                                       Foreground="#888780"
                                       VerticalAlignment="Center">
                                <Run Text="ІСТОРІЯ ЗАПИСІВ ·"/>
                                <Run Text="{Binding TotalEntries, Mode=OneWay}"/>
                            </TextBlock>

                            <Grid Grid.Column="1">
                                <Button x:Name="EntryFilterButton"
                                        Click="EntryFilterButton_Click"
                                        Height="32"
                                        Padding="12,0"
                                        Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="White"/>
                                            <Setter Property="BorderBrush" Value="#D3D1C7"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="6">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"
                                                                              Margin="{TemplateBinding Padding}"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#F1EFE8"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Фільтр"
                                                   FontSize="12"
                                                   Foreground="#5F5E5A"
                                                   Margin="0,0,6,0"/>
                                        <TextBlock Text="▼"
                                                   FontSize="10"
                                                   Foreground="#888780"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Popup x:Name="EntryFilterPopup"
                                       PlacementTarget="{Binding ElementName=EntryFilterButton}"
                                       Placement="Bottom"
                                       StaysOpen="False"
                                       AllowsTransparency="True">
                                    <Border Background="White"
                                            BorderBrush="#D3D1C7"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            MinWidth="220"
                                            Margin="0,6,0,0"
                                            Padding="4">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#888780"
                                                              BlurRadius="12"
                                                              ShadowDepth="2"
                                                              Opacity="0.15"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <ItemsControl ItemsSource="{Binding EntryTypeOptions}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Content="{Binding}"
                                                                Style="{StaticResource DropdownItemStyle}"
                                                                Tag="{Binding}"
                                                                Click="EntryTypeFilter_Click"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Border BorderBrush="#D3D1C7"
                                                    BorderThickness="0,1,0,0"
                                                    Margin="8,4"/>
                                            <Button Content="Скинути фільтр"
                                                    Style="{StaticResource DropdownItemStyle}"
                                                    Foreground="#E24B4A"
                                                    Click="ResetEntryFilter_Click"/>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Grid>

                        <!-- Список записів -->
                        <ItemsControl ItemsSource="{Binding CurrentEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#F1EFE8"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Іконка -->
                                            <Border Grid.Column="0"
                                                    Width="32" Height="32"
                                                    CornerRadius="8"
                                                    Background="{Binding IconColor}"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="{Binding IconText}"
                                                           FontSize="14"
                                                           FontWeight="Medium"
                                                           Foreground="#185FA5"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Контент -->
                                            <StackPanel Grid.Column="1" Margin="12,0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="{Binding EntryTypeDisplay}"
                                                               FontSize="13"
                                                               FontWeight="Medium"
                                                               Foreground="#2C2C2A"/>
                                                    <TextBlock Text=" · "
                                                               FontSize="13"
                                                               Foreground="#888780"/>
                                                    <TextBlock Text="{Binding DoctorName}"
                                                               FontSize="13"
                                                               Foreground="#888780"/>
                                                    <TextBlock Text=", "
                                                               FontSize="13"
                                                               Foreground="#888780"/>
                                                    <TextBlock Text="{Binding Specialization}"
                                                               FontSize="13"
                                                               Foreground="#888780"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Complaints}"
                                                           FontSize="12"
                                                           Foreground="#5F5E5A"
                                                           TextWrapping="Wrap"
                                                           Margin="0,0,0,2"/>
                                                <TextBlock Text="{Binding Conclusion}"
                                                           FontSize="12"
                                                           Foreground="#5F5E5A"
                                                           TextWrapping="Wrap"/>
                                                <Border Background="{Binding ResearchStatusColor}"
                                                        CornerRadius="10"
                                                        Padding="8,3"
                                                        Margin="0,6,0,0"
                                                        HorizontalAlignment="Left"
                                                        Visibility="{Binding ResearchStatus, Converter={StaticResource NullToVisibility}}">
                                                    <TextBlock Text="{Binding ResearchStatus}"
                                                               FontSize="11"
                                                               Foreground="{Binding ResearchStatusTextColor}"/>
                                                </Border>
                                            </StackPanel>

                                            <!-- Дата -->
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding VisitDateDisplay}"
                                                       FontSize="12"
                                                       Foreground="#888780"
                                                       VerticalAlignment="Top"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Пагінація -->
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="←"
                                        Command="{Binding PrevPageCommand}"
                                        IsEnabled="{Binding CanGoPrev}"
                                        Width="30" Height="30"
                                        Margin="0,0,4,0"
                                        Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="White"/>
                                            <Setter Property="Foreground" Value="#2C2C2A"/>
                                            <Setter Property="BorderBrush" Value="#D3D1C7"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="6">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter Property="Foreground" Value="#B4B2A9"/>
                                                                <Setter Property="BorderBrush" Value="#F1EFE8"/>
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#F1EFE8"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <ItemsControl ItemsSource="{Binding PageNumbers}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding}"
                                                    Width="30" Height="30"
                                                    Margin="2,0"
                                                    Cursor="Hand"
                                                    Tag="{Binding}"
                                                    Click="PageButton_Click">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="White"/>
                                                        <Setter Property="Foreground" Value="#2C2C2A"/>
                                                        <Setter Property="BorderBrush" Value="#D3D1C7"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}"
                                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                                            CornerRadius="6">
                                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                                          VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="#F1EFE8"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Content="→"
                                        Command="{Binding NextPageCommand}"
                                        IsEnabled="{Binding CanGoNext}"
                                        Width="30" Height="30"
                                        Margin="4,0,0,0"
                                        Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="White"/>
                                            <Setter Property="Foreground" Value="#2C2C2A"/>
                                            <Setter Property="BorderBrush" Value="#D3D1C7"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="6">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter Property="Foreground" Value="#B4B2A9"/>
                                                                <Setter Property="BorderBrush" Value="#F1EFE8"/>
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#F1EFE8"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>

                            <TextBlock Grid.Column="1"
                                       FontSize="12"
                                       Foreground="#888780"
                                       VerticalAlignment="Center">
                                <Run Text="Сторінка"/>
                                <Run Text="{Binding CurrentPage, Mode=OneWay}"/>
                                <Run Text="з"/>
                                <Run Text="{Binding TotalPages, Mode=OneWay}"/>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>