                                                        <TextBlock Text="{Binding ResearchType}"
                                                                   FontSize="13" FontWeight="SemiBold"
                                                                   Foreground="#2C2C2A" Margin="0,0,0,2"/>
                                                        <TextBlock FontSize="12" Foreground="#888780">
                                                            <Run Text="Створено:"/>
                                                            <Run Text="{Binding CreatedAtDisplay, Mode=OneWay}"/>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Results}"
                                                                   FontSize="12" Foreground="#5F5E5A"
                                                                   TextWrapping="Wrap" Margin="0,4,0,0"
                                                                   Visibility="{Binding Results, Converter={StaticResource NullToVisibility}}"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="2"
                                                            Background="{Binding StatusColor}"
                                                            CornerRadius="10" Padding="10,4"
                                                            Margin="0,0,12,0" VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding StatusDisplay}"
                                                                   FontSize="12"
                                                                   Foreground="{Binding StatusTextColor}"/>
                                                    </Border>
                                                    <Button Grid.Column="3"
                                                            Height="28" Padding="10,0"
                                                            Cursor="Hand" VerticalAlignment="Top"
                                                            Tag="{Binding}"
                                                            Click="ProcessResearch_Click"
                                                            Margin="0,0,8,0">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Setter Property="Background" Value="#FAEEDA"/>
                                                                <Setter Property="Foreground" Value="#854F0B"/>
                                                                <Setter Property="BorderThickness" Value="0"/>
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                                  VerticalAlignment="Center"
                                                                                                  Margin="{TemplateBinding Padding}"/>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter Property="Background" Value="#F5D9A8"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding NeedsProcessing}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <StackPanel Orientation="Horizontal">
                                                            <ui:SymbolIcon Symbol="Play24" FontSize="12" Margin="0,0,4,0"/>
                                                            <TextBlock Text="Обробити" FontSize="12"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Grid.Column="4"
                                                            Height="28" Padding="10,0"
                                                            Cursor="Hand" VerticalAlignment="Top"
                                                            Tag="{Binding}"
                                                            Click="ViewResearch_Click"
                                                            Margin="0,0,8,0">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Background" Value="White"/>
                                                                <Setter Property="Foreground" Value="#5F5E5A"/>
                                                                <Setter Property="BorderBrush" Value="#D3D1C7"/>
                                                                <Setter Property="BorderThickness" Value="1"/>
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border Background="{TemplateBinding Background}"
                                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                                    CornerRadius="6">
                                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                                    VerticalAlignment="Center"
                                                                                                    Margin="{TemplateBinding Padding}"/>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter Property="Background" Value="#F1EFE8"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </Button.Style>
                                                        <StackPanel Orientation="Horizontal">
                                                            <ui:SymbolIcon Symbol="Eye24" FontSize="12" Margin="0,0,4,0"/>
                                                            <TextBlock Text="Переглянути" FontSize="12"/>
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <!-- Пагінація досліджень -->
                            <Grid Margin="0,16,0,0"
                                  Visibility="{Binding ShowResearchPagination, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="←" Click="ResearchPrevPage_Click"
                                            IsEnabled="{Binding CanGoResearchPrev}"
                                            Width="30" Height="30" Margin="0,0,4,0" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="White"/>
                                                <Setter Property="Foreground" Value="#2C2C2A"/>
                                                <Setter Property="BorderBrush" Value="#D3D1C7"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                    CornerRadius="6">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
