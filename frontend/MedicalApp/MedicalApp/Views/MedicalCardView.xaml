<UserControl x:Class="MedicalApp.Views.MedicalCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:MedicalApp.ViewModels">

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#E0DEDB"
                BorderThickness="0,0,0,1"
                Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Назад -->
                <ui:Button Grid.Column="0"
                           Click="BackButton_Click"
                           Height="36"
                           Padding="12,0"
                           Cursor="Hand"
                           Margin="0,0,16,0"
                           Appearance="Secondary"
                           Icon="{ui:SymbolIcon ArrowLeft24}">
                    <TextBlock Text="Назад" FontSize="13"/>
                </ui:Button>

                <!-- ПІБ -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Patient.FullName}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#2C2C2A"/>
                    <TextBlock FontSize="12" Foreground="#888780">
                        <Run Text="Медична картка ·"/>
                        <Run Text="{Binding Patient.AgeLabel, Mode=OneWay}"/>
                        <Run Text="·"/>
                        <Run Text="{Binding Patient.GenderDisplay, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>

                <!-- Новий запис -->
                <ui:Button Grid.Column="2"
                           Click="NewRecordButton_Click"
                           Height="36"
                           Padding="14,0"
                           Cursor="Hand"
                           Margin="0,0,8,0"
                           Appearance="Secondary"
                           Icon="{ui:SymbolIcon Add24}">
                    <TextBlock Text="Новий запис" FontSize="13"/>
                </ui:Button>

                <!-- Редагувати -->
                <Button Grid.Column="3"
                        Click="EditButton_Click"
                        Height="36"
                        Padding="14,0"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#185FA5"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Margin="{TemplateBinding Padding}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#1A6FB8"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background" Value="#0C447C"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Edit24" FontSize="14" Margin="0,0,6,0"/>
                        <TextBlock Text="Редагувати" FontSize="13"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Контент -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20">

                <!-- Основна інформація -->
                <Border Background="White"
                        BorderBrush="#E0DEDB"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="ОСНОВНА ІНФОРМАЦІЯ"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="#888780" Margin="0,0,0,14"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="ДАТА НАРОДЖЕННЯ" FontSize="10" Foreground="#888780" Margin="0,0,0,3"/>
                                <TextBlock Text="{Binding Patient.BirthDate, StringFormat=dd.MM.yyyy}"
                                           FontSize="13" Foreground="#2C2C2A" FontWeight="Medium"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="ВІК" FontSize="10" Foreground="#888780" Margin="0,0,0,3"/>
                                <TextBlock Text="{Binding Patient.AgeLabel, Mode=OneWay}"
                                           FontSize="13" Foreground="#2C2C2A" FontWeight="Medium"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="СТАТЬ" FontSize="10" Foreground="#888780" Margin="0,0,0,3"/>
                                <TextBlock Text="{Binding Patient.GenderDisplay}"
                                           FontSize="13" Foreground="#2C2C2A" FontWeight="Medium"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Група крові + Алергії -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White"
                            BorderBrush="#E0DEDB" BorderThickness="1"
                            CornerRadius="8" Padding="20">
                        <StackPanel>
                            <TextBlock Text="ГРУПА КРОВІ ТА РЕЗУС"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="#888780" Margin="0,0,0,14"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#F5F8FF"
                                        CornerRadius="6" Padding="12" Margin="0,0,6,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding BloodGroup}"
                                                   FontSize="22" FontWeight="SemiBold"
                                                   Foreground="#185FA5" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Група крові" FontSize="11"
                                                   Foreground="#888780" HorizontalAlignment="Center"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="#F5F8FF"
                                        CornerRadius="6" Padding="12" Margin="6,0,0,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding RhFactor}"
                                                   FontSize="22" FontWeight="SemiBold"
                                                   Foreground="#185FA5" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Резус фактор" FontSize="11"
                                                   Foreground="#888780" HorizontalAlignment="Center"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="White"
                            BorderBrush="#E0DEDB" BorderThickness="1"
                            CornerRadius="8" Padding="20">
                        <StackPanel>
                            <TextBlock Text="АЛЕРГІЇ" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#888780" Margin="0,0,0,14"/>
                            <ItemsControl ItemsSource="{Binding Allergies}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding SeverityColor}"
                                                CornerRadius="12" Padding="10,5" Margin="0,0,6,6">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="12"
                                                           Foreground="{Binding SeverityTextColor}"
                                                           FontWeight="Medium"/>
                                                <TextBlock Text=" · " FontSize="12"
                                                           Foreground="{Binding SeverityTextColor}"/>
                                                <TextBlock Text="{Binding Severity}" FontSize="12"
                                                           Foreground="{Binding SeverityTextColor}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Діагнози -->
                <Border Background="White" BorderBrush="#E0DEDB"
                        BorderThickness="1" CornerRadius="8"
                        Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock FontSize="11" FontWeight="SemiBold"
                                   Foreground="#888780" Margin="0,0,0,14">
                            <Run Text="ДІАГНОЗИ ·"/>
                            <Run Text="{Binding Diagnoses.Count, Mode=OneWay}"/>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding Diagnoses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#F1EFE8"
                                            BorderThickness="0,0,0,1" Padding="0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#F1EFE8"
                                                    CornerRadius="4" Padding="6,3"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding IcdCode}" FontSize="12"
                                                           Foreground="#5F5E5A" FontWeight="Medium"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="13"
                                                           FontWeight="Medium" Foreground="#2C2C2A"/>
                                            </StackPanel>
                                            <Border Grid.Column="2" Background="{Binding StatusColor}"
                                                    CornerRadius="10" Padding="10,4"
                                                    Margin="0,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Status}" FontSize="12"
                                                           Foreground="{Binding StatusTextColor}"/>
                                            </Border>
                                            <TextBlock Grid.Column="3" Text="{Binding DiagnosedAtDisplay}"
                                                       FontSize="12" Foreground="#888780"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Вкладки: Записи / Дослідження -->
                <Border Background="White" BorderBrush="#E0DEDB"
                        BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel>

                        <!-- Таб-бар -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Табы -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Button Click="RecordsTab_Click" Height="34" Padding="16,0" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"
                                                                              Margin="{TemplateBinding Padding}"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRecordsTab}" Value="True">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="BorderBrush" Value="#185FA5"/>
                                                    <Setter Property="Foreground" Value="#185FA5"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsRecordsTab}" Value="False">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                    <Setter Property="Foreground" Value="#888780"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="ClipboardTextLtr24"
                                                       FontSize="14" Margin="0,0,6,0"/>
                                        <TextBlock FontSize="13" FontWeight="Medium">
                                            <Run Text="Записи ·"/>
                                            <Run Text="{Binding TotalEntries, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>

                                <Button Click="ResearchTab_Click" Height="34" Padding="16,0" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"
                                                                              Margin="{TemplateBinding Padding}"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsResearchTab}" Value="True">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="BorderBrush" Value="#185FA5"/>
                                                    <Setter Property="Foreground" Value="#185FA5"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsResearchTab}" Value="False">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                    <Setter Property="Foreground" Value="#888780"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Microscope24"
                                                       FontSize="14" Margin="0,0,6,0"/>
                                        <TextBlock FontSize="13" FontWeight="Medium">
                                            <Run Text="Дослідження ·"/>
                                            <Run Text="{Binding TotalResearches, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Фильтры для записей -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsResearchTab}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Grid>
                                    <ui:Button x:Name="EntryFilterButton"
                                               Click="EntryFilterButton_Click"
                                               Height="32" Padding="10,0"
                                               Cursor="Hand" Appearance="Secondary"
                                               Icon="{ui:SymbolIcon Options24}">
                                        <TextBlock Text="Фільтри" FontSize="12"/>
                                    </ui:Button>
                                    <Popup x:Name="EntryFilterPopup"
                                           PlacementTarget="{Binding ElementName=EntryFilterButton}"
                                           Placement="Bottom"
                                           HorizontalOffset="-160"
                                           StaysOpen="False"
                                           AllowsTransparency="True">
                                        <Border Background="White" BorderBrush="#D3D1C7"
                                                BorderThickness="1" CornerRadius="8"
                                                MinWidth="240" Margin="0,6,0,0" Padding="16">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#000000" BlurRadius="16"
                                                                  ShadowDepth="2" Opacity="0.08"/>
                                            </Border.Effect>
                                            <StackPanel>
                                                <!-- Дата -->
                                                <Border Background="#F8F9FA" CornerRadius="6"
                                                        Padding="12,10" Margin="0,0,0,12">
                                                    <StackPanel>
                                                        <TextBlock Text="ДАТА ЗАПИСУ" FontSize="11"
                                                                   FontWeight="SemiBold" Foreground="#888780"
                                                                   Margin="0,0,0,8"/>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <DatePicker Grid.Column="0"
                                                                        SelectedDate="{Binding EntryDateFrom}"
                                                                        FontSize="12"/>
                                                            <TextBlock Grid.Column="1" Text="—"
                                                                       Margin="6,0" VerticalAlignment="Center"
                                                                       Foreground="#888780"/>
                                                            <DatePicker Grid.Column="2"
                                                                        SelectedDate="{Binding EntryDateTo}"
                                                                        FontSize="12"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                                <Button Content="Скинути фільтри"
                                                        Height="34" FontSize="13" Cursor="Hand"
                                                        Click="ResetEntryFilter_Click">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Background" Value="White"/>
                                                            <Setter Property="Foreground" Value="#5F5E5A"/>
                                                            <Setter Property="BorderBrush" Value="#D3D1C7"/>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="{TemplateBinding Background}"
                                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                                CornerRadius="6">
                                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                                              VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter Property="Background" Value="#FEF2F2"/>
                                                                                <Setter Property="Foreground" Value="#E24B4A"/>
                                                                                <Setter Property="BorderBrush" Value="#FECACA"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </StackPanel>

                            <!-- Фильтры для исследований -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsResearchTab}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Grid>
                                    <ui:Button x:Name="ResearchFilterButton"
                                               Click="ResearchFilterButton_Click"
                                               Height="32" Padding="10,0"
                                               Cursor="Hand" Appearance="Secondary"
                                               Icon="{ui:SymbolIcon Options24}">
                                        <TextBlock Text="Фільтри" FontSize="12"/>
                                    </ui:Button>
                                    <Popup x:Name="ResearchFilterPopup"
                                           PlacementTarget="{Binding ElementName=ResearchFilterButton}"
                                           Placement="Bottom"
                                           HorizontalOffset="-160"
                                           StaysOpen="False"
                                           AllowsTransparency="True">
                                        <Border Background="White" BorderBrush="#D3D1C7"
                                                BorderThickness="1" CornerRadius="8"
                                                MinWidth="240" Margin="0,6,0,0" Padding="16">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#000000" BlurRadius="16"
                                                                  ShadowDepth="2" Opacity="0.08"/>
                                            </Border.Effect>
                                            <StackPanel>
                                                <!-- Статус -->
                                                
                                                <!-- Дата -->
                                                <Border Background="#F8F9FA" CornerRadius="6"
                                                        Padding="12,10" Margin="0,0,0,12">
                                                    <StackPanel>
                                                        <TextBlock Text="ДАТА СТВОРЕННЯ" FontSize="11"
                                                                   FontWeight="SemiBold" Foreground="#888780"
                                                                   Margin="0,0,0,8"/>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <DatePicker Grid.Column="0"
                                                                        SelectedDate="{Binding ResearchDateFrom}"
                                                                        FontSize="12"/>
                                                            <TextBlock Grid.Column="1" Text="—"
                                                                       Margin="6,0" VerticalAlignment="Center"
                                                                       Foreground="#888780"/>
                                                            <DatePicker Grid.Column="2"
                                                                        SelectedDate="{Binding ResearchDateTo}"
                                                                        FontSize="12"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                                <Button Content="Скинути фільтри"
                                                        Height="34" FontSize="13" Cursor="Hand"
                                                        Click="ResetResearchFilter_Click">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Background" Value="White"/>
                                                            <Setter Property="Foreground" Value="#5F5E5A"/>
                                                            <Setter Property="BorderBrush" Value="#D3D1C7"/>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="{TemplateBinding Background}"
                                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                                CornerRadius="6">
                                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                                              VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter Property="Background" Value="#FEF2F2"/>
                                                                                <Setter Property="Foreground" Value="#E24B4A"/>
                                                                                <Setter Property="BorderBrush" Value="#FECACA"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- Разделитель под табами -->
                        <Border BorderBrush="#E0DEDB" BorderThickness="0,1,0,0" Margin="0,0,0,16"/>

                        <!-- Вкладка Записи -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRecordsTab}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <Border MinHeight="300">
                                <ItemsControl ItemsSource="{Binding CurrentEntries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#F1EFE8"
                                                BorderThickness="0,0,0,1" Padding="0,12">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="36"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Иконка -->
                                                        <Border Grid.Column="0"
                                                                Width="32" Height="32"
                                                                CornerRadius="8"
                                                                Background="{Binding IconColor}"
                                                                VerticalAlignment="Top">
                                                             <ui:SymbolIcon Symbol="Person24"
                                                                           FontSize="16"
                                                                           Foreground="#185FA5"/>
                                                        </Border>

                                                        <!-- Контент -->
                                                    <StackPanel Grid.Column="1" Margin="12,0">
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                            <TextBlock Text="{Binding EntryTypeDisplay}"
                                                                       FontSize="13" FontWeight="SemiBold"
                                                                       Foreground="#2C2C2A"/>
                                                            <TextBlock Text=" · " FontSize="13" Foreground="#888780"/>
                                                            <TextBlock Text="{Binding DoctorName}"
                                                                       FontSize="13" Foreground="#888780"/>
                                                            <TextBlock Text=", " FontSize="13" Foreground="#888780"/>
                                                            <TextBlock Text="{Binding Specialization}"
                                                                       FontSize="13" Foreground="#888780"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Complaints}"
                                                                   FontSize="12" Foreground="#5F5E5A"
                                                                   TextWrapping="Wrap"/>
                                                        <!-- Статус дослідження -->
                                                        <Border Background="{Binding ResearchStatusColor}"
                                                                CornerRadius="10" Padding="8,3"
                                                                Margin="0,4,0,0" HorizontalAlignment="Left"
                                                                Visibility="{Binding ResearchStatus, Converter={StaticResource NullToVisibility}}">
                                                            <TextBlock Text="{Binding ResearchStatus}"
                                                                       FontSize="11"
                                                                       Foreground="{Binding ResearchStatusTextColor}"/>
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- Дата -->
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding VisitDateDisplay}"
                                                               FontSize="12" Foreground="#888780"
                                                               VerticalAlignment="Top"
                                                               Margin="0,0,12,0"/>

                                                    <!-- Кнопка деталей -->
                                                    <Button Grid.Column="3"
                                                            Height="28" Padding="10,0"
                                                            Cursor="Hand" VerticalAlignment="Top"
                                                            Click="ToggleEntryDetails_Click"
                                                            Tag="{Binding}">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Background" Value="White"/>
                                                                <Setter Property="Foreground" Value="#5F5E5A"/>
                                                                <Setter Property="BorderBrush" Value="#D3D1C7"/>
                                                                <Setter Property="BorderThickness" Value="1"/>
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border Background="{TemplateBinding Background}"
                                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                                    CornerRadius="6">
                                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                                  VerticalAlignment="Center"
                                                                                                  Margin="{TemplateBinding Padding}"/>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter Property="Background" Value="#F1EFE8"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </Button.Style>
                                                        <StackPanel Orientation="Horizontal">
                                                            <ui:SymbolIcon Symbol="ChevronDown24"
                                                                           FontSize="12"
                                                                           Margin="0,0,4,0"/>
                                                            <TextBlock Text="Детальніше" FontSize="12"/>
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>

                                                <!-- Раскрытые детали -->
                                                <Border Margin="44,8,0,0"
                                                        Background="#F8F9FA"
                                                        CornerRadius="6"
                                                        Padding="14,10">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <!-- Скарги -->
                                                        <StackPanel Margin="0,0,0,8"
                                                                    Visibility="{Binding Complaints, Converter={StaticResource NullToVisibility}}">
                                                            <TextBlock Text="СКАРГИ" FontSize="10"
                                                                       FontWeight="SemiBold" Foreground="#888780"
                                                                       Margin="0,0,0,3"/>
                                                            <TextBlock Text="{Binding Complaints}"
                                                                       FontSize="13" Foreground="#2C2C2A"
                                                                       TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                        <!-- Висновок -->
                                                        <StackPanel Margin="0,0,0,8"
                                                                    Visibility="{Binding Conclusion, Converter={StaticResource NullToVisibility}}">
                                                            <TextBlock Text="ВИСНОВОК ЛІКАРЯ" FontSize="10"
                                                                       FontWeight="SemiBold" Foreground="#888780"
                                                                       Margin="0,0,0,3"/>
                                                            <TextBlock Text="{Binding Conclusion}"
                                                                       FontSize="13" Foreground="#2C2C2A"
                                                                       TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                        <!-- План лечения -->
                                                        <StackPanel Margin="0,0,0,8"
                                                                    Visibility="{Binding TreatmentPlan, Converter={StaticResource NullToVisibility}}">
                                                            <TextBlock Text="ПЛАН ЛІКУВАННЯ" FontSize="10"
                                                                       FontWeight="SemiBold" Foreground="#888780"
                                                                       Margin="0,0,0,3"/>
                                                            <TextBlock Text="{Binding TreatmentPlan}"
                                                                       FontSize="13" Foreground="#2C2C2A"
                                                                       TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                        <!-- Ссылка на исследование -->
                                                        <StackPanel Orientation="Horizontal"
                                                                    Visibility="{Binding LinkedResearchId, Converter={StaticResource NullToVisibility}}">
                                                            <ui:SymbolIcon Symbol="Link24"
                                                                           FontSize="13"
                                                                           Foreground="#185FA5"
                                                                           Margin="0,0,6,0"/>
                                                            <TextBlock FontSize="12" Foreground="#185FA5">
                                                                <Run Text="Дослідження:"/>
                                                                <Run Text="{Binding LinkedResearchType}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </Border>
                            <!-- Пагинация записей -->
                            <Grid Margin="0,16,0,0"
                                  Visibility="{Binding ShowEntryPagination, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="←" Click="PrevPage_Click"
                                            IsEnabled="{Binding CanGoPrev}"
                                            Width="30" Height="30" Margin="0,0,4,0" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="White"/>
                                                <Setter Property="Foreground" Value="#2C2C2A"/>
                                                <Setter Property="BorderBrush" Value="#D3D1C7"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                    CornerRadius="6">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsEnabled" Value="False">
                                                                    <Setter Property="Foreground" Value="#C0BEBC"/>
                                                                    <Setter Property="BorderBrush" Value="#EEECE8"/>
                                                                </Trigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#F1EFE8"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <ItemsControl x:Name="EntryPageButtons" ItemsSource="{Binding PageNumbers}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding}" Width="30" Height="30"
                                                        Margin="2,0" Cursor="Hand" Tag="{Binding}"
                                                        Click="EntryPageButton_Click">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Background" Value="White"/>
                                                            <Setter Property="Foreground" Value="#2C2C2A"/>
                                                            <Setter Property="BorderBrush" Value="#D3D1C7"/>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="{TemplateBinding Background}"
                                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                                CornerRadius="6">
                                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                                              VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter Property="Background" Value="#E6F1FB"/>
                                                                                <Setter Property="BorderBrush" Value="#185FA5"/>
                                                                                <Setter Property="Foreground" Value="#185FA5"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="→" Click="NextPage_Click"
                                            IsEnabled="{Binding CanGoNext}"
                                            Width="30" Height="30" Margin="4,0,0,0" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="White"/>
                                                <Setter Property="Foreground" Value="#2C2C2A"/>
                                                <Setter Property="BorderBrush" Value="#D3D1C7"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                    CornerRadius="6">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsEnabled" Value="False">
                                                                    <Setter Property="Foreground" Value="#C0BEBC"/>
                                                                    <Setter Property="BorderBrush" Value="#EEECE8"/>
                                                                </Trigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#F1EFE8"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                                <TextBlock Grid.Column="1" FontSize="12"
                                           Foreground="#888780" VerticalAlignment="Center">
                                    <Run Text="Сторінка"/>
                                    <Run Text="{Binding CurrentPage, Mode=OneWay}"/>
                                    <Run Text="з"/>
                                    <Run Text="{Binding TotalPages, Mode=OneWay}"/>
                                </TextBlock>
                            </Grid>
                        </StackPanel>

                        <!-- Вкладка Дослідження -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsResearchTab}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border MinHeight="300">
                                <ItemsControl ItemsSource="{Binding CurrentResearches}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#F1EFE8"
                                                BorderThickness="0,0,0,1" Padding="0,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Иконка -->
                                                <Border Grid.Column="0"
                                                        Width="32" Height="32"
                                                        CornerRadius="8"
                                                        Background="#E6F1FB"
                                                        VerticalAlignment="Top">
                                                    <ui:SymbolIcon Symbol="Microscope24"
                                                                   FontSize="16"
                                                                   Foreground="#185FA5"/>
                                                </Border>

                                                <!-- Контент -->
                                                <StackPanel Grid.Column="1" Margin="12,0">
                                                    <TextBlock Text="{Binding ResearchType}"
                                                               FontSize="13" FontWeight="SemiBold"
                                                               Foreground="#2C2C2A" Margin="0,0,0,2"/>
                                                    <TextBlock FontSize="12" Foreground="#888780">
                                                        <Run Text="Створено:"/>
                                                        <Run Text="{Binding CreatedAtDisplay, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Results}"
                                                               FontSize="12" Foreground="#5F5E5A"
                                                               TextWrapping="Wrap" Margin="0,4,0,0"
                                                               Visibility="{Binding Results, Converter={StaticResource NullToVisibility}}"/>
                                                </StackPanel>

                                                <!-- Статус -->
                                                <Border Grid.Column="2"
                                                        Background="{Binding StatusColor}"
                                                        CornerRadius="10" Padding="10,4"
                                                        Margin="0,0,12,0" VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding StatusDisplay}"
                                                               FontSize="12"
                                                               Foreground="{Binding StatusTextColor}"/>
                                                </Border>

                                                <!-- Кнопка обработать -->
                                                <Button Grid.Column="3"
                                                        Height="28" Padding="10,0"
                                                        Cursor="Hand" VerticalAlignment="Top"
                                                        Tag="{Binding}"
                                                        Click="ProcessResearch_Click">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Setter Property="Background" Value="#FAEEDA"/>
                                                            <Setter Property="Foreground" Value="#854F0B"/>
                                                            <Setter Property="BorderThickness" Value="0"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="{TemplateBinding Background}"
                                                                                CornerRadius="6">
                                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                                              VerticalAlignment="Center"
                                                                                              Margin="{TemplateBinding Padding}"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter Property="Background" Value="#F5D9A8"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding NeedsProcessing}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon Symbol="Play24"
                                                                       FontSize="12"
                                                                       Margin="0,0,4,0"/>
                                                        <TextBlock Text="Обробити" FontSize="12"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </Border>

                            <!-- Пагинация исследований -->
                            <Grid Margin="0,16,0,0"
                                         Visibility="{Binding ShowResearchPagination, Converter={StaticResource BoolToVisibility}}">
                                                         <Grid.ColumnDefinitions>
                                                             <ColumnDefinition Width="*"/>
                                                             <ColumnDefinition Width="Auto"/>
                                                         </Grid.ColumnDefinitions>
                                                         <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                       <Button Content="←" Click="ResearchPrevPage_Click"
                                                   IsEnabled="{Binding CanGoResearchPrev}"
                                                   Width="30" Height="30" Margin="0,0,4,0" Cursor="Hand">
                                                                           <Button.Style>
                                                                               <Style TargetType="Button">
                                                                                   <Setter Property="Background" Value="White"/>
                                                                                   <Setter Property="Foreground" Value="#2C2C2A"/>
                                                                                   <Setter Property="BorderBrush" Value="#D3D1C7"/>
                                                                                   <Setter Property="BorderThickness" Value="1"/>
                                                                                   <Setter Property="Template">
                                                                                       <Setter.Value>
                                                                                           <ControlTemplate TargetType="Button">
                                                                                               <Border Background="{TemplateBinding Background}"
                                                                           BorderBrush="{TemplateBinding BorderBrush}"
                                                                           BorderThickness="{TemplateBinding BorderThickness}"
                                                                           CornerRadius="6">
                                                                                                   <ContentPresenter HorizontalAlignment="Center"
                                                                                         VerticalAlignment="Center"/>
                                                                                               </Border>
                                                                                               <ControlTemplate.Triggers>
                                                                                                   <Trigger Property="IsEnabled" Value="False">
                                                                                                       <Setter Property="Foreground" Value="#C0BEBC"/>
                                                                                                       <Setter Property="BorderBrush" Value="#EEECE8"/>
                                                                                                   </Trigger>
                                                                                                   <Trigger Property="IsMouseOver" Value="True">
                                                                                                       <Setter Property="Background" Value="#F1EFE8"/>
                                                                                                   </Trigger>
                                                                                               </ControlTemplate.Triggers>
                                                                                           </ControlTemplate>
                                                                                       </Setter.Value>
                                                                                   </Setter>
                                                                               </Style>
                                                                           </Button.Style>
                                                                       </Button>
                                                                       <ItemsControl x:Name="ResearchPageButtons" ItemsSource="{Binding ResearchPageNumbers}">
                                                                           <ItemsControl.ItemsPanel>
                                                                               <ItemsPanelTemplate>
                                                                                   <StackPanel Orientation="Horizontal"/>
                                                                               </ItemsPanelTemplate>
                                                                           </ItemsControl.ItemsPanel>
                                                                           <ItemsControl.ItemTemplate>
                                                                               <DataTemplate>
                                                                                   <Button Content="{Binding}" Width="30" Height="30"
                                                               Margin="2,0" Cursor="Hand" Tag="{Binding}"
                                                               Click="ResearchPageButton_Click">
                                                                                       <Button.Style>
                                                                                           <Style TargetType="Button">
                                                                                               <Setter Property="Background" Value="White"/>
                                                                                               <Setter Property="Foreground" Value="#2C2C2A"/>
                                                                                               <Setter Property="BorderBrush" Value="#D3D1C7"/>
                                                                                               <Setter Property="BorderThickness" Value="1"/>
                                                                                               <Setter Property="Template">
                                                                                                   <Setter.Value>
                                                                                                       <ControlTemplate TargetType="Button">
                                                                                                           <Border Background="{TemplateBinding Background}"
                                                                                       BorderBrush="{TemplateBinding BorderBrush}"
                                                                                       BorderThickness="{TemplateBinding BorderThickness}"
                                                                                       CornerRadius="6">
                                                                                                               <ContentPresenter HorizontalAlignment="Center"
                                                                                                     VerticalAlignment="Center"/>
                                                                                                           </Border>
                                                                                                           <ControlTemplate.Triggers>
                                                                                                               <Trigger Property="IsMouseOver" Value="True">
                                                                                                                   <Setter Property="Background" Value="#E6F1FB"/>
                                                                                                                   <Setter Property="BorderBrush" Value="#185FA5"/>
                                                                                                                   <Setter Property="Foreground" Value="#185FA5"/>
                                                                                                               </Trigger>
                                                                                                           </ControlTemplate.Triggers>
                                                                                                       </ControlTemplate>
                                                                                                   </Setter.Value>
                                                                                               </Setter>
                                                                                           </Style>
                                                                                       </Button.Style>
                                                                                   </Button>
                                                                               </DataTemplate>
                                                                           </ItemsControl.ItemTemplate>
                                                                       </ItemsControl>
                                                                       <Button Content="→" Click="ResearchNextPage_Click"
                                                   IsEnabled="{Binding CanGoResearchNext}"
                                                   Width="30" Height="30" Margin="4,0,0,0" Cursor="Hand">
                                                                           <Button.Style>
                                                                               <Style TargetType="Button">
                                                                                   <Setter Property="Background" Value="White"/>
                                                                                   <Setter Property="Foreground" Value="#2C2C2A"/>
                                                                                   <Setter Property="BorderBrush" Value="#D3D1C7"/>
                                                                                   <Setter Property="BorderThickness" Value="1"/>
                                                                                   <Setter Property="Template">
                                                                                       <Setter.Value>
                                                                                           <ControlTemplate TargetType="Button">
                                                                                               <Border Background="{TemplateBinding Background}"
                                                                           BorderBrush="{TemplateBinding BorderBrush}"
                                                                           BorderThickness="{TemplateBinding BorderThickness}"
                                                                           CornerRadius="6">
                                                                                                   <ContentPresenter HorizontalAlignment="Center"
                                                                                         VerticalAlignment="Center"/>
                                                                                               </Border>
                                                                                               <ControlTemplate.Triggers>
                                                                                                   <Trigger Property="IsEnabled" Value="False">
                                                                                                       <Setter Property="Foreground" Value="#C0BEBC"/>
                                                                                                       <Setter Property="BorderBrush" Value="#EEECE8"/>
                                                                                                   </Trigger>
                                                                                                   <Trigger Property="IsMouseOver" Value="True">
                                                                                                       <Setter Property="Background" Value="#F1EFE8"/>
                                                                                                   </Trigger>
                                                                                               </ControlTemplate.Triggers>
                                                                                           </ControlTemplate>
                                                                                       </Setter.Value>
                                                                                   </Setter>
                                                                               </Style>
                                                                           </Button.Style>
                                                                       </Button>
                                                                   </StackPanel>
                                                                   <TextBlock Grid.Column="1" FontSize="12" Foreground="#888780" VerticalAlignment="Center">
                                           <Run Text="Сторінка"/>
                                           <Run Text="{Binding ResearchCurrentPage, Mode=OneWay}"/>
                                           <Run Text="з"/>
                                           <Run Text="{Binding ResearchTotalPages, Mode=OneWay}"/>
                                </TextBlock>
                            </Grid>
                        </StackPanel>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>