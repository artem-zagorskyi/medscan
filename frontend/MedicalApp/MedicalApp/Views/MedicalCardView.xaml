<UserControl x:Class="MedicalApp.Views.MedicalCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:MedicalApp.ViewModels">

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="White"
                BorderBrush="#E0DEDB" BorderThickness="0,0,0,1"
                Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ui:Button Grid.Column="0"
                           Click="BackButton_Click"
                           Height="36" Padding="12,0"
                           Cursor="Hand" Margin="0,0,16,0"
                           Appearance="Secondary"
                           Icon="{ui:SymbolIcon ArrowLeft24}">
                    <TextBlock Text="Назад" FontSize="13"/>
                </ui:Button>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Patient.FullName}"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="#2C2C2A"/>
                    <TextBlock FontSize="12" Foreground="#888780">
                        <Run Text="Медична картка ·"/>
                        <Run Text="{Binding Patient.AgeLabel, Mode=OneWay}"/>
                        <Run Text="·"/>
                        <Run Text="{Binding Patient.GenderDisplay, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>

                <ui:Button Grid.Column="2"
                           Click="NewRecordButton_Click"
                           Height="36" Padding="14,0"
                           Cursor="Hand" Margin="0,0,8,0"
                           Appearance="Secondary"
                           Icon="{ui:SymbolIcon Add24}">
                    <TextBlock Text="Новий запис" FontSize="13"/>
                </ui:Button>

                <ui:Button Grid.Column="3"
                            Click="EditButton_Click"
                            Height="36" Padding="14,0"
                            Cursor="Hand"
                            Background="#185FA5"
                            Foreground="White"
                            MouseOverBackground="#1A6FB8"
                            PressedBackground="#0C447C"
                            Icon="{ui:SymbolIcon Edit24}">
                    <TextBlock Text="Редагувати" FontSize="13"/>
                </ui:Button>
            </Grid>
        </Border>

        <!-- Контент -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20">

                <!-- Основна інформація -->
                <Border Background="White" BorderBrush="#E0DEDB"
                        BorderThickness="1" CornerRadius="8"
                        Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="ОСНОВНА ІНФОРМАЦІЯ"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="#888780" Margin="0,0,0,14"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="ДАТА НАРОДЖЕННЯ" FontSize="10"
                                           Foreground="#888780" Margin="0,0,0,3"/>
                                <TextBlock Text="{Binding Patient.BirthDate, StringFormat=dd.MM.yyyy}"
                                           FontSize="13" Foreground="#2C2C2A" FontWeight="Medium"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="ВІК" FontSize="10"
                                           Foreground="#888780" Margin="0,0,0,3"/>
                                <TextBlock Text="{Binding Patient.AgeLabel, Mode=OneWay}"
                                           FontSize="13" Foreground="#2C2C2A" FontWeight="Medium"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="СТАТЬ" FontSize="10"
                                           Foreground="#888780" Margin="0,0,0,3"/>
                                <TextBlock Text="{Binding Patient.GenderDisplay}"
                                           FontSize="13" Foreground="#2C2C2A" FontWeight="Medium"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="ТЕЛЕФОН" FontSize="10"
                                           Foreground="#888780" Margin="0,0,0,3"/>
                                <TextBlock Text="{Binding ContactInfo}"
                                           FontSize="13" Foreground="#2C2C2A" FontWeight="Medium"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="АДРЕСА" FontSize="10"
                                           Foreground="#888780" Margin="0,0,0,3"/>
                                <TextBlock Text="{Binding Address}"
                                           FontSize="12" Foreground="#2C2C2A"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Медичні дані -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Група крові -->
                    <Border Grid.Column="0" Background="White"
                            BorderBrush="#E0DEDB" BorderThickness="1"
                            CornerRadius="8" Padding="20">
                        <StackPanel>
                            <TextBlock Text="ГРУПА КРОВІ ТА РЕЗУС"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="#888780" Margin="0,0,0,14"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#F5F8FF"
                                        CornerRadius="6" Padding="12" Margin="0,0,6,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding BloodGroup}"
                                                   FontSize="20" FontWeight="SemiBold"
                                                   Foreground="#185FA5" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Група крові" FontSize="11"
                                                   Foreground="#888780" HorizontalAlignment="Center"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="#F5F8FF"
                                        CornerRadius="6" Padding="12" Margin="6,0,0,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding RhFactor}"
                                                   FontSize="20" FontWeight="SemiBold"
                                                   Foreground="#185FA5" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Резус" FontSize="11"
                                                   Foreground="#888780" HorizontalAlignment="Center"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Рост/Вес -->
                    <Border Grid.Column="2" Background="White"
                            BorderBrush="#E0DEDB" BorderThickness="1"
                            CornerRadius="8" Padding="20">
                        <StackPanel>
                            <TextBlock Text="АНТРОПОМЕТРІЯ"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="#888780" Margin="0,0,0,14"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#F5F8FF"
                                        CornerRadius="6" Padding="12" Margin="0,0,6,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Height}"
                                                   FontSize="18" FontWeight="SemiBold"
                                                   Foreground="#185FA5" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Зріст" FontSize="11"
                                                   Foreground="#888780" HorizontalAlignment="Center"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="#F5F8FF"
                                        CornerRadius="6" Padding="12" Margin="6,0,0,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Weight}"
                                                   FontSize="18" FontWeight="SemiBold"
                                                   Foreground="#185FA5" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Вага" FontSize="11"
                                                   Foreground="#888780" HorizontalAlignment="Center"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Алергії -->
                    <Border Grid.Column="4" Background="White"
                            BorderBrush="#E0DEDB" BorderThickness="1"
                            CornerRadius="8" Padding="20">
                        <StackPanel>
                            <TextBlock Text="АЛЕРГІЇ" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#888780" Margin="0,0,0,14"/>
                            <ItemsControl ItemsSource="{Binding Allergies}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding SeverityColor}"
                                                CornerRadius="12" Padding="10,5" Margin="0,0,6,6">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="12"
                                                           Foreground="{Binding SeverityTextColor}"
                                                           FontWeight="Medium"/>
                                                <TextBlock Text=" · " FontSize="12"
                                                           Foreground="{Binding SeverityTextColor}"/>
                                                <TextBlock Text="{Binding Severity}" FontSize="12"
                                                           Foreground="{Binding SeverityTextColor}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- Алергії — порожній стан -->
                            <TextBlock Text="Алергій не виявлено"
                                        FontSize="12" Foreground="#888780"
                                        FontStyle="Italic">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Allergies.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Діагнози -->
                <Border Background="White" BorderBrush="#E0DEDB"
                        BorderThickness="1" CornerRadius="8"
                        Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock FontSize="11" FontWeight="SemiBold"
                                   Foreground="#888780" Margin="0,0,0,14">
                            <Run Text="ДІАГНОЗИ ·"/>
                            <Run Text="{Binding Diagnoses.Count, Mode=OneWay}"/>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding Diagnoses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#F1EFE8"
                                            BorderThickness="0,0,0,1" Padding="0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#F1EFE8"
                                                    CornerRadius="4" Padding="6,3"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding IcdCode}" FontSize="12"
                                                           Foreground="#5F5E5A" FontWeight="Medium"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                       FontSize="13" FontWeight="Medium"
                                                       Foreground="#2C2C2A" VerticalAlignment="Center"
                                                       Margin="12,0"/>
                                            <Border Grid.Column="2" Background="{Binding StatusColor}"
                                                    CornerRadius="10" Padding="10,4"
                                                    Margin="0,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Status}" FontSize="12"
                                                           Foreground="{Binding StatusTextColor}"/>
                                            </Border>
                                            <TextBlock Grid.Column="3" Text="{Binding DiagnosedAtDisplay}"
                                                       FontSize="12" Foreground="#888780"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- Діагнози — порожній стан -->
                        <TextBlock Text="Діагнозів не встановлено"
                                    FontSize="12" Foreground="#888780"
                                    FontStyle="Italic">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Diagnoses.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Вкладки: Кейси / Дослідження -->
                <Border Background="White" BorderBrush="#E0DEDB"
                        BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel>

                        <!-- Таб-бар -->
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <!-- Таб Кейси -->
                                <Button Click="RecordsTab_Click" Height="34" Padding="16,0" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"
                                                                              Margin="{TemplateBinding Padding}"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRecordsTab}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#185FA5"/>
                                                    <Setter Property="Foreground" Value="#185FA5"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsRecordsTab}" Value="False">
                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                    <Setter Property="Foreground" Value="#888780"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Folder24" FontSize="14" Margin="0,0,6,0"/>
                                        <TextBlock FontSize="13" FontWeight="Medium">
                                            <Run Text="Кейси ·"/>
                                            <Run Text="{Binding TotalCases, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>

                                <!-- Таб Дослідження -->
                                <Button Click="ResearchTab_Click" Height="34" Padding="16,0" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"
                                                                              Margin="{TemplateBinding Padding}"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsResearchTab}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#185FA5"/>
                                                    <Setter Property="Foreground" Value="#185FA5"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsResearchTab}" Value="False">
                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                    <Setter Property="Foreground" Value="#888780"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Microscope24" FontSize="14" Margin="0,0,6,0"/>
                                        <TextBlock FontSize="13" FontWeight="Medium">
                                            <Run Text="Дослідження ·"/>
                                            <Run Text="{Binding TotalResearches, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Кнопка нового кейсу + фільтри -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsResearchTab}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <ui:Button Click="NewCaseButton_Click"
                                           Height="32" Padding="10,0"
                                           Cursor="Hand" Appearance="Secondary"
                                           Icon="{ui:SymbolIcon Add24}"
                                           Margin="0,0,8,0">
                                    <TextBlock Text="Новий кейс" FontSize="12"/>
                                </ui:Button>
                                <Grid>
                                    <ui:Button x:Name="CaseFilterButton"
                                               Click="CaseFilterButton_Click"
                                               Height="32" Padding="10,0"
                                               Cursor="Hand" Appearance="Secondary"
                                               Icon="{ui:SymbolIcon Options24}">
                                        <TextBlock Text="Фільтри" FontSize="12"/>
                                    </ui:Button>
                                    <Popup x:Name="CaseFilterPopup"
                                           PlacementTarget="{Binding ElementName=CaseFilterButton}"
                                           Placement="Bottom" HorizontalOffset="-120"
                                           StaysOpen="False" AllowsTransparency="True">
                                        <Border Background="White" BorderBrush="#D3D1C7"
                                                BorderThickness="1" CornerRadius="8"
                                                MinWidth="200" Margin="0,6,0,0" Padding="16">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#000000" BlurRadius="16"
                                                                  ShadowDepth="2" Opacity="0.08"/>
                                            </Border.Effect>
                                            <StackPanel>
                                                <Border Background="#F8F9FA" CornerRadius="6"
                                                        Padding="12,10" Margin="0,0,0,12">
                                                    <StackPanel>
                                                        <TextBlock Text="СТАТУС КЕЙСУ" FontSize="11"
                                                                   FontWeight="SemiBold" Foreground="#888780"
                                                                   Margin="0,0,0,8"/>
                                                        <ComboBox ItemsSource="{Binding CaseStatusOptions}"
                                                                  SelectedItem="{Binding SelectedCaseStatus}"
                                                                  FontSize="13"/>
                                                    </StackPanel>
                                                </Border>
                                                <Button Content="Скинути фільтри"
                                                        Height="34" FontSize="13" Cursor="Hand"
                                                        Click="ResetCaseFilter_Click">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Background" Value="White"/>
                                                            <Setter Property="Foreground" Value="#5F5E5A"/>
                                                            <Setter Property="BorderBrush" Value="#D3D1C7"/>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="{TemplateBinding Background}"
                                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                                CornerRadius="6">
                                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                                              VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter Property="Background" Value="#FEF2F2"/>
                                                                                <Setter Property="Foreground" Value="#E24B4A"/>
                                                                                <Setter Property="BorderBrush" Value="#FECACA"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </StackPanel>

                            <!-- Фільтри досліджень -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" >
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsResearchTab}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Grid>
                                    <ui:Button x:Name="ResearchFilterButton"
                                               Click="ResearchFilterButton_Click"
                                               Height="32" Padding="10,0"
                                               Cursor="Hand" Appearance="Secondary"
                                               Icon="{ui:SymbolIcon Options24}">
                                        <TextBlock Text="Фільтри" FontSize="12"/>
                                    </ui:Button>
                                    <Popup x:Name="ResearchFilterPopup"
                                           PlacementTarget="{Binding ElementName=ResearchFilterButton}"
                                           Placement="Bottom" HorizontalOffset="-160"
                                           StaysOpen="False" AllowsTransparency="True">
                                        <Border Background="White" BorderBrush="#D3D1C7"
                                                BorderThickness="1" CornerRadius="8"
                                                MinWidth="240" Margin="0,6,0,0" Padding="16">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#000000" BlurRadius="16"
                                                                  ShadowDepth="2" Opacity="0.08"/>
                                            </Border.Effect>
                                            <StackPanel>
                                                <Border Background="#F8F9FA" CornerRadius="6"
                                                        Padding="12,10" Margin="0,0,0,8">
                                                    <StackPanel>
                                                        <TextBlock Text="СТАТУС" FontSize="11"
                                                                   FontWeight="SemiBold" Foreground="#888780"
                                                                   Margin="0,0,0,8"/>
                                                        <ComboBox ItemsSource="{Binding ResearchStatusOptions}"
                                                                  SelectedItem="{Binding SelectedResearchStatus}"
                                                                  FontSize="13"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="#F8F9FA" CornerRadius="6"
                                                        Padding="12,10" Margin="0,0,0,12">
                                                    <StackPanel>
                                                        <TextBlock Text="ДАТА СТВОРЕННЯ" FontSize="11"
                                                                   FontWeight="SemiBold" Foreground="#888780"
                                                                   Margin="0,0,0,8"/>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <DatePicker Grid.Column="0"
                                                                        SelectedDate="{Binding ResearchDateFrom}"
                                                                        FontSize="12"/>
                                                            <TextBlock Grid.Column="1" Text="—"
                                                                       Margin="6,0" VerticalAlignment="Center"
                                                                       Foreground="#888780"/>
                                                            <DatePicker Grid.Column="2"
                                                                        SelectedDate="{Binding ResearchDateTo}"
                                                                        FontSize="12"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                                <Button Content="Скинути фільтри"
                                                        Height="34" FontSize="13" Cursor="Hand"
                                                        Click="ResetResearchFilter_Click">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Background" Value="White"/>
                                                            <Setter Property="Foreground" Value="#5F5E5A"/>
                                                            <Setter Property="BorderBrush" Value="#D3D1C7"/>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="{TemplateBinding Background}"
                                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                                CornerRadius="6">
                                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                                              VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter Property="Background" Value="#FEF2F2"/>
                                                                                <Setter Property="Foreground" Value="#E24B4A"/>
                                                                                <Setter Property="BorderBrush" Value="#FECACA"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- Разделитель -->
                        <Border BorderBrush="#E0DEDB" BorderThickness="0,1,0,0" Margin="0,8,0,16"/>

                        <!-- Вкладка Кейси -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRecordsTab}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <Border MinHeight="300">
                                <ItemsControl ItemsSource="{Binding CurrentCases}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="White"
                                                    BorderBrush="#E0DEDB"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Margin="0,0,0,8">
                                                <StackPanel>
                                                    <!-- Заголовок кейсу -->
                                                    <Button Click="ToggleCase_Click"
                                                            Tag="{Binding}"
                                                            Cursor="Hand">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Background" Value="Transparent"/>
                                                                <Setter Property="BorderThickness" Value="0"/>
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border Background="{TemplateBinding Background}"
                                                                                    CornerRadius="8,8,0,0"
                                                                                    Padding="16,14">
                                                                                <ContentPresenter/>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter Property="Background" Value="#F8F9FA"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </Button.Style>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Іконка статусу -->
                                                            <Border Grid.Column="0"
                                                                    Width="32" Height="32"
                                                                    CornerRadius="8"
                                                                    Background="{Binding StatusColor}"
                                                                    Margin="0,0,12,0">
                                                                <ui:SymbolIcon Symbol="Folder24"
                                                                               FontSize="16"
                                                                               Foreground="{Binding StatusTextColor}"/>
                                                            </Border>

                                                            <!-- Назва та дата -->
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding MainCondition}"
                                                                           FontSize="14" FontWeight="SemiBold"
                                                                           Foreground="#2C2C2A"/>
                                                                <TextBlock Text="{Binding DateRangeDisplay, Mode=OneWay}"
                                                                        FontSize="12" Foreground="#888780"/>
                                                            </StackPanel>
                                                            
                                                            

                                                            <!-- Кількість записів -->
                                                            <Border Grid.Column="2"
                                                                    Background="#E6F1FB"
                                                                    CornerRadius="12"
                                                                    Padding="8,4"
                                                                    Margin="0,0,8,0"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock FontSize="12" Foreground="#185FA5">
                                                                    <Run Text="{Binding RecordsCount}"/>
                                                                    <Run Text="записів"/>
                                                                </TextBlock>
                                                            </Border>

                                                            <!-- Статус -->
                                                            <Border Grid.Column="3"
                                                                    Background="{Binding StatusColor}"
                                                                    CornerRadius="12"
                                                                    Padding="8,4"
                                                                    Margin="0,0,12,0"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding StatusDisplay}"
                                                                           FontSize="12"
                                                                           Foreground="{Binding StatusTextColor}"/>
                                                            </Border>

                                                            <!-- Стрілка -->
                                                            <ui:SymbolIcon Grid.Column="4"
                                                                           FontSize="14"
                                                                           Foreground="#888780">
                                                                <ui:SymbolIcon.Style>
                                                                    <Style TargetType="ui:SymbolIcon">
                                                                        <Setter Property="Symbol" Value="ChevronDown24"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                                <Setter Property="Symbol" Value="ChevronUp24"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ui:SymbolIcon.Style>
                                                            </ui:SymbolIcon>
                                                        </Grid>
                                                    </Button>

                                                    <!-- Записи кейсу -->
                                                    <Border Padding="16,0,16,16">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel>
                                                            <Border BorderBrush="#E0DEDB"
                                                                    BorderThickness="0,1,0,0"
                                                                    Margin="0,0,0,12"/>

                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                                <!-- Кнопка нового запису в кейс -->
                                                                <Button Click="NewRecordInCase_Click"
                                                                        Tag="{Binding}"
                                                                        HorizontalAlignment="Left"
                                                                        Height="30" Padding="10,0"
                                                                        Cursor="Hand" Margin="0,0,8,0">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Setter Property="Background" Value="#E6F1FB"/>
                                                                            <Setter Property="Foreground" Value="#185FA5"/>
                                                                            <Setter Property="BorderThickness" Value="0"/>
                                                                            <Setter Property="Template">
                                                                                <Setter.Value>
                                                                                    <ControlTemplate TargetType="Button">
                                                                                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                                                    VerticalAlignment="Center"
                                                                                                    Margin="{TemplateBinding Padding}"/>
                                                                                        </Border>
                                                                                        <ControlTemplate.Triggers>
                                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                                <Setter Property="Background" Value="#B5D4F4"/>
                                                                                            </Trigger>
                                                                                        </ControlTemplate.Triggers>
                                                                                    </ControlTemplate>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Status}" Value="OPEN">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <ui:SymbolIcon Symbol="Add24" FontSize="12" Margin="0,0,4,0"/>
                                                                        <TextBlock Text="Додати запис" FontSize="12"/>
                                                                    </StackPanel>
                                                                </Button>
                                                                <!-- Кнопка закриття кейсу — тільки для відкритих -->
                                                                <Button Click="CloseCase_Click"
                                                                                Tag="{Binding}"
                                                                                HorizontalAlignment="Left"
                                                                                
                                                                                Height="30" Padding="10,0"
                                                                                Cursor="Hand">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Setter Property="Background" Value="#FCEBEB"/>
                                                                            <Setter Property="Foreground" Value="#A32D2D"/>
                                                                            <Setter Property="BorderThickness" Value="0"/>
                                                                            <Setter Property="Template">
                                                                                <Setter.Value>
                                                                                    <ControlTemplate TargetType="Button">
                                                                                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                                                    VerticalAlignment="Center"
                                                                                                    Margin="{TemplateBinding Padding}"/>
                                                                                        </Border>
                                                                                        <ControlTemplate.Triggers>
                                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                                <Setter Property="Background" Value="#F5CCCC"/>
                                                                                            </Trigger>
                                                                                        </ControlTemplate.Triggers>
                                                                                    </ControlTemplate>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Status}" Value="OPEN">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <ui:SymbolIcon Symbol="LockClosed24" FontSize="12" Margin="0,0,4,0"/>
                                                                        <TextBlock Text="Закрити кейс" FontSize="12"/>
                                                                    </StackPanel>
                                                                </Button>

                                                                <!-- Кнопка відновлення кейсу — тільки для закритих -->
                                                                <Button Click="ReopenCase_Click"
                                                                             Tag="{Binding}"
                                                                             HorizontalAlignment="Left"
                                                                             Height="30" Padding="10,0"
                                                                             Cursor="Hand">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Setter Property="Background" Value="#E6F1FB"/>
                                                                            <Setter Property="Foreground" Value="#185FA5"/>
                                                                            <Setter Property="BorderThickness" Value="0"/>
                                                                            <Setter Property="Template">
                                                                                <Setter.Value>
                                                                                    <ControlTemplate TargetType="Button">
                                                                                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                                            VerticalAlignment="Center"
                                                                                            Margin="{TemplateBinding Padding}"/>
                                                                                        </Border>
                                                                                        <ControlTemplate.Triggers>
                                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                                <Setter Property="Background" Value="#B5D4F4"/>
                                                                                            </Trigger>
                                                                                        </ControlTemplate.Triggers>
                                                                                    </ControlTemplate>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Status}" Value="CLOSED">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <ui:SymbolIcon Symbol="LockOpen24" FontSize="12" Margin="0,0,4,0"/>
                                                                        <TextBlock Text="Відновити кейс" FontSize="12"/>
                                                                    </StackPanel>
                                                                </Button>
                                                            </StackPanel>

                                               

                                                            <!-- Список записів -->
                                                            <ItemsControl ItemsSource="{Binding Records}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border BorderBrush="#F1EFE8"
                                                                                BorderThickness="0,0,0,1"
                                                                                Padding="0,10">
                                                                            <StackPanel>
                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="32"/>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                    </Grid.ColumnDefinitions>

                                                                                    <!-- Іконка -->
                                                                                    <Border Grid.Column="0"
                                                                                            Width="32" Height="32"
                                                                                            CornerRadius="8"
                                                                                            VerticalAlignment="Top">
                                                                                        <Border.Style>
                                                                                            <Style TargetType="Border">
                                                                                                <Setter Property="Background" Value="#E6F1FB"/>
                                                                                                <Style.Triggers>
                                                                                                    <DataTrigger Binding="{Binding IsSigned}" Value="False">
                                                                                                        <Setter Property="Background" Value="#FDEBD0"/>
                                                                                                    </DataTrigger>
                                                                                                </Style.Triggers>
                                                                                            </Style>
                                                                                        </Border.Style>
                                                                                        <ui:SymbolIcon Symbol="ClipboardTextLtr24" FontSize="16">
                                                                                            <ui:SymbolIcon.Style>
                                                                                                <Style TargetType="ui:SymbolIcon">
                                                                                                    <Setter Property="Foreground" Value="#185FA5"/>
                                                                                                    <Style.Triggers>
                                                                                                        <DataTrigger Binding="{Binding IsSigned}" Value="False">
                                                                                                            <Setter Property="Foreground" Value="#C0552A"/>
                                                                                                        </DataTrigger>
                                                                                                    </Style.Triggers>
                                                                                                </Style>
                                                                                            </ui:SymbolIcon.Style>
                                                                                        </ui:SymbolIcon>
                                                                                    </Border>

                                                                                    <!-- Контент -->
                                                                                    <StackPanel Grid.Column="1" Margin="10,0">
                                                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                                                            <TextBlock Text="{Binding EntryTypeDisplay}"
                                                                                                       FontSize="13" FontWeight="SemiBold"
                                                                                                       Foreground="#2C2C2A"/>
                                                                                            <TextBlock Text=" · " FontSize="12" Foreground="#888780"/>
                                                                                            <TextBlock Text="{Binding DoctorName}"
                                                                                                       FontSize="12" Foreground="#888780"/>
                                                                                        </StackPanel>
                                                                                        <TextBlock Text="{Binding Complaints}"
                                                                                                   FontSize="12" Foreground="#5F5E5A"
                                                                                                   TextWrapping="Wrap"/>
                                                                                        
                                                                                        <!-- Чернетка + Дослідження в один рядок -->
                                                                                        <WrapPanel Margin="0,4,0,0">
                                                                                            <!-- Чернетка -->
                                                                                            <Border Background="#FDEBD0" CornerRadius="8" Padding="6,2"
                                                                                                                            Margin="0,0,6,4">
                                                                                                <Border.Style>
                                                                                                    <Style TargetType="Border">
                                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                        <Style.Triggers>
                                                                                                            <DataTrigger Binding="{Binding IsSigned}" Value="False">
                                                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                                            </DataTrigger>
                                                                                                        </Style.Triggers>
                                                                                                    </Style>
                                                                                                </Border.Style>
                                                                                                <TextBlock Text="Чернетка" FontSize="11" Foreground="#C0552A"/>
                                                                                            </Border>

                                                                                            <!-- Дослідження -->
                                                                                            <ItemsControl ItemsSource="{Binding Researches}">
                                                                                                <ItemsControl.ItemsPanel>
                                                                                                    <ItemsPanelTemplate>
                                                                                                        <WrapPanel/>
                                                                                                    </ItemsPanelTemplate>
                                                                                                </ItemsControl.ItemsPanel>
                                                                                                <ItemsControl.ItemTemplate>
                                                                                                    <DataTemplate>
                                                                                                        <Button Tag="{Binding}"
                                                                                                                Click="ViewRecordResearch_Click"
                                                                                                                Margin="0,0,6,4"
                                                                                                                Cursor="Hand">
                                                                                                            <Button.Style>
                                                                                                                <Style TargetType="Button">
                                                                                                                    <Setter Property="Background" Value="#E6F1FB"/>
                                                                                                                    <Setter Property="BorderThickness" Value="0"/>
                                                                                                                    <Setter Property="Template">
                                                                                                                        <Setter.Value>
                                                                                                                            <ControlTemplate TargetType="Button">
                                                                                                                                <Border Background="{TemplateBinding Background}"
                                                                                                                                        CornerRadius="8" Padding="8,3">
                                                                                                                                    <ContentPresenter/>
                                                                                                                                </Border>
                                                                                                                                <ControlTemplate.Triggers>
                                                                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                                                                        <Setter Property="Background" Value="#B5D4F4"/>
                                                                                                                                    </Trigger>
                                                                                                                                </ControlTemplate.Triggers>
                                                                                                                            </ControlTemplate>
                                                                                                                        </Setter.Value>
                                                                                                                    </Setter>
                                                                                                                </Style>
                                                                                                            </Button.Style>
                                                                                                            <StackPanel Orientation="Horizontal">
                                                                                                                <ui:SymbolIcon Symbol="Microscope24" FontSize="11"
                                                                                                                                Foreground="#185FA5" Margin="0,0,4,0"/>
                                                                                                                <TextBlock Text="{Binding Research.ResearchType, Mode=OneWay}"
                                                                                                                                            FontSize="11" Foreground="#185FA5"/>
                                                                                                            </StackPanel>
                                                                                                        </Button>
                                                                                                    </DataTemplate>
                                                                                                </ItemsControl.ItemTemplate>
                                                                                            </ItemsControl>
                                                                                        </WrapPanel>
                                                                                    </StackPanel>

                                                                                    <!-- Дата -->
                                                                                    <TextBlock Grid.Column="2"
                                                                                               Text="{Binding VisitDateDisplay}"
                                                                                               FontSize="12" Foreground="#888780"
                                                                                               VerticalAlignment="Top"
                                                                                               Margin="0,0,10,0"/>

                                                                                    <!-- Кнопка редагування — тільки для чернеток -->
                                                                                    <Button Height="28" Padding="10,0" Grid.Column="3"
                                                                                                            Cursor="Hand" VerticalAlignment="Top"
                                                                                                            Click="EditRecord_Click"
                                                                                                            Tag="{Binding}"
                                                                                                            Margin="4,0,8,0">
                                                                                        <Button.Style>
                                                                                            <Style TargetType="Button">
                                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                <Setter Property="Background" Value="#FDEBD0"/>
                                                                                                <Setter Property="Foreground" Value="#C0552A"/>
                                                                                                <Setter Property="BorderThickness" Value="0"/>
                                                                                                <Setter Property="Template">
                                                                                                    <Setter.Value>
                                                                                                        <ControlTemplate TargetType="Button">
                                                                                                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                                                                    VerticalAlignment="Center"
                                                                                                                                    Margin="{TemplateBinding Padding}"/>
                                                                                                            </Border>
                                                                                                            <ControlTemplate.Triggers>
                                                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                                                    <Setter Property="Background" Value="#F5CCAA"/>
                                                                                                                </Trigger>
                                                                                                            </ControlTemplate.Triggers>
                                                                                                        </ControlTemplate>
                                                                                                    </Setter.Value>
                                                                                                </Setter>
                                                                                                <Style.Triggers>
                                                                                                    <DataTrigger Binding="{Binding IsSigned}" Value="False">
                                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                                    </DataTrigger>
                                                                                                </Style.Triggers>
                                                                                            </Style>
                                                                                        </Button.Style>
                                                                                        <StackPanel Orientation="Horizontal">
                                                                                            <ui:SymbolIcon Symbol="Edit24" FontSize="12" Margin="0,0,4,0"/>
                                                                                            <TextBlock Text="Редагувати" FontSize="12"/>
                                                                                        </StackPanel>
                                                                                    </Button>
                                                                                    <!-- Деталі -->
                                                                                    <Button Grid.Column="4"
                                                                                            Height="28" Padding="10,0"
                                                                                            Cursor="Hand"
                                                                                            VerticalAlignment="Top"
                                                                                            Click="ViewRecord_Click"
                                                                                            Tag="{Binding}">
                                                                                        <Button.Style>
                                                                                            <Style TargetType="Button">
                                                                                                <Setter Property="Background" Value="White"/>
                                                                                                <Setter Property="Foreground" Value="#5F5E5A"/>
                                                                                                <Setter Property="BorderBrush" Value="#D3D1C7"/>
                                                                                                <Setter Property="BorderThickness" Value="1"/>
                                                                                                <Setter Property="Template">
                                                                                                    <Setter.Value>
                                                                                                        <ControlTemplate TargetType="Button">
                                                                                                            <Border Background="{TemplateBinding Background}"
                                                                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                                                                    CornerRadius="6">
                                                                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                                                                  VerticalAlignment="Center"
                                                                                                                                  Margin="{TemplateBinding Padding}"/>
                                                                                                            </Border>
                                                                                                            <ControlTemplate.Triggers>
                                                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                                                    <Setter Property="Background" Value="#F1EFE8"/>
                                                                                                                </Trigger>
                                                                                                            </ControlTemplate.Triggers>
                                                                                                        </ControlTemplate>
                                                                                                    </Setter.Value>
                                                                                                </Setter>
                                                                                            </Style>
                                                                                        </Button.Style>
                                                                                        <TextBlock Text="Детальніше" FontSize="12"/>
                                                                                    </Button>
                                                                                </Grid>

                                                                                
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>

                                                            <!-- Дослідження кейсу -->
                                                            <Border Margin="0,12,0,0" Visibility="{Binding Researches.Count, Converter={StaticResource NullToVisibility}}">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Researches.Count}" Value="0">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <StackPanel>
                                                                    <Border BorderBrush="#E0DEDB" BorderThickness="0,1,0,0" Margin="0,0,0,10"/>
                                                                    <TextBlock FontSize="11" FontWeight="SemiBold"
                                                                           Foreground="#888780" Margin="0,0,0,8">
                                                                    <Run Text="ДОСЛІДЖЕННЯ ·"/>
                                                                    <Run Text="{Binding Researches.Count, Mode=OneWay}"/>
                                                                    </TextBlock>
                                                                    <ItemsControl ItemsSource="{Binding Researches}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Border BorderBrush="#F1EFE8" BorderThickness="0,0,0,1" Padding="0,8">
                                                                                    <Grid>
                                                                                        <Grid.ColumnDefinitions>
                                                                                            <ColumnDefinition Width="Auto"/>
                                                                                            <ColumnDefinition Width="*"/>
                                                                                            <ColumnDefinition Width="Auto"/>
                                                                                        </Grid.ColumnDefinitions>

                                                                                        <!-- Іконка -->
                                                                                        <Border Grid.Column="0" Width="28" Height="28"
                                                                                                CornerRadius="6" Background="#E6F1FB"
                                                                                                Margin="0,0,10,0" VerticalAlignment="Center">
                                                                                            <ui:SymbolIcon Symbol="Microscope24"
                                                                                                        FontSize="14" Foreground="#185FA5"/>
                                                                                        </Border>

                                                                                        <!-- Інфо -->
                                                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                                            <TextBlock Text="{Binding ResearchType, Mode=OneWay}"
                                                                                                     FontSize="12" FontWeight="Medium"
                                                                                                     Foreground="#2C2C2A"/>
                                                                                            <TextBlock FontSize="11" Foreground="#888780">
                                                                                            <Run Text="{Binding CreatedAtDisplay, Mode=OneWay}"/>
                                                                                            </TextBlock>
                                                                                        </StackPanel>

                                                                                        <!-- Кнопка перегляду -->
                                                                                        <Button Grid.Column="2"
                                                                                                Height="26" Padding="8,0"
                                                                                                Cursor="Hand" VerticalAlignment="Center"
                                                                                                Tag="{Binding}"
                                                                                                Click="ViewCaseResearch_Click">
                                                                                            <Button.Style>
                                                                                                <Style TargetType="Button">
                                                                                                    <Setter Property="Background" Value="White"/>
                                                                                                    <Setter Property="Foreground" Value="#5F5E5A"/>
                                                                                                    <Setter Property="BorderBrush" Value="#D3D1C7"/>
                                                                                                    <Setter Property="BorderThickness" Value="1"/>
                                                                                                    <Setter Property="Template">
                                                                                                        <Setter.Value>
                                                                                                            <ControlTemplate TargetType="Button">
                                                                                                                <Border Background="{TemplateBinding Background}"
                                                                                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                                                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                                                                                            CornerRadius="6">
                                                                                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                                                                            VerticalAlignment="Center"
                                                                                                                            Margin="{TemplateBinding Padding}"/>
                                                                                                                </Border>
                                                                                                                <ControlTemplate.Triggers>
                                                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                                                        <Setter Property="Background" Value="#F1EFE8"/>
                                                                                                                    </Trigger>
                                                                                                                </ControlTemplate.Triggers>
                                                                                                            </ControlTemplate>
                                                                                                        </Setter.Value>
                                                                                                    </Setter>
                                                                                                </Style>
                                                                                            </Button.Style>
                                                                                            <StackPanel Orientation="Horizontal">
                                                                                                <ui:SymbolIcon Symbol="Eye24" FontSize="11" Margin="0,0,4,0"/>
                                                                                                <TextBlock Text="Переглянути" FontSize="11"/>
                                                                                            </StackPanel>
                                                                                        </Button>
                                                                                    </Grid>
                                                                                </Border>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <!-- Пагінація кейсів -->
                            <Grid Margin="0,16,0,0"
                                  Visibility="{Binding ShowCasesPagination, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="←" Click="CasesPrevPage_Click"
                                            IsEnabled="{Binding CanGoCasesPrev}"
